{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://microhack.example/schemas/sre-agent-incident.schema.json",
  "title": "MicroHack Azure SRE Agent incident capture",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "incidentStart",
    "incidentEnd",
    "subject",
    "seed",
    "alertFired",
    "badRevisionFailures",
    "investigation",
    "agentAudit",
    "activityLog",
    "containerAppBeforeRollback",
    "containerAppAfterRollback",
    "recoveredTraffic",
    "recoveryHealth",
    "alertResolved",
    "assessment"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.2.0"
    },
    "incidentStart": {
      "$ref": "#/$defs/timestamp"
    },
    "incidentEnd": {
      "$ref": "#/$defs/timestamp"
    },
    "subject": {
      "type": "object"
    },
    "seed": {
      "type": "object",
      "required": [
        "trafficBefore",
        "trafficBad"
      ],
      "properties": {
        "trafficBefore": {
          "$ref": "#/$defs/trafficCapture"
        },
        "trafficBad": {
          "$ref": "#/$defs/trafficCapture"
        }
      }
    },
    "alertFired": {
      "type": "object"
    },
    "badRevisionFailures": {
      "$ref": "#/$defs/query"
    },
    "investigation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "investigationEnd",
        "deploymentHistory",
        "requestFailures",
        "exceptions",
        "databaseDependencies",
        "databaseAvailability"
      ],
      "properties": {
        "investigationEnd": {
          "$ref": "#/$defs/timestamp"
        },
        "deploymentHistory": {
          "$ref": "#/$defs/observedCapture"
        },
        "requestFailures": {
          "$ref": "#/$defs/observedQuery"
        },
        "exceptions": {
          "$ref": "#/$defs/observedQuery"
        },
        "databaseDependencies": {
          "$ref": "#/$defs/observedQuery"
        },
        "databaseAvailability": {
          "$ref": "#/$defs/observedCapture"
        }
      }
    },
    "agentAudit": {
      "$ref": "#/$defs/query"
    },
    "activityLog": {
      "type": "object"
    },
    "containerAppBeforeRollback": {
      "type": "object"
    },
    "containerAppAfterRollback": {
      "type": "object"
    },
    "recoveredTraffic": {
      "$ref": "#/$defs/trafficCapture"
    },
    "recoveryHealth": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/httpCapture"
      }
    },
    "alertResolved": {
      "type": "object"
    },
    "assessment": {
      "type": "object"
    }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request",
        "response"
      ],
      "properties": {
        "observedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "request": {
          "type": "object"
        },
        "response": {
          "type": "object",
          "required": [
            "tables"
          ],
          "properties": {
            "tables": {
              "type": "array",
              "minItems": 1
            }
          }
        }
      }
    },
    "httpCapture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observedAt",
        "request",
        "response"
      ],
      "properties": {
        "observedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "request": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method",
            "url",
            "redirectsAllowed"
          ],
          "properties": {
            "method": {
              "const": "GET"
            },
            "url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            },
            "redirectsAllowed": {
              "const": false
            }
          }
        },
        "response": {
          "type": "object",
          "required": [
            "exitcode",
            "http_code",
            "num_redirects",
            "url_effective"
          ],
          "properties": {
            "exitcode": {
              "const": 0
            },
            "http_code": {
              "const": 200
            },
            "num_redirects": {
              "const": 0
            },
            "url_effective": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            }
          }
        }
      }
    },
    "trafficCapture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observedAt",
        "request",
        "response"
      ],
      "properties": {
        "observedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "request": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method",
            "url"
          ],
          "properties": {
            "method": {
              "const": "GET"
            },
            "url": {
              "type": "string",
              "pattern": "^/subscriptions/.+/providers/Microsoft\\.App/containerApps/.+/revisions\\?api-version=2025-01-01$"
            }
          }
        },
        "response": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "nextLink"
          ],
          "properties": {
            "value": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "name",
                  "type",
                  "properties"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^/subscriptions/.+/providers/Microsoft\\.App/containerApps/.+/revisions/.+$"
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "type": {
                    "const": "Microsoft.App/containerApps/revisions"
                  },
                  "properties": {
                    "type": "object",
                    "required": [
                      "active",
                      "trafficWeight"
                    ],
                    "properties": {
                      "active": {
                        "type": "boolean"
                      },
                      "trafficWeight": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 100
                      }
                    }
                  }
                }
              }
            },
            "nextLink": {
              "type": "null"
            }
          }
        }
      }
    },
    "observedQuery": {
      "allOf": [
        {
          "$ref": "#/$defs/query"
        },
        {
          "type": "object",
          "required": [
            "observedAt"
          ],
          "properties": {
            "observedAt": {
              "$ref": "#/$defs/timestamp"
            }
          }
        }
      ]
    },
    "observedCapture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observedAt",
        "request",
        "response"
      ],
      "properties": {
        "observedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "request": {
          "type": "object"
        },
        "response": {
          "type": "object"
        }
      }
    }
  }
}
