{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://microhack.example/schemas/sre-agent-incident.schema.json",
  "title": "MicroHack Azure SRE Agent incident capture",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "incidentStart",
    "incidentEnd",
    "subject",
    "seed",
    "alertFired",
    "badRevisionFailures",
    "investigation",
    "agentAudit",
    "activityLog",
    "containerAppBeforeRollback",
    "containerAppAfterRollback",
    "recoveredTraffic",
    "recoveryHealth",
    "alertResolved",
    "assessment"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "incidentStart": {
      "$ref": "#/$defs/timestamp"
    },
    "incidentEnd": {
      "$ref": "#/$defs/timestamp"
    },
    "subject": {
      "type": "object"
    },
    "seed": {
      "type": "object"
    },
    "alertFired": {
      "type": "object"
    },
    "badRevisionFailures": {
      "$ref": "#/$defs/query"
    },
    "investigation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "investigationEnd",
        "deploymentHistory",
        "requestFailures",
        "exceptions",
        "databaseDependencies",
        "databaseAvailability"
      ],
      "properties": {
        "investigationEnd": {
          "$ref": "#/$defs/timestamp"
        },
        "deploymentHistory": {
          "$ref": "#/$defs/observedCapture"
        },
        "requestFailures": {
          "$ref": "#/$defs/observedQuery"
        },
        "exceptions": {
          "$ref": "#/$defs/observedQuery"
        },
        "databaseDependencies": {
          "$ref": "#/$defs/observedQuery"
        },
        "databaseAvailability": {
          "$ref": "#/$defs/observedCapture"
        }
      }
    },
    "agentAudit": {
      "$ref": "#/$defs/query"
    },
    "activityLog": {
      "type": "object"
    },
    "containerAppBeforeRollback": {
      "type": "object"
    },
    "containerAppAfterRollback": {
      "type": "object"
    },
    "recoveredTraffic": {
      "type": "object"
    },
    "recoveryHealth": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object"
      }
    },
    "alertResolved": {
      "type": "object"
    },
    "assessment": {
      "type": "object"
    }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request",
        "response"
      ],
      "properties": {
        "observedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "request": {
          "type": "object"
        },
        "response": {
          "type": "object",
          "required": [
            "tables"
          ],
          "properties": {
            "tables": {
              "type": "array",
              "minItems": 1
            }
          }
        }
      }
    },
    "observedQuery": {
      "allOf": [
        {
          "$ref": "#/$defs/query"
        },
        {
          "type": "object",
          "required": [
            "observedAt"
          ],
          "properties": {
            "observedAt": {
              "$ref": "#/$defs/timestamp"
            }
          }
        }
      ]
    },
    "observedCapture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observedAt",
        "request",
        "response"
      ],
      "properties": {
        "observedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "request": {
          "type": "object"
        },
        "response": {
          "type": "object"
        }
      }
    }
  }
}
