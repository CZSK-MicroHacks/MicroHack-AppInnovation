{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CZSK-MicroHacks/MicroHack-AppInnovation/contracts/defender-pricing-envelope.schema.json",
  "title": "Digest-bound Defender pricing request and response envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "request",
    "response"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "operation",
        "scopeResourceId",
        "apiVersion",
        "queriedAt"
      ],
      "properties": {
        "method": {
          "const": "GET"
        },
        "operation": {
          "const": "subscription-defender-pricings"
        },
        "scopeResourceId": {
          "type": "string",
          "pattern": "^/subscriptions/[0-9a-fA-F-]{36}$"
        },
        "apiVersion": {
          "const": "2024-01-01"
        },
        "queriedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value"
      ],
      "properties": {
        "value": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "type",
              "properties"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "const": "Microsoft.Security/pricings"
              },
              "properties": {
                "type": "object",
                "required": [
                  "pricingTier"
                ],
                "properties": {
                  "pricingTier": {
                    "enum": [
                      "Free",
                      "Standard"
                    ]
                  },
                  "subPlan": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "enforce": {
                    "enum": [
                      "True",
                      "False"
                    ]
                  },
                  "extensions": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "name",
                        "isEnabled"
                      ],
                      "properties": {
                        "name": {
                          "type": "string",
                          "minLength": 1
                        },
                        "isEnabled": {
                          "enum": [
                            "True",
                            "False"
                          ]
                        },
                        "additionalExtensionProperties": {
                          "type": "object"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
