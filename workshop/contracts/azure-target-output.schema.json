{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CZSK-MicroHacks/MicroHack-AppInnovation/contracts/azure-target-output.schema.json",
  "title": "MicroHack shared Azure target output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "deploymentStage",
    "applicationRevisionRole",
    "sourceCommit",
    "stack",
    "location",
    "resourceGroup",
    "network",
    "containerRegistry",
    "workloadIdentity",
    "containerAppsEnvironmentResourceId",
    "containerAppsEnvironmentDefaultDomain",
    "database",
    "images",
    "observability",
    "containerImage",
    "application"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.2.0"
    },
    "deploymentStage": {
      "enum": [
        "bootstrap",
        "application"
      ]
    },
    "applicationRevisionRole": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "baseline",
        "release",
        null
      ]
    },
    "sourceCommit": {
      "$ref": "#/$defs/commitSha"
    },
    "stack": {
      "$ref": "#/$defs/stack"
    },
    "location": {
      "const": "swedencentral"
    },
    "resourceGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "resourceId"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "resourceId": {
          "$ref": "#/$defs/resourceGroupId"
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "virtualNetworkResourceId",
        "migrationSourceVirtualNetworkResourceId",
        "migrationSourceVmResourceId",
        "migrationSourceToTargetPeeringResourceId",
        "migrationTargetToSourcePeeringResourceId",
        "migrationPrivateDnsZoneLinkResourceIds"
      ],
      "properties": {
        "virtualNetworkResourceId": {
          "$ref": "#/$defs/virtualNetworkResourceId"
        },
        "migrationSourceVirtualNetworkResourceId": {
          "$ref": "#/$defs/virtualNetworkResourceId"
        },
        "migrationSourceVmResourceId": {
          "$ref": "#/$defs/virtualMachineResourceId"
        },
        "migrationSourceToTargetPeeringResourceId": {
          "$ref": "#/$defs/virtualNetworkPeeringResourceId"
        },
        "migrationTargetToSourcePeeringResourceId": {
          "$ref": "#/$defs/virtualNetworkPeeringResourceId"
        },
        "migrationPrivateDnsZoneLinkResourceIds": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/privateDnsZoneLinkResourceId"
          }
        }
      }
    },
    "containerRegistry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resourceId",
        "loginServer"
      ],
      "properties": {
        "resourceId": {
          "$ref": "#/$defs/containerRegistryResourceId"
        },
        "loginServer": {
          "type": "string",
          "pattern": "^[a-z0-9]+\\.azurecr\\.io$"
        }
      }
    },
    "workloadIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resourceId",
        "clientId",
        "principalId"
      ],
      "properties": {
        "resourceId": {
          "$ref": "#/$defs/managedIdentityResourceId"
        },
        "clientId": {
          "$ref": "#/$defs/guid"
        },
        "principalId": {
          "$ref": "#/$defs/guid"
        }
      }
    },
    "containerAppsEnvironmentResourceId": {
      "$ref": "#/$defs/containerAppsEnvironmentResourceId"
    },
    "containerAppsEnvironmentDefaultDomain": {
      "type": "string",
      "pattern": "^[a-z0-9-]+(?:\\.[a-z0-9-]+)+\\.azurecontainerapps\\.io$"
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resourceId",
        "family",
        "server",
        "database",
        "authentication",
        "localAdministratorPrincipal",
        "entraAdministratorPrincipal",
        "applicationPrincipal"
      ],
      "properties": {
        "resourceId": {
          "$ref": "#/$defs/resourceId"
        },
        "family": {
          "enum": [
            "azure-sql",
            "postgresql-flexible"
          ]
        },
        "server": {
          "type": "string",
          "minLength": 1
        },
        "database": {
          "type": "string",
          "minLength": 1
        },
        "authentication": {
          "enum": [
            "password-secret",
            "managed-identity"
          ]
        },
        "localAdministratorPrincipal": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/administratorPrincipal"
            }
          ]
        },
        "entraAdministratorPrincipal": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/entraAdministratorPrincipal"
            }
          ]
        },
        "applicationPrincipal": {
          "$ref": "#/$defs/applicationPrincipal"
        }
      }
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resourceId",
        "provider",
        "location",
        "authentication"
      ],
      "properties": {
        "resourceId": {
          "$ref": "#/$defs/resourceId"
        },
        "provider": {
          "enum": [
            "azure-files",
            "azure-blob"
          ]
        },
        "location": {
          "type": "string",
          "minLength": 1
        },
        "authentication": {
          "enum": [
            "managed-identity",
            "aca-volume-secret"
          ]
        }
      }
    },
    "observability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applicationInsightsResourceId",
        "logAnalyticsWorkspaceResourceId"
      ],
      "properties": {
        "applicationInsightsResourceId": {
          "$ref": "#/$defs/applicationInsightsResourceId"
        },
        "logAnalyticsWorkspaceResourceId": {
          "$ref": "#/$defs/logAnalyticsWorkspaceResourceId"
        }
      }
    },
    "containerImage": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/containerImage"
        }
      ]
    },
    "application": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/application"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "deploymentStage": {
            "const": "bootstrap"
          }
        },
        "required": [
          "deploymentStage"
        ]
      },
      "then": {
        "properties": {
          "containerImage": {
            "type": "null"
          },
          "application": {
            "type": "null"
          },
          "applicationRevisionRole": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "containerImage": {
            "$ref": "#/$defs/containerImage"
          },
          "application": {
            "$ref": "#/$defs/application"
          },
          "applicationRevisionRole": {
            "enum": [
              "baseline",
              "release"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "stack": {
            "const": "dotnet-sqlserver"
          }
        },
        "required": [
          "stack"
        ]
      },
      "then": {
        "properties": {
          "network": {
            "properties": {
              "migrationSourceVmResourceId": {
                "pattern": "/virtualMachines/vm-dotnet-[^/]+$"
              }
            }
          },
          "database": {
            "properties": {
              "family": {
                "const": "azure-sql"
              },
              "resourceId": {
                "$ref": "#/$defs/azureSqlDatabaseResourceId"
              },
              "server": {
                "pattern": "^[a-z0-9-]+\\.database\\.windows\\.net$"
              },
              "authentication": {
                "const": "managed-identity"
              },
              "localAdministratorPrincipal": {
                "type": "null"
              },
              "entraAdministratorPrincipal": {
                "type": "null"
              },
              "applicationPrincipal": {
                "properties": {
                  "kind": {
                    "const": "managed-identity"
                  },
                  "principalId": {
                    "$ref": "#/$defs/guid"
                  }
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "network": {
            "properties": {
              "migrationSourceVmResourceId": {
                "pattern": "/virtualMachines/vm-java-[^/]+$"
              }
            }
          },
          "database": {
            "properties": {
              "family": {
                "const": "postgresql-flexible"
              },
              "resourceId": {
                "$ref": "#/$defs/postgresqlDatabaseResourceId"
              },
              "server": {
                "pattern": "^[a-z0-9-]+\\.postgres\\.database\\.azure\\.com$"
              },
              "localAdministratorPrincipal": {
                "$ref": "#/$defs/administratorPrincipal"
              },
              "entraAdministratorPrincipal": {
                "$ref": "#/$defs/entraAdministratorPrincipal"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "database": {
            "properties": {
              "authentication": {
                "const": "password-secret"
              }
            },
            "required": [
              "authentication"
            ]
          }
        },
        "required": [
          "database"
        ]
      },
      "then": {
        "properties": {
          "database": {
            "properties": {
              "applicationPrincipal": {
                "properties": {
                  "kind": {
                    "const": "database-role"
                  },
                  "principalId": {
                    "type": "null"
                  }
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "database": {
            "properties": {
              "applicationPrincipal": {
                "properties": {
                  "kind": {
                    "const": "managed-identity"
                  },
                  "principalId": {
                    "$ref": "#/$defs/guid"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "images": {
            "properties": {
              "provider": {
                "const": "azure-blob"
              }
            },
            "required": [
              "provider"
            ]
          }
        },
        "required": [
          "images"
        ]
      },
      "then": {
        "properties": {
          "images": {
            "properties": {
              "authentication": {
                "const": "managed-identity"
              },
              "resourceId": {
                "$ref": "#/$defs/blobContainerResourceId"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "images": {
            "properties": {
              "authentication": {
                "const": "aca-volume-secret"
              },
              "resourceId": {
                "$ref": "#/$defs/fileShareResourceId"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "administratorPrincipal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "authentication"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_]{0,62}$"
        },
        "authentication": {
          "const": "password"
        }
      }
    },
    "applicationPrincipal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kind",
        "principalId"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "database-role",
            "managed-identity"
          ]
        },
        "principalId": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/guid"
            }
          ]
        }
      }
    },
    "entraAdministratorPrincipal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "objectId",
        "principalType"
      ],
      "properties": {
        "name": {
          "type": "string",
          "format": "email"
        },
        "objectId": {
          "$ref": "#/$defs/guid"
        },
        "principalType": {
          "const": "user"
        }
      }
    },
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resourceId",
        "url",
        "healthUrl",
        "readinessUrl",
        "containerAppName",
        "revisionName"
      ],
      "properties": {
        "resourceId": {
          "$ref": "#/$defs/containerAppResourceId"
        },
        "url": {
          "$ref": "#/$defs/httpsUrl"
        },
        "healthUrl": {
          "$ref": "#/$defs/httpsUrl"
        },
        "readinessUrl": {
          "$ref": "#/$defs/httpsUrl"
        },
        "containerAppName": {
          "type": "string",
          "minLength": 1
        },
        "revisionName": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "containerImage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "tag",
        "digest"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "$ref": "#/$defs/commitSha"
        },
        "digest": {
          "$ref": "#/$defs/imageDigest"
        }
      }
    },
    "commitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "applicationInsightsResourceId": {
      "allOf": [
        {
          "$ref": "#/$defs/resourceId"
        },
        {
          "pattern": "/providers/Microsoft\\.Insights/components/[^/]+$"
        }
      ]
    },
    "azureSqlDatabaseResourceId": {
      "allOf": [
        {
          "$ref": "#/$defs/resourceId"
        },
        {
          "pattern": "/providers/Microsoft\\.Sql/servers/[^/]+/databases/[^/]+$"
        }
      ]
    },
    "blobContainerResourceId": {
      "allOf": [
        {
          "$ref": "#/$defs/resourceId"
        },
        {
          "pattern": "/providers/Microsoft\\.Storage/storageAccounts/[^/]+/blobServices/default/containers/[^/]+$"
        }
      ]
    },
    "containerAppResourceId": {
      "allOf": [
        {
          "$ref": "#/$defs/resourceId"
        },
        {
          "pattern": "/providers/Microsoft\\.App/containerApps/[^/]+$"
        }
      ]
    },
    "containerAppsEnvironmentResourceId": {
      "allOf": [
        {
          "$ref": "#/$defs/resourceId"
        },
        {
          "pattern": "/providers/Microsoft\\.App/managedEnvironments/[^/]+$"
        }
      ]
    },
    "containerRegistryResourceId": {
      "allOf": [
        {
          "$ref": "#/$defs/resourceId"
        },
        {
          "pattern": "/providers/Microsoft\\.ContainerRegistry/registries/[^/]+$"
        }
      ]
    },
    "fileShareResourceId": {
      "allOf": [
        {
          "$ref": "#/$defs/resourceId"
        },
        {
          "pattern": "/providers/Microsoft\\.Storage/storageAccounts/[^/]+/fileServices/default/shares/[^/]+$"
        }
      ]
    },
    "guid": {
      "type": "string",
      "format": "uuid"
    },
    "httpsUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "imageDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "logAnalyticsWorkspaceResourceId": {
      "allOf": [
        {
          "$ref": "#/$defs/resourceId"
        },
        {
          "pattern": "/providers/Microsoft\\.OperationalInsights/workspaces/[^/]+$"
        }
      ]
    },
    "managedIdentityResourceId": {
      "allOf": [
        {
          "$ref": "#/$defs/resourceId"
        },
        {
          "pattern": "/providers/Microsoft\\.ManagedIdentity/userAssignedIdentities/[^/]+$"
        }
      ]
    },
    "postgresqlDatabaseResourceId": {
      "allOf": [
        {
          "$ref": "#/$defs/resourceId"
        },
        {
          "pattern": "/providers/Microsoft\\.DBforPostgreSQL/flexibleServers/[^/]+/databases/[^/]+$"
        }
      ]
    },
    "resourceGroupId": {
      "type": "string",
      "pattern": "^/subscriptions/[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}/resourceGroups/[^/]+$"
    },
    "resourceId": {
      "type": "string",
      "pattern": "^/subscriptions/[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}/resourceGroups/[^/]+/providers/[^/]+(?:/[^/]+/[^/]+)+$"
    },
    "privateDnsZoneLinkResourceId": {
      "allOf": [
        {
          "$ref": "#/$defs/resourceId"
        },
        {
          "pattern": "/providers/Microsoft\\.Network/privateDnsZones/[^/]+/virtualNetworkLinks/[^/]+$"
        }
      ]
    },
    "virtualNetworkResourceId": {
      "allOf": [
        {
          "$ref": "#/$defs/resourceId"
        },
        {
          "pattern": "/providers/Microsoft\\.Network/virtualNetworks/[^/]+$"
        }
      ]
    },
    "virtualMachineResourceId": {
      "allOf": [
        {
          "$ref": "#/$defs/resourceId"
        },
        {
          "pattern": "/providers/Microsoft\\.Compute/virtualMachines/[^/]+$"
        }
      ]
    },
    "virtualNetworkPeeringResourceId": {
      "allOf": [
        {
          "$ref": "#/$defs/resourceId"
        },
        {
          "pattern": "/providers/Microsoft\\.Network/virtualNetworks/[^/]+/virtualNetworkPeerings/[^/]+$"
        }
      ]
    },
    "stack": {
      "enum": [
        "dotnet-sqlserver",
        "java-postgresql"
      ]
    }
  }
}
