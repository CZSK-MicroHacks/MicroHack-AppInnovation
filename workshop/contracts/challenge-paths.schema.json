{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CZSK-MicroHacks/MicroHack-AppInnovation/contracts/challenge-paths.schema.json",
  "title": "Challenge 1 modernization path registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sharedChallenge",
    "sharedTarget",
    "slices"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "sharedChallenge": {
      "const": "challenges/ch01/README.md"
    },
    "sharedTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "infrastructure",
        "migrationCommand",
        "handoffRenderCommand",
        "handoffValidationCommand",
        "handoffSchema",
        "acceptanceCommand"
      ],
      "properties": {
        "infrastructure": {
          "const": "infra/main.bicep"
        },
        "migrationCommand": {
          "const": "catalog-migrate"
        },
        "handoffRenderCommand": {
          "const": "catalog-migrate render-handoff --path <path> --rollback-runbook <path>"
        },
        "handoffValidationCommand": {
          "const": "python -m catalog_acceptance.handoff_cli"
        },
        "handoffSchema": {
          "const": "workshop/contracts/modernization-contract.schema.json"
        },
        "acceptanceCommand": {
          "const": "python -m catalog_acceptance"
        }
      }
    },
    "slices": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/slice"
      }
    }
  },
  "$defs": {
    "repoPath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[a-zA-Z0-9._/-]+$"
    },
    "evidencePath": {
      "type": "string",
      "pattern": "^evidence/[a-z0-9-]+\\.(?:json|md)$"
    },
    "slice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "stack",
        "sourcePath",
        "dockerfile",
        "challenge",
        "solution",
        "databaseFamily",
        "imageProvider",
        "tooling",
        "requiredEvidence",
        "pathEvidence"
      ],
      "properties": {
        "id": {
          "enum": [
            "manual-dotnet",
            "manual-java",
            "copilot-rewrite-dotnet",
            "copilot-rewrite-java",
            "copilot-modernization-dotnet",
            "copilot-modernization-java"
          ]
        },
        "path": {
          "enum": [
            "manual",
            "copilot-rewrite",
            "copilot-modernization"
          ]
        },
        "stack": {
          "enum": [
            "dotnet-sqlserver",
            "java-postgresql"
          ]
        },
        "sourcePath": {
          "enum": [
            "dotnet",
            "java"
          ]
        },
        "dockerfile": {
          "enum": [
            "dotnet/Dockerfile",
            "java/Dockerfile"
          ]
        },
        "challenge": {
          "allOf": [
            {
              "$ref": "#/$defs/repoPath"
            },
            {
              "pattern": "^challenges/ch01-(?:manual|copilot-rewrite|copilot-modernization)/README\\.md$"
            }
          ]
        },
        "solution": {
          "allOf": [
            {
              "$ref": "#/$defs/repoPath"
            },
            {
              "pattern": "^solutions/ch01-(?:manual|copilot-rewrite|copilot-modernization)/(?:dotnet|java)/README\\.md$"
            }
          ]
        },
        "databaseFamily": {
          "enum": [
            "azure-sql",
            "postgresql-flexible"
          ]
        },
        "imageProvider": {
          "enum": [
            "azure-files",
            "azure-blob"
          ]
        },
        "tooling": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "github.copilot",
              "github.copilot-chat",
              "vscjava.migrate-java-to-azure"
            ]
          }
        },
        "requiredEvidence": {
          "const": [
            "evidence/azure-target-output.json",
            "evidence/migration-report.json",
            "evidence/acceptance-report.json",
            "evidence/runtime-test-report.json",
            "evidence/telemetry-report.json",
            "evidence/modernization-contract.json",
            "evidence/rollback-runbook.md"
          ]
        },
        "pathEvidence": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/evidencePath"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "id": {
                "const": "manual-dotnet"
              }
            },
            "required": [
              "id"
            ]
          },
          "then": {
            "properties": {
              "path": {
                "const": "manual"
              },
              "stack": {
                "const": "dotnet-sqlserver"
              },
              "sourcePath": {
                "const": "dotnet"
              },
              "dockerfile": {
                "const": "dotnet/Dockerfile"
              },
              "solution": {
                "const": "solutions/ch01-manual/dotnet/README.md"
              },
              "databaseFamily": {
                "const": "azure-sql"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "const": "manual-java"
              }
            },
            "required": [
              "id"
            ]
          },
          "then": {
            "properties": {
              "path": {
                "const": "manual"
              },
              "stack": {
                "const": "java-postgresql"
              },
              "sourcePath": {
                "const": "java"
              },
              "dockerfile": {
                "const": "java/Dockerfile"
              },
              "solution": {
                "const": "solutions/ch01-manual/java/README.md"
              },
              "databaseFamily": {
                "const": "postgresql-flexible"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "const": "copilot-rewrite-dotnet"
              }
            },
            "required": [
              "id"
            ]
          },
          "then": {
            "properties": {
              "path": {
                "const": "copilot-rewrite"
              },
              "stack": {
                "const": "dotnet-sqlserver"
              },
              "sourcePath": {
                "const": "dotnet"
              },
              "dockerfile": {
                "const": "dotnet/Dockerfile"
              },
              "solution": {
                "const": "solutions/ch01-copilot-rewrite/dotnet/README.md"
              },
              "databaseFamily": {
                "const": "azure-sql"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "const": "copilot-rewrite-java"
              }
            },
            "required": [
              "id"
            ]
          },
          "then": {
            "properties": {
              "path": {
                "const": "copilot-rewrite"
              },
              "stack": {
                "const": "java-postgresql"
              },
              "sourcePath": {
                "const": "java"
              },
              "dockerfile": {
                "const": "java/Dockerfile"
              },
              "solution": {
                "const": "solutions/ch01-copilot-rewrite/java/README.md"
              },
              "databaseFamily": {
                "const": "postgresql-flexible"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "const": "copilot-modernization-dotnet"
              }
            },
            "required": [
              "id"
            ]
          },
          "then": {
            "properties": {
              "path": {
                "const": "copilot-modernization"
              },
              "stack": {
                "const": "dotnet-sqlserver"
              },
              "sourcePath": {
                "const": "dotnet"
              },
              "dockerfile": {
                "const": "dotnet/Dockerfile"
              },
              "solution": {
                "const": "solutions/ch01-copilot-modernization/dotnet/README.md"
              },
              "databaseFamily": {
                "const": "azure-sql"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "const": "copilot-modernization-java"
              }
            },
            "required": [
              "id"
            ]
          },
          "then": {
            "properties": {
              "path": {
                "const": "copilot-modernization"
              },
              "stack": {
                "const": "java-postgresql"
              },
              "sourcePath": {
                "const": "java"
              },
              "dockerfile": {
                "const": "java/Dockerfile"
              },
              "solution": {
                "const": "solutions/ch01-copilot-modernization/java/README.md"
              },
              "databaseFamily": {
                "const": "postgresql-flexible"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "path": {
                "const": "manual"
              }
            },
            "required": [
              "path"
            ]
          },
          "then": {
            "properties": {
              "challenge": {
                "const": "challenges/ch01-manual/README.md"
              },
              "imageProvider": {
                "const": "azure-files"
              },
              "tooling": {
                "const": []
              },
              "pathEvidence": {
                "const": [
                  "evidence/baseline-backup.md",
                  "evidence/managed-database-separation.json",
                  "evidence/container-build.json",
                  "evidence/iac-review.md"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "path": {
                "const": "copilot-rewrite"
              }
            },
            "required": [
              "path"
            ]
          },
          "then": {
            "properties": {
              "challenge": {
                "const": "challenges/ch01-copilot-rewrite/README.md"
              },
              "imageProvider": {
                "const": "azure-blob"
              },
              "tooling": {
                "const": [
                  "github.copilot",
                  "github.copilot-chat"
                ]
              },
              "pathEvidence": {
                "const": [
                  "evidence/characterization.md",
                  "evidence/bounded-plan.md",
                  "evidence/review-checklist.md",
                  "evidence/decision-log.md"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "path": {
                "const": "copilot-modernization"
              }
            },
            "required": [
              "path"
            ]
          },
          "then": {
            "properties": {
              "challenge": {
                "const": "challenges/ch01-copilot-modernization/README.md"
              },
              "imageProvider": {
                "const": "azure-blob"
              },
              "tooling": {
                "const": [
                  "github.copilot",
                  "github.copilot-chat",
                  "vscjava.migrate-java-to-azure"
                ]
              },
              "pathEvidence": {
                "const": [
                  "evidence/assessment.md",
                  "evidence/modernization-plan.md",
                  "evidence/task-results.json",
                  "evidence/build-test-cve-summary.md"
                ]
              }
            }
          }
        }
      ]
    }
  }
}
