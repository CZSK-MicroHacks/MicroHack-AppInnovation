{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://microhack.example/schemas/sre-agent-foundation.schema.json",
  "title": "MicroHack Azure SRE Agent foundation capture",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "observedAt",
    "subscriptionId",
    "participantResourceGroupId",
    "containerAppResourceId",
    "agentResourceGroupId",
    "agentObservability",
    "agent",
    "connectors",
    "customRollbackRole",
    "roleAssignments",
    "availabilityPreflight"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "observedAt": {
      "$ref": "#/$defs/timestamp"
    },
    "subscriptionId": {
      "$ref": "#/$defs/guid"
    },
    "participantResourceGroupId": {
      "$ref": "#/$defs/resourceId"
    },
    "containerAppResourceId": {
      "$ref": "#/$defs/resourceId"
    },
    "agentResourceGroupId": {
      "$ref": "#/$defs/resourceId"
    },
    "agentObservability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applicationInsightsResourceId",
        "logAnalyticsWorkspaceResourceId"
      ],
      "properties": {
        "applicationInsightsResourceId": {
          "$ref": "#/$defs/resourceId"
        },
        "logAnalyticsWorkspaceResourceId": {
          "$ref": "#/$defs/resourceId"
        }
      }
    },
    "agent": {
      "$ref": "#/$defs/armGet"
    },
    "connectors": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/armGet"
      }
    },
    "customRollbackRole": {
      "$ref": "#/$defs/armGet"
    },
    "roleAssignments": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "userAssigned",
        "systemAssigned",
        "facilitator",
        "participant"
      ],
      "properties": {
        "userAssigned": {
          "$ref": "#/$defs/armList"
        },
        "systemAssigned": {
          "$ref": "#/$defs/armList"
        },
        "facilitator": {
          "$ref": "#/$defs/armList"
        },
        "participant": {
          "$ref": "#/$defs/armList"
        }
      }
    },
    "availabilityPreflight": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observedAt",
        "providerRegistered",
        "locationAvailable",
        "networkReachable",
        "agentReady",
        "connectorsReady",
        "goNoGo"
      ],
      "properties": {
        "observedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "providerRegistered": {
          "const": true
        },
        "locationAvailable": {
          "const": true
        },
        "networkReachable": {
          "const": true
        },
        "agentReady": {
          "const": true
        },
        "connectorsReady": {
          "const": true
        },
        "goNoGo": {
          "const": "go"
        }
      }
    }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "guid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "resourceId": {
      "type": "string",
      "pattern": "^/subscriptions/[0-9a-f-]+/"
    },
    "armGet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request",
        "response"
      ],
      "properties": {
        "request": {
          "type": "object",
          "required": [
            "method",
            "url"
          ],
          "properties": {
            "method": {
              "const": "GET"
            },
            "url": {
              "type": "string",
              "pattern": "^/subscriptions/.+\\?api-version="
            }
          }
        },
        "response": {
          "type": "object"
        }
      }
    },
    "armList": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request",
        "response"
      ],
      "properties": {
        "request": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method",
            "url",
            "body"
          ],
          "properties": {
            "method": {
              "const": "POST"
            },
            "url": {
              "const": "/providers/Microsoft.ResourceGraph/resources?api-version=2022-10-01"
            },
            "body": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "subscriptions",
                "query",
                "options"
              ],
              "properties": {
                "subscriptions": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 1,
                  "items": {
                    "$ref": "#/$defs/guid"
                  }
                },
                "query": {
                  "type": "string",
                  "minLength": 1
                },
                "options": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "resultFormat"
                  ],
                  "properties": {
                    "resultFormat": {
                      "const": "objectArray"
                    }
                  }
                }
              }
            }
          }
        },
        "response": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "data",
            "count",
            "totalRecords",
            "resultTruncated",
            "facets"
          ],
          "properties": {
            "data": {
              "type": "array"
            },
            "count": {
              "type": "integer",
              "minimum": 0
            },
            "totalRecords": {
              "type": "integer",
              "minimum": 0
            },
            "resultTruncated": {
              "const": "false"
            },
            "facets": {
              "type": "array",
              "maxItems": 0
            }
          }
        },
        "effectiveAccess": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "request",
            "response"
          ],
          "properties": {
            "request": {
              "type": "object"
            },
            "response": {
              "type": "array"
            }
          }
        }
      }
    }
  }
}
