{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CZSK-MicroHacks/MicroHack-AppInnovation/contracts/defender-cleanup-inventory-envelope.schema.json",
  "title": "Composite Defender cleanup inventory envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "resourceGraph",
    "autoProvisioningSettings",
    "settings"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.1.0"
    },
    "resourceGraph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request",
        "response"
      ],
      "properties": {
        "request": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method",
            "operation",
            "scopeResourceId",
            "resourcePath",
            "apiVersion",
            "queriedAt",
            "body"
          ],
          "properties": {
            "method": {
              "const": "POST"
            },
            "operation": {
              "const": "subscription-defender-cleanup-inventory"
            },
            "scopeResourceId": {
              "$ref": "#/$defs/subscriptionResourceId"
            },
            "resourcePath": {
              "const": "providers/Microsoft.ResourceGraph/resources"
            },
            "apiVersion": {
              "const": "2022-10-01"
            },
            "queriedAt": {
              "type": "string",
              "format": "date-time"
            },
            "body": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "subscriptions",
                "query",
                "options"
              ],
              "properties": {
                "subscriptions": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 1,
                  "items": {
                    "type": "string",
                    "pattern": "^[0-9a-fA-F-]{36}$"
                  }
                },
                "query": {
                  "type": "string",
                  "minLength": 1
                },
                "options": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "resultFormat"
                  ],
                  "properties": {
                    "resultFormat": {
                      "const": "objectArray"
                    }
                  }
                }
              }
            }
          }
        },
        "response": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "totalRecords",
            "count",
            "resultTruncated",
            "facets",
            "data"
          ],
          "properties": {
            "totalRecords": {
              "type": "integer",
              "minimum": 0
            },
            "count": {
              "type": "integer",
              "minimum": 0
            },
            "resultTruncated": {
              "const": "false"
            },
            "facets": {
              "type": "array",
              "maxItems": 0
            },
            "$skipToken": {
              "type": "string",
              "minLength": 1
            },
            "data": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/argResource"
              }
            }
          }
        }
      }
    },
    "autoProvisioningSettings": {
      "$ref": "#/$defs/armListEnvelope"
    },
    "settings": {
      "$ref": "#/$defs/armListEnvelope"
    }
  },
  "$defs": {
    "subscriptionResourceId": {
      "type": "string",
      "pattern": "^/subscriptions/[0-9a-fA-F-]{36}$"
    },
    "argResource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "type",
        "properties",
        "identity",
        "location"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^/subscriptions/[0-9a-fA-F-]{36}/.+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "properties": {
          "type": "object"
        },
        "identity": {
          "type": [
            "object",
            "null"
          ]
        },
        "location": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "armResource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "type",
        "properties"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^/subscriptions/[0-9a-fA-F-]{36}/.+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "properties": {
          "type": "object"
        },
        "systemData": {
          "type": "object"
        }
      }
    },
    "armListEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request",
        "response"
      ],
      "properties": {
        "request": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method",
            "operation",
            "scopeResourceId",
            "resourcePath",
            "apiVersion",
            "queriedAt"
          ],
          "properties": {
            "method": {
              "const": "GET"
            },
            "operation": {
              "type": "string",
              "minLength": 1
            },
            "scopeResourceId": {
              "$ref": "#/$defs/subscriptionResourceId"
            },
            "resourcePath": {
              "type": "string",
              "minLength": 1
            },
            "apiVersion": {
              "type": "string",
              "minLength": 1
            },
            "queriedAt": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        "response": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value"
          ],
          "properties": {
            "value": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/armResource"
              }
            },
            "nextLink": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
