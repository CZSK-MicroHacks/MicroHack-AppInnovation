{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CZSK-MicroHacks/MicroHack-AppInnovation/contracts/seed-manifest.schema.json",
  "title": "MicroHack seed manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "verifiedAt",
    "sources",
    "counts",
    "hashes",
    "categorySummary"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "verifiedAt": {
      "type": "string",
      "format": "date"
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalog",
        "categories",
        "images"
      ],
      "properties": {
        "catalog": {
          "const": "catalog.json"
        },
        "categories": {
          "const": "categories.json"
        },
        "images": {
          "const": "images"
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "figures",
        "categories",
        "images",
        "imageBytes"
      ],
      "properties": {
        "figures": {
          "type": "integer",
          "minimum": 1
        },
        "categories": {
          "type": "integer",
          "minimum": 1
        },
        "images": {
          "type": "integer",
          "minimum": 1
        },
        "imageBytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalogSha256",
        "categoriesSha256",
        "imageSetSha256"
      ],
      "properties": {
        "catalogSha256": {
          "$ref": "#/$defs/sha256"
        },
        "categoriesSha256": {
          "$ref": "#/$defs/sha256"
        },
        "imageSetSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "categorySummary": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "slug",
          "figureCount"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "figureCount": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
