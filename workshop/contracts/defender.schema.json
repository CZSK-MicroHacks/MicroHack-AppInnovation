{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CZSK-MicroHacks/MicroHack-AppInnovation/contracts/defender.schema.json",
  "title": "Challenge 5 Defender for Cloud contract registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "challengeId",
    "foundation",
    "roles",
    "controls",
    "evidence",
    "cleanup"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.1.0"
    },
    "challengeId": {
      "const": "challenge-5"
    },
    "foundation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "requiresFacilitatorAuthorization",
        "budget",
        "requiredPricings",
        "legacyVmCoverage",
        "seedSnapshot",
        "manualPreflight"
      ],
      "properties": {
        "scope": {
          "const": "dedicated-workshop-subscription"
        },
        "requiresFacilitatorAuthorization": {
          "const": true
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scope",
            "apiVersion",
            "category",
            "timeGrain",
            "maximumNotificationThreshold",
            "notificationTargetRequired"
          ],
          "properties": {
            "scope": {
              "const": "handoff-subscription"
            },
            "apiVersion": {
              "const": "2023-11-01"
            },
            "category": {
              "const": "Cost"
            },
            "timeGrain": {
              "const": "Monthly"
            },
            "maximumNotificationThreshold": {
              "const": 80
            },
            "notificationTargetRequired": {
              "const": true
            }
          }
        },
        "requiredPricings": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/pricing"
          }
        },
        "legacyVmCoverage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema",
            "apiVersion",
            "requiredWorkloads",
            "pricingName",
            "pricingSubPlan",
            "subscriptionPricingEnforce"
          ],
          "properties": {
            "schema": {
              "const": "workshop/contracts/defender-legacy-vm-coverage.schema.json"
            },
            "apiVersion": {
              "const": "2024-11-01"
            },
            "requiredWorkloads": {
              "const": [
                "dotnet",
                "java"
              ]
            },
            "pricingName": {
              "const": "VirtualMachines"
            },
            "pricingSubPlan": {
              "const": "P2"
            },
            "subscriptionPricingEnforce": {
              "const": "True"
            }
          }
        },
        "seedSnapshot": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema",
            "requiredNonEmptySignals",
            "recommendationResourceCoverage",
            "minimumUnhealthyRecommendations",
            "attackPaths"
          ],
          "properties": {
            "schema": {
              "const": "workshop/contracts/defender-seed-snapshot.schema.json"
            },
            "requiredNonEmptySignals": {
              "const": [
                "image-vulnerability-assessment",
                "recommendations",
                "secure-score",
                "mcsb-controls"
              ]
            },
            "recommendationResourceCoverage": {
              "const": [
                "dotnet-vm",
                "java-vm",
                "container-app",
                "container-registry",
                "database"
              ]
            },
            "minimumUnhealthyRecommendations": {
              "const": 1
            },
            "attackPaths": {
              "const": "query-required-results-optional"
            }
          }
        },
        "manualPreflight": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "controlId",
            "requiredState",
            "reason",
            "minimumRole"
          ],
          "properties": {
            "controlId": {
              "const": "serverless-containers"
            },
            "requiredState": {
              "const": "enabled"
            },
            "reason": {
              "type": "string",
              "minLength": 20
            },
            "minimumRole": {
              "const": "Owner"
            }
          }
        }
      }
    },
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "facilitator",
        "participant"
      ],
      "properties": {
        "facilitator": {
          "$ref": "#/$defs/nonEmptyStrings"
        },
        "participant": {
          "$ref": "#/$defs/nonEmptyStrings"
        }
      }
    },
    "controls": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "acceptedDispositions"
        ],
        "properties": {
          "id": {
            "enum": [
              "acr-admin-authentication",
              "container-app-ingress",
              "database-public-network",
              "legacy-vm-management-ingress"
            ]
          },
          "acceptedDispositions": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {
              "enum": [
                "remediated",
                "already-compliant",
                "justified",
                "documented-exception"
              ]
            }
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "captureSchemaVersion",
        "reportSchemaVersion",
        "captureFile",
        "reportFile",
        "renderCommand",
        "validateCommand",
        "asynchronousSignals",
        "gradedSignal",
        "queryContracts"
      ],
      "properties": {
        "captureSchemaVersion": {
          "const": "1.1.0"
        },
        "reportSchemaVersion": {
          "const": "1.1.0"
        },
        "captureFile": {
          "const": "evidence/defender/capture.json"
        },
        "reportFile": {
          "const": "evidence/defender-report.json"
        },
        "renderCommand": {
          "type": "string",
          "minLength": 1
        },
        "validateCommand": {
          "type": "string",
          "minLength": 1
        },
        "asynchronousSignals": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "gradedSignal": {
          "const": "query-attempt-and-provenance"
        },
        "queryContracts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "imageAssessment",
            "recommendations",
            "secureScore",
            "mcsb",
            "attackPaths"
          ],
          "properties": {
            "imageAssessment": {
              "$ref": "#/$defs/queryContract",
              "properties": {
                "method": {
                  "const": "GET"
                },
                "resourcePath": {
                  "const": "providers/Microsoft.Security/assessments/c0b7cfc6-3172-465a-b378-53c7ff2cc0d5/subAssessments"
                }
              }
            },
            "recommendations": {
              "$ref": "#/$defs/queryContract",
              "properties": {
                "method": {
                  "const": "GET"
                },
                "resourcePath": {
                  "const": "providers/Microsoft.Security/assessments"
                }
              }
            },
            "secureScore": {
              "$ref": "#/$defs/queryContract",
              "properties": {
                "method": {
                  "const": "GET"
                },
                "resourcePath": {
                  "const": "providers/Microsoft.Security/secureScores"
                }
              }
            },
            "mcsb": {
              "$ref": "#/$defs/queryContract",
              "properties": {
                "method": {
                  "const": "GET"
                },
                "resourcePath": {
                  "const": "providers/Microsoft.Security/regulatoryComplianceStandards/Microsoft-cloud-security-benchmark/regulatoryComplianceControls"
                }
              }
            },
            "attackPaths": {
              "allOf": [
                {
                  "$ref": "#/$defs/queryContract"
                },
                {
                  "required": [
                    "queryTemplate",
                    "envelopeSchema",
                    "completeResponseRequired",
                    "graded"
                  ],
                  "properties": {
                    "method": {
                      "const": "POST"
                    },
                    "resourcePath": {
                      "const": "providers/Microsoft.ResourceGraph/resources"
                    },
                    "apiVersion": {
                      "const": "2022-10-01"
                    },
                    "queryTemplate": {
                      "const": "securityresources\n| where type == \"microsoft.security/attackpaths\"\n| where subscriptionId == \"{subscriptionId}\""
                    },
                    "envelopeSchema": {
                      "const": "workshop/contracts/defender-attack-path-envelope.schema.json"
                    },
                    "completeResponseRequired": {
                      "const": true
                    },
                    "graded": {
                      "const": true
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifestSchemaVersion",
        "requiresFacilitatorAuthorization",
        "priorPricingSnapshotRequired",
        "restorePriorPricingState",
        "verifyPriorPricingStateRestored",
        "restorePriorEnforceState",
        "postCleanupPricingSnapshotRequired",
        "priorCleanupInventoryRequired",
        "postCleanupInventoryRequired",
        "cleanupInventoryEnvelopeSchema",
        "cleanupInventoryResourceTypes",
        "cleanupInventoryProducers",
        "costQueryAfterRestoration",
        "costQueryEnvelopeSchema",
        "costDataMayLag"
      ],
      "properties": {
        "manifestSchemaVersion": {
          "const": "1.1.0"
        },
        "requiresFacilitatorAuthorization": {
          "const": true
        },
        "priorPricingSnapshotRequired": {
          "const": true
        },
        "restorePriorPricingState": {
          "const": true
        },
        "verifyPriorPricingStateRestored": {
          "const": true
        },
        "restorePriorEnforceState": {
          "const": true
        },
        "postCleanupPricingSnapshotRequired": {
          "const": true
        },
        "priorCleanupInventoryRequired": {
          "const": true
        },
        "postCleanupInventoryRequired": {
          "const": true
        },
        "cleanupInventoryEnvelopeSchema": {
          "const": "workshop/contracts/defender-cleanup-inventory-envelope.schema.json"
        },
        "cleanupInventoryResourceTypes": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "uniqueItems": true,
          "items": {
            "enum": [
              "microsoft.compute/virtualmachines/extensions",
              "microsoft.hybridcompute/machines/extensions",
              "microsoft.insights/datacollectionruleassociations",
              "microsoft.security/autoprovisioningsettings",
              "microsoft.security/settings",
              "microsoft.security/pricings",
              "microsoft.authorization/policyassignments"
            ]
          }
        },
        "cleanupInventoryProducers": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "resourceGraph",
            "autoProvisioningSettings",
            "settings"
          ],
          "properties": {
            "resourceGraph": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "method",
                "operation",
                "resourcePath",
                "apiVersion",
                "tables"
              ],
              "properties": {
                "method": {
                  "const": "POST"
                },
                "operation": {
                  "const": "subscription-defender-cleanup-inventory"
                },
                "resourcePath": {
                  "const": "providers/Microsoft.ResourceGraph/resources"
                },
                "apiVersion": {
                  "const": "2022-10-01"
                },
                "tables": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "Resources",
                    "InsightResources",
                    "SecurityResources",
                    "PolicyResources"
                  ],
                  "properties": {
                    "Resources": {
                      "type": "array",
                      "prefixItems": [
                        {
                          "const": "microsoft.compute/virtualmachines/extensions"
                        },
                        {
                          "const": "microsoft.hybridcompute/machines/extensions"
                        }
                      ],
                      "items": false
                    },
                    "InsightResources": {
                      "type": "array",
                      "prefixItems": [
                        {
                          "const": "microsoft.insights/datacollectionruleassociations"
                        }
                      ],
                      "items": false
                    },
                    "SecurityResources": {
                      "type": "array",
                      "prefixItems": [
                        {
                          "const": "microsoft.security/pricings"
                        }
                      ],
                      "items": false
                    },
                    "PolicyResources": {
                      "type": "array",
                      "prefixItems": [
                        {
                          "const": "microsoft.authorization/policyassignments"
                        }
                      ],
                      "items": false
                    }
                  }
                }
              }
            },
            "autoProvisioningSettings": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "method",
                "operation",
                "resourcePath",
                "apiVersion",
                "resourceType"
              ],
              "properties": {
                "method": {
                  "const": "GET"
                },
                "operation": {
                  "const": "subscription-defender-auto-provisioning-settings"
                },
                "resourcePath": {
                  "const": "providers/Microsoft.Security/autoProvisioningSettings"
                },
                "apiVersion": {
                  "const": "2017-08-01-preview"
                },
                "resourceType": {
                  "const": "microsoft.security/autoprovisioningsettings"
                }
              }
            },
            "settings": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "method",
                "operation",
                "resourcePath",
                "apiVersion",
                "resourceType"
              ],
              "properties": {
                "method": {
                  "const": "GET"
                },
                "operation": {
                  "const": "subscription-defender-settings"
                },
                "resourcePath": {
                  "const": "providers/Microsoft.Security/settings"
                },
                "apiVersion": {
                  "const": "2021-06-01"
                },
                "resourceType": {
                  "const": "microsoft.security/settings"
                }
              }
            }
          }
        },
        "costQueryAfterRestoration": {
          "const": true
        },
        "costQueryEnvelopeSchema": {
          "const": "workshop/contracts/defender-cost-query-envelope.schema.json"
        },
        "costDataMayLag": {
          "const": true
        }
      }
    }
  },
  "$defs": {
    "pricing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "pricingTier",
        "extensions"
      ],
      "properties": {
        "name": {
          "enum": [
            "CloudPosture",
            "Containers",
            "SqlServers",
            "OpenSourceRelationalDatabases",
            "VirtualMachines"
          ]
        },
        "pricingTier": {
          "const": "Standard"
        },
        "subPlan": {
          "const": "P2"
        },
        "enforce": {
          "const": "True"
        },
        "extensions": {
          "type": "array",
          "maxItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "isEnabled"
            ],
            "properties": {
              "name": {
                "const": "ContainerRegistriesVulnerabilityAssessments"
              },
              "isEnabled": {
                "const": "True"
              }
            }
          }
        }
      }
    },
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "queryContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "method",
        "resourcePath",
        "apiVersion"
      ],
      "properties": {
        "scope": {
          "enum": [
            "handoff-container-registry",
            "handoff-resource-group",
            "handoff-subscription"
          ]
        },
        "method": {
          "enum": [
            "GET",
            "POST"
          ]
        },
        "apiVersion": {
          "type": "string",
          "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}(?:-preview)?$"
        },
        "resourcePath": {
          "type": "string",
          "pattern": "^providers/Microsoft\\.(?:Security|ResourceGraph)/[^/?]+(?:/[^/?]+)*$"
        },
        "graded": {
          "type": "boolean"
        },
        "queryTemplate": {
          "type": "string",
          "minLength": 1
        },
        "envelopeSchema": {
          "type": "string",
          "pattern": "^workshop/contracts/[a-z0-9-]+\\.schema\\.json$"
        },
        "completeResponseRequired": {
          "type": "boolean"
        }
      }
    }
  }
}
