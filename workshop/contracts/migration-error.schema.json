{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CZSK-MicroHacks/MicroHack-AppInnovation/contracts/migration-error.schema.json",
  "title": "MicroHack migration CLI error",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "command",
    "exitCode",
    "error"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "status": {
      "const": "failed"
    },
    "command": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "enum": [
            "sql export",
            "sql import",
            "postgresql export",
            "postgresql import",
            "images copy",
            "verify",
            "render-handoff"
          ]
        }
      ]
    },
    "exitCode": {
      "enum": [
        2,
        3,
        4,
        5
      ]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "enum": [
            "invalid-input",
            "precondition-failed",
            "tool-failed",
            "verification-failed"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[^\\r\\n]+$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "error": {
            "properties": {
              "code": {
                "const": "invalid-input"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "exitCode": {
            "const": 2
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "error": {
            "properties": {
              "code": {
                "const": "precondition-failed"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "exitCode": {
            "const": 3
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "error": {
            "properties": {
              "code": {
                "const": "tool-failed"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "exitCode": {
            "const": 4
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "error": {
            "properties": {
              "code": {
                "const": "verification-failed"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "exitCode": {
            "const": 5
          }
        }
      }
    }
  ]
}
