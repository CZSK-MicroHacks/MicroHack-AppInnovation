{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CZSK-MicroHacks/MicroHack-AppInnovation/contracts/cicd-evidence.schema.json",
  "title": "Challenge 3 CI/CD revision evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "capturedAt",
    "subject",
    "workflow",
    "identity",
    "image",
    "revisions",
    "smoke",
    "approval",
    "traffic",
    "assertions"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "capturedAt": {
      "type": "string",
      "format": "date-time"
    },
    "subject": {
      "$ref": "#/$defs/subject"
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "runId",
        "runAttempt",
        "repository",
        "ref",
        "jobs",
        "resultFile"
      ],
      "properties": {
        "file": {
          "enum": [
            ".github/workflows/catalog-dotnet.yml",
            ".github/workflows/catalog-java.yml"
          ]
        },
        "runId": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "runAttempt": {
          "type": "integer",
          "minimum": 1
        },
        "repository": {
          "type": "string",
          "pattern": "^[^/\\s]+/[^/\\s]+$"
        },
        "ref": {
          "type": "string",
          "pattern": "^refs/(?:heads|tags)/.+$"
        },
        "resultFile": {
          "$ref": "#/$defs/evidencePath"
        },
        "jobs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "staging",
            "production"
          ],
          "properties": {
            "staging": {
              "allOf": [
                {
                  "$ref": "#/$defs/job"
                },
                {
                  "properties": {
                    "environment": {
                      "const": "staging"
                    }
                  }
                }
              ]
            },
            "production": {
              "allOf": [
                {
                  "$ref": "#/$defs/job"
                },
                {
                  "properties": {
                    "environment": {
                      "const": "production"
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authentication",
        "identityKind",
        "resourceId",
        "clientId",
        "principalId",
        "stagingFederatedSubject",
        "productionFederatedSubject",
        "federatedCredentialResourceIds",
        "acrRoleDefinitionId",
        "acrScope",
        "containerAppRoleDefinitionId",
        "containerAppScope",
        "clientSecretUsed",
        "registryAdminUsed",
        "roleAssignmentEnumeration",
        "resultFile"
      ],
      "properties": {
        "authentication": {
          "const": "github-oidc"
        },
        "identityKind": {
          "const": "user-assigned-managed-identity"
        },
        "resourceId": {
          "type": "string",
          "pattern": "^/subscriptions/[0-9a-fA-F-]{36}/resourceGroups/[^/]+/providers/Microsoft\\.ManagedIdentity/userAssignedIdentities/[^/]+$"
        },
        "clientId": {
          "$ref": "#/$defs/uuid"
        },
        "principalId": {
          "$ref": "#/$defs/uuid"
        },
        "stagingFederatedSubject": {
          "type": "string",
          "pattern": "^repo:[^/]+/[^:]+:environment:staging$"
        },
        "productionFederatedSubject": {
          "type": "string",
          "pattern": "^repo:[^/]+/[^:]+:environment:production$"
        },
        "federatedCredentialResourceIds": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "staging",
            "production"
          ],
          "properties": {
            "staging": {
              "$ref": "#/$defs/federatedCredentialResourceId"
            },
            "production": {
              "$ref": "#/$defs/federatedCredentialResourceId"
            }
          }
        },
        "acrRoleDefinitionId": {
          "const": "8311e382-0749-4cb8-b61a-304f252e45ec"
        },
        "acrScope": {
          "type": "string",
          "pattern": "/providers/Microsoft\\.ContainerRegistry/registries/[^/]+$"
        },
        "containerAppRoleDefinitionId": {
          "const": "358470bc-b998-42bd-ab17-a7e34c199c0f"
        },
        "containerAppScope": {
          "type": "string",
          "pattern": "/providers/Microsoft\\.App/containerApps/[^/]+$"
        },
        "clientSecretUsed": {
          "const": false
        },
        "registryAdminUsed": {
          "const": false
        },
        "roleAssignmentEnumeration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "assigneeObjectId",
            "scope",
            "all",
            "includeInherited",
            "fillPrincipalName",
            "fillRoleDefinitionName",
            "filtered"
          ],
          "properties": {
            "assigneeObjectId": {
              "$ref": "#/$defs/uuid"
            },
            "scope": {
              "type": "string",
              "pattern": "^/subscriptions/[0-9a-fA-F-]{36}$"
            },
            "all": {
              "const": true
            },
            "includeInherited": {
              "const": true
            },
            "fillPrincipalName": {
              "const": false
            },
            "fillRoleDefinitionName": {
              "const": false
            },
            "filtered": {
              "const": false
            }
          }
        },
        "resultFile": {
          "$ref": "#/$defs/evidencePath"
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "sourceCommit",
        "tag",
        "digest",
        "reference",
        "resultFile"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "sourceCommit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "tag": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "reference": {
          "type": "string",
          "pattern": "^[^@]+@sha256:[0-9a-f]{64}$"
        },
        "resultFile": {
          "$ref": "#/$defs/evidencePath"
        }
      }
    },
    "revisions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "previous",
        "candidate",
        "candidateLabel",
        "candidateUrl",
        "resultFile"
      ],
      "properties": {
        "mode": {
          "const": "multiple"
        },
        "previous": {
          "type": "string",
          "minLength": 1
        },
        "candidate": {
          "type": "string",
          "pattern": "^.+--ci-[0-9a-f]{12}$"
        },
        "candidateLabel": {
          "const": "candidate"
        },
        "candidateUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "resultFile": {
          "$ref": "#/$defs/evidencePath"
        }
      }
    },
    "smoke": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "healthStatus",
        "readinessStatus",
        "candidateUrl",
        "healthUrl",
        "readinessUrl",
        "testedBeforeApproval",
        "resultFile"
      ],
      "properties": {
        "healthStatus": {
          "const": 200
        },
        "readinessStatus": {
          "const": 200
        },
        "candidateUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "healthUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://.+/healthz$"
        },
        "readinessUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://.+/readyz$"
        },
        "testedBeforeApproval": {
          "const": true
        },
        "resultFile": {
          "$ref": "#/$defs/evidencePath"
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment",
        "reviewer",
        "approvedAt",
        "resultFile"
      ],
      "properties": {
        "environment": {
          "const": "production"
        },
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "approvedAt": {
          "type": "string",
          "format": "date-time"
        },
        "resultFile": {
          "$ref": "#/$defs/evidencePath"
        }
      }
    },
    "traffic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "before",
        "promotion",
        "rollback"
      ],
      "properties": {
        "before": {
          "$ref": "#/$defs/previousTraffic"
        },
        "promotion": {
          "$ref": "#/$defs/candidateTraffic"
        },
        "rollback": {
          "$ref": "#/$defs/previousTraffic"
        }
      }
    },
    "assertions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "immutableImage",
        "candidateHadZeroTraffic",
        "approvalPrecededPromotion",
        "promotionVerified",
        "rollbackVerified",
        "previousRevisionRetained"
      ],
      "properties": {
        "immutableImage": {
          "const": true
        },
        "candidateHadZeroTraffic": {
          "const": true
        },
        "approvalPrecededPromotion": {
          "const": true
        },
        "promotionVerified": {
          "const": true
        },
        "rollbackVerified": {
          "const": true
        },
        "previousRevisionRetained": {
          "const": true
        }
      }
    }
  },
  "$defs": {
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sliceId",
        "stack",
        "sourceCommit",
        "containerAppResourceId",
        "revisionName",
        "imageDigest"
      ],
      "properties": {
        "sliceId": {
          "enum": [
            "manual-dotnet",
            "manual-java",
            "copilot-rewrite-dotnet",
            "copilot-rewrite-java",
            "copilot-modernization-dotnet",
            "copilot-modernization-java"
          ]
        },
        "stack": {
          "enum": [
            "dotnet-sqlserver",
            "java-postgresql"
          ]
        },
        "sourceCommit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "containerAppResourceId": {
          "type": "string",
          "pattern": "^/subscriptions/[0-9a-fA-F-]{36}/resourceGroups/[^/]+/providers/Microsoft\\.App/containerApps/[^/]+$"
        },
        "revisionName": {
          "type": "string",
          "minLength": 1
        },
        "imageDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "evidencePath": {
      "type": "string",
      "pattern": "^evidence/cicd/[a-z0-9-]+\\.json$"
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "federatedCredentialResourceId": {
      "type": "string",
      "pattern": "^/subscriptions/[0-9a-fA-F-]{36}/resourceGroups/[^/]+/providers/Microsoft\\.ManagedIdentity/userAssignedIdentities/[^/]+/federatedIdentityCredentials/[^/]+$"
    },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jobId",
        "environment",
        "federatedSubject",
        "clientId",
        "principalId",
        "startedAt",
        "completedAt"
      ],
      "properties": {
        "jobId": {
          "type": "integer",
          "minimum": 1
        },
        "environment": {
          "enum": [
            "staging",
            "production"
          ]
        },
        "federatedSubject": {
          "type": "string",
          "pattern": "^repo:[^/]+/[^:]+:environment:(?:staging|production)$"
        },
        "clientId": {
          "$ref": "#/$defs/uuid"
        },
        "principalId": {
          "$ref": "#/$defs/uuid"
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "completedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "previousTraffic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "previous",
        "candidate",
        "observedAt",
        "resultFile"
      ],
      "properties": {
        "previous": {
          "const": 100
        },
        "candidate": {
          "const": 0
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        },
        "resultFile": {
          "$ref": "#/$defs/evidencePath"
        }
      }
    },
    "candidateTraffic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "previous",
        "candidate",
        "observedAt",
        "resultFile"
      ],
      "properties": {
        "previous": {
          "const": 0
        },
        "candidate": {
          "const": 100
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        },
        "resultFile": {
          "$ref": "#/$defs/evidencePath"
        }
      }
    }
  }
}
