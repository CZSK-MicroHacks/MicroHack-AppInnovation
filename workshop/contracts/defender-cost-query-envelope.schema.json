{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CZSK-MicroHacks/MicroHack-AppInnovation/contracts/defender-cost-query-envelope.schema.json",
  "title": "Defender cleanup Cost Management query envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "request",
    "response"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "operation",
        "scopeResourceId",
        "apiVersion",
        "queriedAt",
        "body"
      ],
      "properties": {
        "method": {
          "const": "POST"
        },
        "operation": {
          "const": "subscription-defender-cost-query"
        },
        "scopeResourceId": {
          "type": "string",
          "pattern": "^/subscriptions/[0-9a-fA-F-]{36}$"
        },
        "apiVersion": {
          "const": "2023-11-01"
        },
        "queriedAt": {
          "type": "string",
          "format": "date-time"
        },
        "body": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "timeframe",
            "timePeriod",
            "dataset"
          ],
          "properties": {
            "type": {
              "const": "Usage"
            },
            "timeframe": {
              "const": "Custom"
            },
            "timePeriod": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "from",
                "to"
              ],
              "properties": {
                "from": {
                  "type": "string",
                  "format": "date-time"
                },
                "to": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            },
            "dataset": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "granularity",
                "aggregation",
                "grouping",
                "filter"
              ],
              "properties": {
                "granularity": {
                  "const": "Daily"
                },
                "aggregation": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "totalCost"
                  ],
                  "properties": {
                    "totalCost": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "name",
                        "function"
                      ],
                      "properties": {
                        "name": {
                          "const": "PreTaxCost"
                        },
                        "function": {
                          "const": "Sum"
                        }
                      }
                    }
                  }
                },
                "grouping": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "type",
                        "name"
                      ],
                      "properties": {
                        "type": {
                          "const": "Dimension"
                        },
                        "name": {
                          "const": "ServiceName"
                        }
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "type",
                        "name"
                      ],
                      "properties": {
                        "type": {
                          "const": "Dimension"
                        },
                        "name": {
                          "const": "ResourceId"
                        }
                      }
                    }
                  ],
                  "minItems": 2,
                  "maxItems": 2
                },
                "filter": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "dimensions"
                  ],
                  "properties": {
                    "dimensions": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "name",
                        "operator",
                        "values"
                      ],
                      "properties": {
                        "name": {
                          "const": "ServiceName"
                        },
                        "operator": {
                          "const": "In"
                        },
                        "values": {
                          "const": [
                            "Microsoft Defender for Cloud"
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "type",
        "properties"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "pattern": "^[Mm]icrosoft\\.[Cc]ost[Mm]anagement/[Qq]uery$"
        },
        "properties": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "columns",
            "rows"
          ],
          "properties": {
            "nextLink": {
              "type": [
                "string",
                "null"
              ]
            },
            "columns": {
              "type": "array",
              "minItems": 4,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "type"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "type": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "rows": {
              "type": "array",
              "items": {
                "type": "array"
              }
            }
          }
        }
      }
    }
  }
}
