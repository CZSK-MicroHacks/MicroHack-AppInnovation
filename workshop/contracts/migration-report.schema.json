{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CZSK-MicroHacks/MicroHack-AppInnovation/contracts/migration-report.schema.json",
  "title": "MicroHack database and image migration report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "status",
    "startedAt",
    "completedAt",
    "sourceCommit",
    "stack",
    "migrationExecution",
    "sourceDatabase",
    "targetDatabase",
    "databaseArtifact",
    "databaseVerification",
    "images"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.1.0"
    },
    "runId": {
      "type": "string",
      "format": "uuid"
    },
    "status": {
      "const": "passed"
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "completedAt": {
      "type": "string",
      "format": "date-time"
    },
    "sourceCommit": {
      "$ref": "#/$defs/commitSha"
    },
    "stack": {
      "$ref": "#/$defs/stack"
    },
    "migrationExecution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "hostVmResourceId",
        "sourceVirtualNetworkResourceId",
        "sourceSubnetResourceId",
        "sourceToTargetPeering",
        "targetToSourcePeering",
        "privateDnsZoneLinks",
        "topologyValidated"
      ],
      "properties": {
        "host": {
          "const": "source-vm"
        },
        "hostVmResourceId": {
          "$ref": "#/$defs/virtualMachineResourceId"
        },
        "sourceVirtualNetworkResourceId": {
          "$ref": "#/$defs/virtualNetworkResourceId"
        },
        "sourceSubnetResourceId": {
          "$ref": "#/$defs/subnetResourceId"
        },
        "sourceToTargetPeering": {
          "$ref": "#/$defs/peeringEvidence"
        },
        "targetToSourcePeering": {
          "$ref": "#/$defs/peeringEvidence"
        },
        "privateDnsZoneLinks": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/privateDnsLinkEvidence"
          }
        },
        "topologyValidated": {
          "const": true
        }
      }
    },
    "sourceDatabase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "server",
        "database",
        "engineVersion"
      ],
      "properties": {
        "family": {
          "enum": [
            "sqlserver",
            "postgresql"
          ]
        },
        "server": {
          "type": "string",
          "minLength": 1
        },
        "database": {
          "type": "string",
          "minLength": 1
        },
        "engineVersion": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "targetDatabase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resourceId",
        "family",
        "server",
        "database",
        "authentication",
        "localAdministratorPrincipal",
        "entraAdministratorPrincipal",
        "applicationPrincipal"
      ],
      "properties": {
        "resourceId": {
          "$ref": "#/$defs/resourceId"
        },
        "family": {
          "enum": [
            "azure-sql",
            "postgresql-flexible"
          ]
        },
        "server": {
          "type": "string",
          "minLength": 1
        },
        "database": {
          "type": "string",
          "minLength": 1
        },
        "authentication": {
          "enum": [
            "password-secret",
            "managed-identity"
          ]
        },
        "applicationPrincipal": {
          "$ref": "#/$defs/applicationPrincipal"
        },
        "localAdministratorPrincipal": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/administratorPrincipal"
            }
          ]
        },
        "entraAdministratorPrincipal": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/entraAdministratorPrincipal"
            }
          ]
        }
      }
    },
    "databaseArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "exportTool",
        "importTool",
        "sha256",
        "bytes"
      ],
      "properties": {
        "format": {
          "enum": [
            "bacpac",
            "postgresql-custom"
          ]
        },
        "exportTool": {
          "$ref": "#/$defs/databaseTool"
        },
        "importTool": {
          "$ref": "#/$defs/databaseTool"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "databaseVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "migrationHistory",
        "schemaVerified",
        "constraintsVerified",
        "indexesVerified",
        "seedManifestVersion",
        "verifiedRowCounts"
      ],
      "properties": {
        "migrationHistory": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "schemaVerified": {
          "const": true
        },
        "constraintsVerified": {
          "const": true
        },
        "indexesVerified": {
          "const": true
        },
        "seedManifestVersion": {
          "const": "1.0.0"
        },
        "verifiedRowCounts": {
          "$ref": "#/$defs/corpusCounts"
        }
      }
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resourceId",
        "provider",
        "location",
        "authentication",
        "verification"
      ],
      "properties": {
        "resourceId": {
          "$ref": "#/$defs/resourceId"
        },
        "provider": {
          "enum": [
            "azure-files",
            "azure-blob"
          ]
        },
        "location": {
          "type": "string",
          "minLength": 1
        },
        "authentication": {
          "enum": [
            "managed-identity",
            "aca-volume-secret"
          ]
        },
        "verification": {
          "$ref": "#/$defs/imageVerification"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "stack": {
            "const": "dotnet-sqlserver"
          }
        },
        "required": [
          "stack"
        ]
      },
      "then": {
        "properties": {
          "migrationExecution": {
            "properties": {
              "hostVmResourceId": {
                "pattern": "/virtualMachines/vm-dotnet-[^/]+$"
              }
            }
          },
          "sourceDatabase": {
            "properties": {
              "family": {
                "const": "sqlserver"
              },
              "engineVersion": {
                "const": "2022"
              }
            }
          },
          "targetDatabase": {
            "properties": {
              "family": {
                "const": "azure-sql"
              },
              "resourceId": {
                "$ref": "#/$defs/azureSqlDatabaseResourceId"
              },
              "authentication": {
                "const": "managed-identity"
              },
              "localAdministratorPrincipal": {
                "type": "null"
              },
              "entraAdministratorPrincipal": {
                "type": "null"
              }
            }
          },
          "databaseArtifact": {
            "properties": {
              "format": {
                "const": "bacpac"
              },
              "exportTool": {
                "properties": {
                  "name": {
                    "const": "SqlPackage"
                  }
                }
              },
              "importTool": {
                "properties": {
                  "name": {
                    "const": "SqlPackage"
                  }
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "migrationExecution": {
            "properties": {
              "hostVmResourceId": {
                "pattern": "/virtualMachines/vm-java-[^/]+$"
              }
            }
          },
          "sourceDatabase": {
            "properties": {
              "family": {
                "const": "postgresql"
              },
              "engineVersion": {
                "const": "18.6"
              }
            }
          },
          "targetDatabase": {
            "properties": {
              "family": {
                "const": "postgresql-flexible"
              },
              "resourceId": {
                "$ref": "#/$defs/postgresqlDatabaseResourceId"
              },
              "localAdministratorPrincipal": {
                "$ref": "#/$defs/administratorPrincipal"
              },
              "entraAdministratorPrincipal": {
                "$ref": "#/$defs/entraAdministratorPrincipal"
              }
            }
          },
          "databaseArtifact": {
            "properties": {
              "format": {
                "const": "postgresql-custom"
              },
              "exportTool": {
                "properties": {
                  "name": {
                    "const": "pg_dump"
                  }
                }
              },
              "importTool": {
                "properties": {
                  "name": {
                    "const": "pg_restore"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "targetDatabase": {
            "properties": {
              "authentication": {
                "const": "password-secret"
              }
            },
            "required": [
              "authentication"
            ]
          }
        },
        "required": [
          "targetDatabase"
        ]
      },
      "then": {
        "properties": {
          "targetDatabase": {
            "properties": {
              "applicationPrincipal": {
                "properties": {
                  "kind": {
                    "const": "database-role"
                  },
                  "principalId": {
                    "type": "null"
                  }
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "targetDatabase": {
            "properties": {
              "applicationPrincipal": {
                "properties": {
                  "kind": {
                    "const": "managed-identity"
                  },
                  "principalId": {
                    "$ref": "#/$defs/guid"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "images": {
            "properties": {
              "provider": {
                "const": "azure-blob"
              }
            },
            "required": [
              "provider"
            ]
          }
        },
        "required": [
          "images"
        ]
      },
      "then": {
        "properties": {
          "images": {
            "properties": {
              "authentication": {
                "const": "managed-identity"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "images": {
            "properties": {
              "authentication": {
                "const": "aca-volume-secret"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "administratorPrincipal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "authentication"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_]{0,62}$"
        },
        "authentication": {
          "const": "password"
        }
      }
    },
    "applicationPrincipal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kind",
        "principalId"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "database-role",
            "managed-identity"
          ]
        },
        "principalId": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/guid"
            }
          ]
        }
      }
    },
    "azureSqlDatabaseResourceId": {
      "allOf": [
        {
          "$ref": "#/$defs/resourceId"
        },
        {
          "pattern": "/providers/Microsoft\\.Sql/servers/[^/]+/databases/[^/]+$"
        }
      ]
    },
    "commitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "corpusCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "figures",
        "categories"
      ],
      "properties": {
        "figures": {
          "type": "integer",
          "minimum": 1
        },
        "categories": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "databaseTool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "enum": [
            "SqlPackage",
            "pg_dump",
            "pg_restore"
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "guid": {
      "type": "string",
      "format": "uuid"
    },
    "entraAdministratorPrincipal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "objectId",
        "principalType"
      ],
      "properties": {
        "name": {
          "type": "string",
          "format": "email"
        },
        "objectId": {
          "$ref": "#/$defs/guid"
        },
        "principalType": {
          "const": "user"
        }
      }
    },
    "imageVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "imageCount",
        "imageBytes",
        "imageSetSha256",
        "seedManifestVersion"
      ],
      "properties": {
        "imageCount": {
          "type": "integer",
          "minimum": 1
        },
        "imageBytes": {
          "type": "integer",
          "minimum": 1
        },
        "imageSetSha256": {
          "$ref": "#/$defs/sha256"
        },
        "seedManifestVersion": {
          "const": "1.0.0"
        }
      }
    },
    "resourceId": {
      "type": "string",
      "pattern": "^/subscriptions/[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}/resourceGroups/[^/]+/providers/[^/]+(?:/[^/]+/[^/]+)+$"
    },
    "postgresqlDatabaseResourceId": {
      "allOf": [
        {
          "$ref": "#/$defs/resourceId"
        },
        {
          "pattern": "/providers/Microsoft\\.DBforPostgreSQL/flexibleServers/[^/]+/databases/[^/]+$"
        }
      ]
    },
    "peeringEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resourceId",
        "remoteVirtualNetworkResourceId",
        "provisioningState",
        "peeringState"
      ],
      "properties": {
        "resourceId": {
          "$ref": "#/$defs/virtualNetworkPeeringResourceId"
        },
        "remoteVirtualNetworkResourceId": {
          "$ref": "#/$defs/virtualNetworkResourceId"
        },
        "provisioningState": {
          "const": "Succeeded"
        },
        "peeringState": {
          "const": "Connected"
        }
      }
    },
    "privateDnsLinkEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resourceId",
        "virtualNetworkResourceId",
        "provisioningState",
        "registrationEnabled"
      ],
      "properties": {
        "resourceId": {
          "$ref": "#/$defs/privateDnsZoneLinkResourceId"
        },
        "virtualNetworkResourceId": {
          "$ref": "#/$defs/virtualNetworkResourceId"
        },
        "provisioningState": {
          "const": "Succeeded"
        },
        "registrationEnabled": {
          "const": false
        }
      }
    },
    "privateDnsZoneLinkResourceId": {
      "allOf": [
        {
          "$ref": "#/$defs/resourceId"
        },
        {
          "pattern": "/providers/Microsoft\\.Network/privateDnsZones/[^/]+/virtualNetworkLinks/[^/]+$"
        }
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "subnetResourceId": {
      "allOf": [
        {
          "$ref": "#/$defs/resourceId"
        },
        {
          "pattern": "/providers/Microsoft\\.Network/virtualNetworks/[^/]+/subnets/[^/]+$"
        }
      ]
    },
    "virtualMachineResourceId": {
      "allOf": [
        {
          "$ref": "#/$defs/resourceId"
        },
        {
          "pattern": "/providers/Microsoft\\.Compute/virtualMachines/[^/]+$"
        }
      ]
    },
    "virtualNetworkPeeringResourceId": {
      "allOf": [
        {
          "$ref": "#/$defs/resourceId"
        },
        {
          "pattern": "/providers/Microsoft\\.Network/virtualNetworks/[^/]+/virtualNetworkPeerings/[^/]+$"
        }
      ]
    },
    "virtualNetworkResourceId": {
      "allOf": [
        {
          "$ref": "#/$defs/resourceId"
        },
        {
          "pattern": "/providers/Microsoft\\.Network/virtualNetworks/[^/]+$"
        }
      ]
    },
    "stack": {
      "enum": [
        "dotnet-sqlserver",
        "java-postgresql"
      ]
    }
  }
}
