{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://microhack.example/schemas/sre-agent.schema.json",
  "title": "MicroHack Azure SRE Agent contract registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "challenge",
    "resources",
    "identity",
    "connectors",
    "rbac",
    "responsePlan",
    "incident",
    "investigation",
    "queries",
    "dependencies",
    "evidence",
    "billing",
    "cleanup"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "challenge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "participantGuide",
        "solutionGuide"
      ],
      "properties": {
        "id": {
          "const": "ch06-sre-agent"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "participantGuide": {
          "type": "string",
          "minLength": 1
        },
        "solutionGuide": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agentApiVersion",
        "connectorApiVersion",
        "agentType",
        "connectorType",
        "identityMode",
        "upgradeChannel",
        "incidentManagementType",
        "dedicatedResourceGroupRequired",
        "availabilityPreflightRequired",
        "networkPreflightRequired"
      ],
      "properties": {
        "agentApiVersion": {
          "const": "2026-01-01"
        },
        "connectorApiVersion": {
          "const": "2026-01-01"
        },
        "agentType": {
          "const": "Microsoft.App/agents"
        },
        "connectorType": {
          "const": "Microsoft.App/agents/connectors"
        },
        "identityMode": {
          "const": "SystemAssigned,UserAssigned"
        },
        "upgradeChannel": {
          "const": "Stable"
        },
        "incidentManagementType": {
          "const": "AzMonitor"
        },
        "dedicatedResourceGroupRequired": {
          "const": true
        },
        "availabilityPreflightRequired": {
          "const": true
        },
        "networkPreflightRequired": {
          "const": true
        }
      }
    },
    "identity": {
      "type": "object"
    },
    "connectors": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "object"
      }
    },
    "rbac": {
      "type": "object"
    },
    "responsePlan": {
      "type": "object"
    },
    "incident": {
      "type": "object"
    },
    "investigation": {
      "type": "object"
    },
    "queries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "responsePlanPreflightAudit",
        "investigationRequestFailures",
        "investigationExceptions",
        "investigationDatabaseDependencies",
        "badRevisionFailures",
        "agentAudit"
      ],
      "properties": {
        "responsePlanPreflightAudit": {
          "type": "string",
          "minLength": 1
        },
        "investigationRequestFailures": {
          "type": "string",
          "minLength": 1
        },
        "investigationExceptions": {
          "type": "string",
          "minLength": 1
        },
        "investigationDatabaseDependencies": {
          "type": "string",
          "minLength": 1
        },
        "badRevisionFailures": {
          "type": "string",
          "minLength": 1
        },
        "agentAudit": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "dependencies": {
      "type": "object"
    },
    "evidence": {
      "type": "object"
    },
    "billing": {
      "type": "object"
    },
    "cleanup": {
      "type": "object"
    }
  }
}
