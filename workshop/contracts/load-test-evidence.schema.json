{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CZSK-MicroHacks/MicroHack-AppInnovation/contracts/load-test-evidence.schema.json",
  "title": "Challenge 2 load and autoscaling evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "capturedAt",
    "subject",
    "capture",
    "windows",
    "testRun",
    "scaleConfiguration",
    "replicas",
    "databaseSignal",
    "recovery",
    "assertions"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.1.0"
    },
    "capturedAt": {
      "type": "string",
      "format": "date-time"
    },
    "subject": {
      "$ref": "#/$defs/subject"
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifestFile",
        "manifestSha256"
      ],
      "properties": {
        "manifestFile": {
          "const": "evidence/load/capture.json"
        },
        "manifestSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "windows": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baselineStart",
        "loadStart",
        "loadEnd",
        "recoveryEnd"
      ],
      "properties": {
        "baselineStart": {
          "type": "string",
          "format": "date-time"
        },
        "loadStart": {
          "type": "string",
          "format": "date-time"
        },
        "loadEnd": {
          "type": "string",
          "format": "date-time"
        },
        "recoveryEnd": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "testRun": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resourceId",
        "testId",
        "testRunId",
        "configurationFile",
        "configurationSha256",
        "jmeterFile",
        "jmeterSha256",
        "applicationUrl",
        "targetUrl",
        "performancePath",
        "apiKeyTransport",
        "virtualUsers",
        "durationSeconds",
        "startedAt",
        "completedAt",
        "resultFile"
      ],
      "properties": {
        "resourceId": {
          "$ref": "#/$defs/loadTestResourceId"
        },
        "testId": {
          "type": "string",
          "minLength": 1
        },
        "testRunId": {
          "type": "string",
          "minLength": 1
        },
        "configurationFile": {
          "const": "tests/load/load-test.yaml"
        },
        "configurationSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "jmeterFile": {
          "const": "tests/load/catalog-load.jmx"
        },
        "jmeterSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "applicationUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "targetUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "performancePath": {
          "const": "/perftest/catalog"
        },
        "apiKeyTransport": {
          "const": "secret-environment"
        },
        "virtualUsers": {
          "type": "integer",
          "minimum": 1
        },
        "durationSeconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 1800
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "completedAt": {
          "type": "string",
          "format": "date-time"
        },
        "resultFile": {
          "$ref": "#/$defs/evidencePath"
        }
      }
    },
    "scaleConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "containerAppResourceId",
        "revisionName",
        "minimumReplicas",
        "maximumReplicas",
        "ruleName",
        "ruleType",
        "concurrentRequests",
        "observedAt",
        "resultFile"
      ],
      "properties": {
        "source": {
          "const": "azure-resource-manager"
        },
        "containerAppResourceId": {
          "$ref": "#/$defs/resourceId"
        },
        "revisionName": {
          "type": "string",
          "minLength": 1
        },
        "minimumReplicas": {
          "const": 1
        },
        "maximumReplicas": {
          "const": 3
        },
        "ruleName": {
          "const": "http"
        },
        "ruleType": {
          "const": "http"
        },
        "concurrentRequests": {
          "const": 50
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        },
        "resultFile": {
          "$ref": "#/$defs/evidencePath"
        }
      }
    },
    "replicas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resourceId",
        "metric",
        "minimumConfigured",
        "maximumConfigured",
        "baselineObserved",
        "peakObserved",
        "resultFile"
      ],
      "properties": {
        "resourceId": {
          "$ref": "#/$defs/resourceId"
        },
        "metric": {
          "const": "Replicas"
        },
        "minimumConfigured": {
          "const": 1
        },
        "maximumConfigured": {
          "const": 3
        },
        "baselineObserved": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "peakObserved": {
          "type": "integer",
          "minimum": 2,
          "maximum": 3
        },
        "resultFile": {
          "$ref": "#/$defs/evidencePath"
        }
      }
    },
    "databaseSignal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resourceId",
        "family",
        "metric",
        "aggregation",
        "baseline",
        "peak",
        "unit",
        "resultFile"
      ],
      "properties": {
        "resourceId": {
          "$ref": "#/$defs/resourceId"
        },
        "family": {
          "enum": [
            "azure-sql",
            "postgresql-flexible"
          ]
        },
        "metric": {
          "enum": [
            "app_cpu_billed",
            "cpu_percent"
          ]
        },
        "aggregation": {
          "enum": [
            "Total",
            "Maximum"
          ]
        },
        "baseline": {
          "type": "number",
          "minimum": 0
        },
        "peak": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "resultFile": {
          "$ref": "#/$defs/evidencePath"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "family": {
                "const": "azure-sql"
              }
            },
            "required": [
              "family"
            ]
          },
          "then": {
            "properties": {
              "metric": {
                "const": "app_cpu_billed"
              },
              "aggregation": {
                "const": "Total"
              }
            }
          },
          "else": {
            "properties": {
              "metric": {
                "const": "cpu_percent"
              },
              "aggregation": {
                "const": "Maximum"
              }
            }
          }
        }
      ]
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observedReplicas",
        "withinSeconds",
        "healthStatus",
        "readinessStatus",
        "healthUrl",
        "readinessUrl",
        "resultFile"
      ],
      "properties": {
        "observedReplicas": {
          "const": 1
        },
        "withinSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 900
        },
        "healthStatus": {
          "const": 200
        },
        "readinessStatus": {
          "const": 200
        },
        "healthUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "readinessUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "resultFile": {
          "$ref": "#/$defs/evidencePath"
        }
      }
    },
    "assertions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allRequestsPassed",
        "scaledOut",
        "stayedWithinBounds",
        "databaseLoadObserved",
        "recovered"
      ],
      "properties": {
        "allRequestsPassed": {
          "const": true
        },
        "scaledOut": {
          "const": true
        },
        "stayedWithinBounds": {
          "const": true
        },
        "databaseLoadObserved": {
          "const": true
        },
        "recovered": {
          "const": true
        }
      }
    }
  },
  "$defs": {
    "resourceId": {
      "type": "string",
      "pattern": "^/subscriptions/[0-9a-fA-F-]{36}/resourceGroups/[^/]+/providers/[^/]+/.+$"
    },
    "loadTestResourceId": {
      "type": "string",
      "pattern": "^/subscriptions/[0-9a-fA-F-]{36}/resourceGroups/[^/]+/providers/Microsoft\\.LoadTestService/loadTests/[^/]+$"
    },
    "evidencePath": {
      "type": "string",
      "pattern": "^evidence/load/[a-z0-9-]+\\.json$"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sliceId",
        "stack",
        "databaseFamily",
        "sourceCommit",
        "imageDigest",
        "revisionName",
        "containerAppResourceId",
        "databaseResourceId"
      ],
      "properties": {
        "sliceId": {
          "enum": [
            "manual-dotnet",
            "manual-java",
            "copilot-rewrite-dotnet",
            "copilot-rewrite-java",
            "copilot-modernization-dotnet",
            "copilot-modernization-java"
          ]
        },
        "stack": {
          "enum": [
            "dotnet-sqlserver",
            "java-postgresql"
          ]
        },
        "databaseFamily": {
          "enum": [
            "azure-sql",
            "postgresql-flexible"
          ]
        },
        "sourceCommit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "imageDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "revisionName": {
          "type": "string",
          "minLength": 1
        },
        "containerAppResourceId": {
          "$ref": "#/$defs/resourceId"
        },
        "databaseResourceId": {
          "$ref": "#/$defs/resourceId"
        }
      }
    }
  }
}
