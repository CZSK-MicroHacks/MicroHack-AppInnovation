{
  "schemaVersion": "1.0.0",
  "challenge": {
    "id": "ch06-sre-agent",
    "title": "Azure SRE Agent reviewed rollback",
    "participantGuide": "challenges/ch06-sre-agent/README.md",
    "solutionGuide": "solutions/ch06-sre-agent/README.md"
  },
  "resources": {
    "agentApiVersion": "2026-01-01",
    "connectorApiVersion": "2026-01-01",
    "agentType": "Microsoft.App/agents",
    "connectorType": "Microsoft.App/agents/connectors",
    "identityMode": "SystemAssigned,UserAssigned",
    "upgradeChannel": "Stable",
    "incidentManagementType": "AzMonitor",
    "dedicatedResourceGroupRequired": true,
    "availabilityPreflightRequired": true,
    "networkPreflightRequired": true
  },
  "identity": {
    "knowledgeIdentity": "UserAssigned",
    "actionIdentity": "UserAssigned",
    "appInsightsConnectorIdentity": "SystemAssigned",
    "logAnalyticsConnectorIdentity": "SystemAssigned",
    "onBehalfOfElevationAllowed": false
  },
  "connectors": [
    {
      "name": "application-insights",
      "dataConnectorType": "AppInsights",
      "dataSourceHandoffField": "observability.applicationInsightsResourceId",
      "identity": "system",
      "requiredExtendedProperties": [
        "armResourceId",
        "resource.name",
        "appId"
      ]
    },
    {
      "name": "log-analytics",
      "dataConnectorType": "LogAnalytics",
      "dataSourceHandoffField": "observability.logAnalyticsWorkspaceResourceId",
      "identity": "system",
      "requiredExtendedProperties": [
        "armResourceId",
        "resource.name"
      ]
    }
  ],
  "rbac": {
    "grantPrerequisite": "User Access Administrator or Owner",
    "inventory": {
      "resourceGraphApiVersion": "2022-10-01",
      "resourceGraphTable": "authorizationresources",
      "subscriptionListRequired": true,
      "resultTruncatedAllowed": false,
      "effectiveAccessCommand": "az role assignment list --all --include-inherited --assignee-object-id <principal-id> --subscription <subscription-id> --fill-principal-name false --fill-role-definition-name false --output json"
    },
    "knowledgeAndConnectorRoles": [
      {
        "name": "Reader",
        "roleDefinitionId": "acdd72a7-3385-48ef-bd42-f606fba81ae7",
        "scope": "participant-resource-group",
        "principals": [
          "user-assigned",
          "system-assigned"
        ]
      },
      {
        "name": "Log Analytics Reader",
        "roleDefinitionId": "73c42c96-874c-492b-b04d-ab87d138a893",
        "scope": "participant-resource-group",
        "principals": [
          "user-assigned",
          "system-assigned"
        ]
      },
      {
        "name": "Monitoring Reader",
        "roleDefinitionId": "43d0d8ad-25c7-4714-9337-8ba259a9fe05",
        "scope": "participant-resource-group",
        "principals": [
          "user-assigned",
          "system-assigned"
        ]
      },
      {
        "name": "Monitoring Contributor",
        "roleDefinitionId": "749f88d5-cbae-40b8-bcfc-e573ddc772fa",
        "scope": "subscription-exception",
        "principals": [
          "user-assigned"
        ]
      }
    ],
    "humanRoles": [
      {
        "name": "Azure SRE Agent Administrator",
        "roleDefinitionId": "e79298df-d852-4c6d-84f9-5d13249d1e55",
        "scope": "agent-resource",
        "principal": "facilitator"
      },
      {
        "name": "Azure SRE Agent Standard User",
        "roleDefinitionId": "2d84a65a-63b2-4343-bbb6-31105d857bc1",
        "scope": "agent-resource",
        "principal": "participant"
      }
    ],
    "forbiddenRoleDefinitionIds": [
      "8e3af657-a8ff-443c-a75c-2fe8c4bcb635",
      "b24988ac-6180-42a0-ab88-20f7382dd24c",
      "ad7f0fbe-9e3b-4f4c-a782-d93df5c03c41"
    ],
    "customRollbackRole": {
      "name": "MicroHack Container App Traffic Rollback",
      "scope": "exact-container-app",
      "assignableScope": "participant-resource-group",
      "principal": "user-assigned",
      "actions": [
        "Microsoft.App/containerApps/read",
        "Microsoft.App/containerApps/write",
        "Microsoft.App/containerApps/revisions/read"
      ],
      "notActions": [],
      "dataActions": [],
      "notDataActions": []
    }
  },
  "responsePlan": {
    "producer": "azure-portal-facilitator-export",
    "platform": "AzureMonitor",
    "autonomyMode": "Review",
    "actionAccessLevel": "Low",
    "quickstartPlanEnabled": false,
    "participantMayApprove": false,
    "facilitatorApprovalRequired": true,
    "opaqueIncidentFiltersInIaCAllowed": false,
    "preflightTestIncidentRequired": true,
    "alertTitlePrefix": "MH-SRE-",
    "severity": "Sev2"
  },
  "incident": {
    "seed": {
      "reuseHandoffImageDigest": true,
      "preserveSecretReferences": true,
      "databaseHostEnvironmentVariable": "CATALOG_DATABASE_HOST",
      "invalidDatabaseHostSuffix": ".sre-drill.invalid",
      "healthyReadinessPath": "/readyz",
      "drillReadinessPath": "/healthz",
      "livenessPath": "/healthz"
    },
    "allowedRemediation": {
      "operation": "container-app-traffic-weight-update",
      "healthyRevisionWeight": 100,
      "badRevisionWeight": 0,
      "target": "exact-handoff-container-app"
    },
    "forbiddenOperations": [
      "secret-change",
      "image-change",
      "revision-activation-change",
      "resource-delete",
      "role-assignment-change",
      "participant-approval",
      "autonomous-execution"
    ],
    "requiredAuditEvents": [
      "IncidentActivitySnapshot",
      "AgentResponse",
      "AgentToolExecution",
      "ApprovalDecision",
      "AgentAzCliExecution",
      "AgentExecution"
    ],
    "sharedCorrelationFields": [
      "gen_ai.agent.id",
      "gen_ai.agent.name",
      "TraceId",
      "SpanId",
      "ParentSpanId",
      "ThreadId",
      "CorrelationId",
      "LogTimestamp"
    ]
  },
  "investigation": {
    "requiredSignals": [
      "aca-revision-traffic",
      "deployment-history",
      "request-failures",
      "exceptions",
      "database-dependencies",
      "selected-database-availability"
    ],
    "hypothesisCode": "bad-revision-selected-database-endpoint",
    "alternativeCodes": [
      "selected-database-platform-outage",
      "application-image-regression"
    ],
    "blastRadius": "exact-bad-revision-traffic",
    "verificationPlan": [
      "healthy-revision-100",
      "bad-revision-0",
      "health-200",
      "readiness-200",
      "alert-resolved"
    ],
    "databaseFamilies": {
      "azure-sql": {
        "telemetrySystem": "microsoft.sql_server",
        "availabilityStatus": "Online",
        "availabilityApiVersion": "2023-08-01"
      },
      "postgresql-flexible": {
        "telemetrySystem": "postgresql",
        "availabilityStatus": "Ready",
        "availabilityApiVersion": "2024-08-01"
      }
    }
  },
  "queries": {
    "responsePlanPreflightAudit": "customEvents\n| where timestamp between (datetime({testStart}) .. datetime({testEnd}))\n| where name in (\"IncidentActivitySnapshot\", \"AgentResponse\", \"ApprovalDecision\")\n| extend AgentId = tostring(customDimensions[\"gen_ai.agent.id\"]), AgentName = tostring(customDimensions[\"gen_ai.agent.name\"]), TraceId = tostring(customDimensions[\"TraceId\"]), SpanId = tostring(customDimensions[\"SpanId\"]), ParentSpanId = tostring(customDimensions[\"ParentSpanId\"]), ThreadId = tostring(customDimensions[\"ThreadId\"]), CorrelationId = tostring(customDimensions[\"CorrelationId\"]), LogTimestamp = tostring(customDimensions[\"LogTimestamp\"])\n| where AgentId == \"{agentId}\" and ThreadId == \"{threadId}\"\n| project timestamp, name, AgentId, AgentName, TraceId, SpanId, ParentSpanId, ThreadId, CorrelationId, LogTimestamp, Properties = customDimensions\n| order by timestamp asc",
    "investigationRequestFailures": "requests\n| where timestamp between (datetime({incidentStart}) .. datetime({investigationEnd}))\n| extend RevisionName = tostring(customDimensions[\"ContainerAppRevisionName\"])\n| where cloud_RoleName == \"{serviceName}\" and application_Version == \"{sourceCommit}\" and RevisionName == \"{badRevision}\"\n| summarize RequestCount = count(), FailedRequests = countif(success == false), FirstFailure = minif(timestamp, success == false), LastFailure = maxif(timestamp, success == false)",
    "investigationExceptions": "exceptions\n| where timestamp between (datetime({incidentStart}) .. datetime({investigationEnd}))\n| extend RevisionName = tostring(customDimensions[\"ContainerAppRevisionName\"])\n| where cloud_RoleName == \"{serviceName}\" and application_Version == \"{sourceCommit}\" and RevisionName == \"{badRevision}\"\n| summarize ExceptionCount = count(), FirstException = min(timestamp), LastException = max(timestamp), ExceptionTypes = make_set(type, 16)",
    "investigationDatabaseDependencies": "dependencies\n| where timestamp between (datetime({incidentStart}) .. datetime({investigationEnd}))\n| extend RevisionName = tostring(customDimensions[\"ContainerAppRevisionName\"]), DatabaseSystem = tostring(customDimensions[\"db.system.name\"])\n| where cloud_RoleName == \"{serviceName}\" and application_Version == \"{sourceCommit}\" and RevisionName == \"{badRevision}\" and DatabaseSystem == \"{databaseSystem}\"\n| summarize DependencyCount = count(), FailedDependencies = countif(success == false), FirstFailure = minif(timestamp, success == false), LastFailure = maxif(timestamp, success == false), Targets = make_set(target, 16)",
    "badRevisionFailures": "requests\n| where timestamp between (datetime({incidentStart}) .. datetime({incidentEnd}))\n| extend RevisionName = tostring(customDimensions[\"ContainerAppRevisionName\"])\n| where RevisionName == \"{badRevision}\"\n| summarize RequestCount = count(), FailedRequests = countif(success == false), FirstFailure = minif(timestamp, success == false), LastFailure = maxif(timestamp, success == false)",
    "agentAudit": "customEvents\n| where timestamp between (datetime({incidentStart}) .. datetime({incidentEnd}))\n| where name in (\"IncidentActivitySnapshot\", \"AgentResponse\", \"AgentToolExecution\", \"AgentExecution\", \"AgentAzCliExecution\", \"ApprovalDecision\")\n| extend AgentId = tostring(customDimensions[\"gen_ai.agent.id\"]), AgentName = tostring(customDimensions[\"gen_ai.agent.name\"]), TraceId = tostring(customDimensions[\"TraceId\"]), SpanId = tostring(customDimensions[\"SpanId\"]), ParentSpanId = tostring(customDimensions[\"ParentSpanId\"]), ThreadId = tostring(customDimensions[\"ThreadId\"]), CorrelationId = tostring(customDimensions[\"CorrelationId\"]), LogTimestamp = tostring(customDimensions[\"LogTimestamp\"])\n| where AgentId == \"{agentId}\" and ThreadId == \"{threadId}\"\n| project timestamp, name, AgentId, AgentName, TraceId, SpanId, ParentSpanId, ThreadId, CorrelationId, LogTimestamp, Properties = customDimensions\n| order by timestamp asc"
  },
  "dependencies": {
    "handoffSchemaVersion": "1.4.0",
    "cicdEvidenceSchemaVersion": "1.1.0",
    "observabilityEvidenceSchemaVersion": "1.1.0",
    "requiredHealthyRevisionFields": [
      "subject.revision",
      "rollback.restoredRevision"
    ],
    "requiredObservabilityFields": [
      "subject.applicationInsightsResourceId",
      "subject.logAnalyticsWorkspaceResourceId"
    ]
  },
  "evidence": {
    "captureSchema": "workshop/contracts/sre-agent-evidence-capture.schema.json",
    "reportSchema": "workshop/contracts/sre-agent-evidence.schema.json",
    "foundationSchema": "workshop/contracts/sre-agent-foundation.schema.json",
    "incidentSchema": "workshop/contracts/sre-agent-incident.schema.json",
    "cleanupSchema": "workshop/contracts/sre-agent-cleanup.schema.json",
    "responsePlanSchema": "workshop/contracts/sre-agent-response-plan.schema.json",
    "rendererCommand": "uv --no-config run catalog-render-sre-agent-evidence --capture <capture.json> --handoff <handoff.json> --output <report.json>",
    "validatorCommand": "uv --no-config run catalog-validate-sre-agent-evidence --capture <capture.json> --handoff <handoff.json> --report <report.json> --contracts workshop/contracts",
    "requiredArtifactKinds": [
      "target-output",
      "cicd-evidence",
      "observability-evidence",
      "sre-agent-foundation",
      "sre-agent-response-plan",
      "sre-agent-incident",
      "sre-agent-cleanup"
    ],
    "hashAlgorithm": "sha256",
    "liveEvidenceRequired": true,
    "checkedInExamplesAreEvidence": false
  },
  "billing": {
    "fixedAgentUnitsPerHour": 4,
    "stopEndsAlwaysOnBilling": false,
    "deleteEndsAlwaysOnBilling": true,
    "postDeletionCostQueryRequired": true
  },
  "cleanup": {
    "facilitatorAuthorizationRequired": true,
    "sequence": [
      "export-audit-and-incident-evidence",
      "delete-agent",
      "verify-agent-not-found",
      "remove-cross-scope-role-assignments",
      "verify-role-assignments-absent",
      "delete-dedicated-agent-resource-group",
      "verify-resource-group-not-found",
      "verify-protected-handoff-resources",
      "query-cost-management"
    ],
    "protectedHandoffResources": [
      "resourceGroup.resourceId",
      "network.virtualNetworkResourceId",
      "network.migrationSourceVirtualNetworkResourceId",
      "network.migrationSourceVmResourceId",
      "network.migrationSourceToTargetPeeringResourceId",
      "network.migrationTargetToSourcePeeringResourceId",
      "network.migrationPrivateDnsZoneLinkResourceIds",
      "containerRegistry.resourceId",
      "workloadIdentity.resourceId",
      "containerAppsEnvironmentResourceId",
      "database.resourceId",
      "images.resourceId",
      "observability.applicationInsightsResourceId",
      "observability.logAnalyticsWorkspaceResourceId",
      "application.resourceId"
    ],
    "postCleanupArmGetRequired": true
  }
}
