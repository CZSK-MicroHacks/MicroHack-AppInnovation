{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CZSK-MicroHacks/MicroHack-AppInnovation/contracts/defender-cleanup.schema.json",
  "title": "Defender for Cloud paid-plan cleanup manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "subscriptionId",
    "status",
    "facilitatorApprovalRequired",
    "plans",
    "priorPricings",
    "priorCleanupInventory",
    "costVerification"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.1.0"
    },
    "priorPricings": {
      "$ref": "#/$defs/artifact"
    },
    "subscriptionId": {
      "$ref": "#/$defs/subscriptionId"
    },
    "status": {
      "enum": [
        "scheduled",
        "completed"
      ]
    },
    "completedAt": {
      "$ref": "#/$defs/timestamp"
    },
    "facilitatorApprovalRequired": {
      "const": true
    },
    "plans": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "priorPricingTier",
          "priorSubPlan",
          "priorEnforce",
          "priorExtensions"
        ],
        "properties": {
          "name": {
            "enum": [
              "CloudPosture",
              "Containers",
              "SqlServers",
              "OpenSourceRelationalDatabases",
              "VirtualMachines"
            ]
          },
          "priorPricingTier": {
            "enum": [
              "Free",
              "Standard"
            ]
          },
          "priorSubPlan": {
            "type": [
              "string",
              "null"
            ]
          },
          "priorEnforce": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "True",
              "False",
              null
            ]
          },
          "priorExtensions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "isEnabled",
                "additionalExtensionProperties"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "isEnabled": {
                  "enum": [
                    "True",
                    "False"
                  ]
                },
                "additionalExtensionProperties": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "priorCleanupInventory": {
      "$ref": "#/$defs/artifact"
    },
    "postCleanupInventory": {
      "$ref": "#/$defs/artifact"
    },
    "postCleanupPricings": {
      "$ref": "#/$defs/artifact"
    },
    "costVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "billingDataMayLag"
      ],
      "properties": {
        "status": {
          "enum": [
            "scheduled",
            "queried"
          ]
        },
        "billingDataMayLag": {
          "const": true
        },
        "queriedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "evidenceFile": {
          "$ref": "#/$defs/repositoryPath"
        },
        "evidenceSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "scheduled"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "completedAt"
              ]
            },
            {
              "required": [
                "postCleanupPricings"
              ]
            },
            {
              "required": [
                "postCleanupInventory"
              ]
            }
          ]
        },
        "properties": {
          "costVerification": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "queriedAt"
                  ]
                },
                {
                  "required": [
                    "evidenceFile"
                  ]
                },
                {
                  "required": [
                    "evidenceSha256"
                  ]
                }
              ]
            },
            "properties": {
              "status": {
                "const": "scheduled"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "completed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "completedAt",
          "postCleanupPricings",
          "postCleanupInventory"
        ],
        "properties": {
          "costVerification": {
            "required": [
              "queriedAt",
              "evidenceFile",
              "evidenceSha256"
            ],
            "properties": {
              "status": {
                "const": "queried"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "costVerification": {
            "properties": {
              "status": {
                "const": "queried"
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "costVerification"
        ]
      },
      "then": {
        "properties": {
          "costVerification": {
            "required": [
              "queriedAt",
              "evidenceFile",
              "evidenceSha256"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "subscriptionId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F-]{36}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "repositoryPath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\/$)[A-Za-z0-9._/-]+$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "sha256"
      ],
      "properties": {
        "file": {
          "$ref": "#/$defs/repositoryPath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
