{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CZSK-MicroHacks/MicroHack-AppInnovation/contracts/defender-attack-path-envelope.schema.json",
  "title": "Digest-bound Defender attack-path Azure Resource Graph envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "request",
    "response"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "operation",
        "scopeResourceId",
        "resourcePath",
        "apiVersion",
        "queriedAt",
        "body"
      ],
      "properties": {
        "method": {
          "const": "POST"
        },
        "operation": {
          "const": "subscription-attack-paths"
        },
        "scopeResourceId": {
          "type": "string",
          "pattern": "^/subscriptions/[0-9a-fA-F-]{36}$"
        },
        "resourcePath": {
          "const": "providers/Microsoft.ResourceGraph/resources"
        },
        "apiVersion": {
          "const": "2022-10-01"
        },
        "queriedAt": {
          "type": "string",
          "format": "date-time"
        },
        "body": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "subscriptions",
            "query",
            "options"
          ],
          "properties": {
            "subscriptions": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[0-9a-fA-F-]{36}$"
              }
            },
            "query": {
              "type": "string",
              "minLength": 1
            },
            "options": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "resultFormat"
              ],
              "properties": {
                "resultFormat": {
                  "const": "objectArray"
                }
              }
            }
          }
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "totalRecords",
        "count",
        "resultTruncated",
        "facets",
        "data"
      ],
      "properties": {
        "totalRecords": {
          "type": "integer",
          "minimum": 0
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "resultTruncated": {
          "const": "false"
        },
        "facets": {
          "type": "array"
        },
        "data": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    }
  }
}
