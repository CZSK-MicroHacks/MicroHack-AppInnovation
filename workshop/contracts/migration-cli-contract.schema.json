{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CZSK-MicroHacks/MicroHack-AppInnovation/contracts/migration-cli-contract.schema.json",
  "title": "MicroHack migration CLI contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "executable",
    "commands",
    "migrationExecution",
    "releaseVerification",
    "failureProtocol",
    "postgresqlManagedIdentityBootstrap",
    "exitCodes",
    "safety"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.1.0"
    },
    "executable": {
      "const": "catalog-migrate"
    },
    "commands": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "prefixItems": [
        {
          "$ref": "#/$defs/sqlExport"
        },
        {
          "$ref": "#/$defs/sqlImport"
        },
        {
          "$ref": "#/$defs/postgresqlExport"
        },
        {
          "$ref": "#/$defs/postgresqlImport"
        },
        {
          "$ref": "#/$defs/imagesCopy"
        },
        {
          "$ref": "#/$defs/verify"
        },
        {
          "$ref": "#/$defs/renderHandoff"
        }
      ],
      "items": false
    },
    "migrationExecution": {
      "$ref": "#/$defs/migrationExecution"
    },
    "releaseVerification": {
      "$ref": "#/$defs/releaseVerification"
    },
    "failureProtocol": {
      "$ref": "#/$defs/failureProtocol"
    },
    "postgresqlManagedIdentityBootstrap": {
      "$ref": "#/$defs/postgresqlManagedIdentityBootstrap"
    },
    "exitCodes": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "prefixItems": [
        {
          "$ref": "#/$defs/successExit"
        },
        {
          "$ref": "#/$defs/invalidInputExit"
        },
        {
          "$ref": "#/$defs/preconditionExit"
        },
        {
          "$ref": "#/$defs/toolExit"
        },
        {
          "$ref": "#/$defs/verificationExit"
        }
      ],
      "items": false
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceReadOnly",
        "refuseNonemptyTarget",
        "requireExactTargetConfirmation",
        "argumentsAreExact",
        "deriveTargetSettingsFromTargetOutput",
        "secretsInEnvironmentOnly",
        "tokensInChildProcessEnvironmentOnly",
        "rejectUndeclaredSecrets",
        "stripMigrationSecretsFromChildEnvironment",
        "validateTargetResourceRelationships",
        "validateSourceDatabaseContract",
        "validateTargetDatabaseContract",
        "hashTargetImageBytes",
        "verifyCommitTagDigest",
        "requireDistinctRetainedRollbackRevision",
        "jsonForEveryFailure",
        "resourceDeletionSupported"
      ],
      "properties": {
        "sourceReadOnly": {
          "const": true
        },
        "refuseNonemptyTarget": {
          "const": true
        },
        "requireExactTargetConfirmation": {
          "const": true
        },
        "argumentsAreExact": {
          "const": true
        },
        "deriveTargetSettingsFromTargetOutput": {
          "const": true
        },
        "secretsInEnvironmentOnly": {
          "const": true
        },
        "tokensInChildProcessEnvironmentOnly": {
          "const": true
        },
        "rejectUndeclaredSecrets": {
          "const": true
        },
        "stripMigrationSecretsFromChildEnvironment": {
          "const": true
        },
        "validateTargetResourceRelationships": {
          "const": true
        },
        "validateSourceDatabaseContract": {
          "const": true
        },
        "validateTargetDatabaseContract": {
          "const": true
        },
        "hashTargetImageBytes": {
          "const": true
        },
        "verifyCommitTagDigest": {
          "const": true
        },
        "requireDistinctRetainedRollbackRevision": {
          "const": true
        },
        "jsonForEveryFailure": {
          "const": true
        },
        "resourceDeletionSupported": {
          "const": false
        }
      }
    }
  },
  "$defs": {
    "migrationExecution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "sourceVmResourceIdSource",
        "sourceVirtualNetworkResourceIdSource",
        "hostIdentityEndpoint",
        "hostIdentityHeader",
        "requireHostIdentityMatch",
        "sourceVmNicCommand",
        "sourceNicSubnetCommand",
        "resourceStateCommand",
        "peeringStateCommand",
        "privateDnsLinkStateCommand",
        "requiredProvisioningState",
        "requiredPeeringState",
        "requiredPrivateDnsRegistrationEnabled",
        "requireSourceSubnetOwnership",
        "requireReciprocalPeeringTargets",
        "requirePrivateDnsSourceVnetTargets",
        "requiresBidirectionalVnetPeering",
        "requiresPrivateDnsZoneLinks"
      ],
      "properties": {
        "host": {
          "const": "source-vm"
        },
        "sourceVmResourceIdSource": {
          "const": "target-output.network.migrationSourceVmResourceId"
        },
        "sourceVirtualNetworkResourceIdSource": {
          "const": "target-output.network.migrationSourceVirtualNetworkResourceId"
        },
        "hostIdentityEndpoint": {
          "const": "http://169.254.169.254/metadata/instance/compute/resourceId?api-version=2021-02-01&format=text"
        },
        "hostIdentityHeader": {
          "const": "Metadata:true"
        },
        "requireHostIdentityMatch": {
          "const": true
        },
        "sourceVmNicCommand": {
          "const": "az vm show --ids <sourceVmResourceId> --subscription <subscriptionId> --query networkProfile.networkInterfaces[].id --output tsv"
        },
        "sourceNicSubnetCommand": {
          "const": "az network nic show --ids <nicResourceId> --subscription <subscriptionId> --query ipConfigurations[].subnet.id --output tsv"
        },
        "resourceStateCommand": {
          "const": "az resource show --ids <resourceId> --subscription <subscriptionId> --query properties.provisioningState --output tsv"
        },
        "peeringStateCommand": {
          "const": "az network vnet peering show --resource-group <resourceGroup> --vnet-name <virtualNetworkName> --name <peeringName> --subscription <subscriptionId> --query {provisioningState:provisioningState,peeringState:peeringState,remoteVirtualNetworkId:remoteVirtualNetwork.id} --output json"
        },
        "privateDnsLinkStateCommand": {
          "const": "az network private-dns link vnet show --resource-group <resourceGroup> --zone-name <privateDnsZoneName> --name <linkName> --subscription <subscriptionId> --query {provisioningState:provisioningState,virtualNetworkId:virtualNetwork.id,registrationEnabled:registrationEnabled} --output json"
        },
        "requiredProvisioningState": {
          "const": "Succeeded"
        },
        "requiredPeeringState": {
          "const": "Connected"
        },
        "requiredPrivateDnsRegistrationEnabled": {
          "const": false
        },
        "requireSourceSubnetOwnership": {
          "const": true
        },
        "requireReciprocalPeeringTargets": {
          "const": true
        },
        "requirePrivateDnsSourceVnetTargets": {
          "const": true
        },
        "requiresBidirectionalVnetPeering": {
          "const": true
        },
        "requiresPrivateDnsZoneLinks": {
          "const": true
        }
      }
    },
    "releaseVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "azureCliConfigDirectory",
        "applicationRevisionSequence",
        "sameContainerImageForBaselineAndRelease",
        "handoffTargetOutputRole",
        "rollbackRevisionRole",
        "containerImageCommand",
        "rollbackRevisionCommand",
        "requiredRollbackHealthState",
        "requiredRollbackActive",
        "requiredRollbackContainerCount",
        "requiredRollbackRevisionTemplate",
        "rollbackImageReferenceTemplate"
      ],
      "properties": {
        "azureCliConfigDirectory": {
          "const": "$HOME/.azure-365"
        },
        "applicationRevisionSequence": {
          "const": [
            "baseline",
            "release"
          ]
        },
        "sameContainerImageForBaselineAndRelease": {
          "const": true
        },
        "handoffTargetOutputRole": {
          "const": "release"
        },
        "rollbackRevisionRole": {
          "const": "baseline"
        },
        "containerImageCommand": {
          "const": "az acr manifest show-metadata --registry <registryName> --name <repository>:<tag> --subscription <subscriptionId> --query digest --output tsv"
        },
        "rollbackRevisionCommand": {
          "const": "az containerapp revision show --resource-group <resourceGroup> --name <containerAppName> --revision <rollbackRevision> --subscription <subscriptionId> --query {active:properties.active,health:properties.healthState,error:properties.provisioningError,images:properties.template.containers[].image} --output json"
        },
        "requiredRollbackHealthState": {
          "const": "Healthy"
        },
        "requiredRollbackActive": {
          "const": false
        },
        "requiredRollbackContainerCount": {
          "const": 1
        },
        "requiredRollbackRevisionTemplate": {
          "const": "<containerAppName>--baseline-<sourceCommitPrefix12>"
        },
        "rollbackImageReferenceTemplate": {
          "const": "<loginServer>/<repository>@<digest>"
        }
      }
    },
    "failureProtocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "outputChannel",
        "exactlyOneDocument",
        "tracebackForbidden",
        "secretValuesForbidden"
      ],
      "properties": {
        "schema": {
          "const": "migration-error.schema.json"
        },
        "outputChannel": {
          "const": "stderr"
        },
        "exactlyOneDocument": {
          "const": true
        },
        "tracebackForbidden": {
          "const": true
        },
        "secretValuesForbidden": {
          "const": true
        }
      }
    },
    "postgresqlManagedIdentityBootstrap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "administratorSource",
        "administratorPrincipalType",
        "azureCliConfigDirectory",
        "azureCliPrincipalCommand",
        "tokenCommand",
        "tokenProcessEnvironment",
        "principalCreationDatabase",
        "principalCreationFunction",
        "applicationPrincipalNameSource",
        "applicationPrincipalObjectIdSource",
        "applicationPrincipalObjectType",
        "applicationPrincipalIsAdmin",
        "applicationPrincipalIsMfa"
      ],
      "properties": {
        "administratorSource": {
          "const": "target-output.database.entraAdministratorPrincipal"
        },
        "administratorPrincipalType": {
          "const": "user"
        },
        "azureCliConfigDirectory": {
          "const": "$HOME/.azure-365"
        },
        "azureCliPrincipalCommand": {
          "const": "az ad signed-in-user show"
        },
        "tokenCommand": {
          "const": "az account get-access-token --resource-type oss-rdbms"
        },
        "tokenProcessEnvironment": {
          "const": "PGPASSWORD"
        },
        "principalCreationDatabase": {
          "const": "postgres"
        },
        "principalCreationFunction": {
          "const": "pg_catalog.pgaadauth_create_principal_with_oid"
        },
        "applicationPrincipalNameSource": {
          "const": "target-output.database.applicationPrincipal.name"
        },
        "applicationPrincipalObjectIdSource": {
          "const": "target-output.workloadIdentity.principalId"
        },
        "applicationPrincipalObjectType": {
          "const": "service"
        },
        "applicationPrincipalIsAdmin": {
          "const": false
        },
        "applicationPrincipalIsMfa": {
          "const": false
        }
      }
    },
    "sqlExport": {
      "$ref": "#/$defs/command",
      "properties": {
        "name": {
          "const": "sql export"
        },
        "mutatesTarget": {
          "const": false
        },
        "requiredTargetOutputStage": {
          "const": "bootstrap"
        },
        "arguments": {
          "const": [
            "--source-server",
            "--source-database",
            "--source-username",
            "--target-output",
            "--artifact"
          ]
        },
        "requiredSecretEnvironment": {
          "const": [
            "MIGRATION_SOURCE_DATABASE_PASSWORD"
          ]
        },
        "secretEnvironmentByTargetAuthentication": {
          "type": "null"
        },
        "resultSchema": {
          "const": "migration-operation-result.schema.json"
        }
      }
    },
    "sqlImport": {
      "$ref": "#/$defs/command",
      "properties": {
        "name": {
          "const": "sql import"
        },
        "mutatesTarget": {
          "const": true
        },
        "requiredTargetOutputStage": {
          "const": "bootstrap"
        },
        "arguments": {
          "const": [
            "--artifact",
            "--target-output",
            "--target-resource-id",
            "--confirm-target-resource-id",
            "--execute"
          ]
        },
        "requiredSecretEnvironment": {
          "const": []
        },
        "secretEnvironmentByTargetAuthentication": {
          "type": "null"
        },
        "resultSchema": {
          "const": "migration-operation-result.schema.json"
        }
      }
    },
    "postgresqlExport": {
      "$ref": "#/$defs/command",
      "properties": {
        "name": {
          "const": "postgresql export"
        },
        "mutatesTarget": {
          "const": false
        },
        "requiredTargetOutputStage": {
          "const": "bootstrap"
        },
        "arguments": {
          "const": [
            "--source-host",
            "--source-port",
            "--source-database",
            "--source-username",
            "--target-output",
            "--artifact"
          ]
        },
        "requiredSecretEnvironment": {
          "const": [
            "MIGRATION_SOURCE_DATABASE_PASSWORD"
          ]
        },
        "secretEnvironmentByTargetAuthentication": {
          "type": "null"
        },
        "resultSchema": {
          "const": "migration-operation-result.schema.json"
        }
      }
    },
    "postgresqlImport": {
      "$ref": "#/$defs/command",
      "properties": {
        "name": {
          "const": "postgresql import"
        },
        "mutatesTarget": {
          "const": true
        },
        "requiredTargetOutputStage": {
          "const": "bootstrap"
        },
        "arguments": {
          "const": [
            "--artifact",
            "--target-output",
            "--target-resource-id",
            "--confirm-target-resource-id",
            "--execute"
          ]
        },
        "requiredSecretEnvironment": {
          "const": [
            "MIGRATION_TARGET_ADMINISTRATOR_PASSWORD"
          ]
        },
        "secretEnvironmentByTargetAuthentication": {
          "$ref": "#/$defs/targetAuthenticationSecretRules"
        },
        "resultSchema": {
          "const": "migration-operation-result.schema.json"
        }
      }
    },
    "imagesCopy": {
      "$ref": "#/$defs/command",
      "properties": {
        "name": {
          "const": "images copy"
        },
        "mutatesTarget": {
          "const": true
        },
        "requiredTargetOutputStage": {
          "const": "bootstrap"
        },
        "arguments": {
          "const": [
            "--source-directory",
            "--target-output",
            "--target-resource-id",
            "--confirm-target-resource-id",
            "--execute"
          ]
        },
        "requiredSecretEnvironment": {
          "const": []
        },
        "secretEnvironmentByTargetAuthentication": {
          "type": "null"
        },
        "resultSchema": {
          "const": "migration-operation-result.schema.json"
        }
      }
    },
    "verify": {
      "$ref": "#/$defs/command",
      "properties": {
        "name": {
          "const": "verify"
        },
        "mutatesTarget": {
          "const": false
        },
        "requiredTargetOutputStage": {
          "const": "bootstrap"
        },
        "arguments": {
          "const": [
            "--stack",
            "--source-commit",
            "--database-artifact",
            "--target-output",
            "--output"
          ]
        },
        "requiredSecretEnvironment": {
          "const": []
        },
        "secretEnvironmentByTargetAuthentication": {
          "$ref": "#/$defs/targetAuthenticationSecretRules"
        },
        "resultSchema": {
          "const": "migration-report.schema.json"
        }
      }
    },
    "renderHandoff": {
      "$ref": "#/$defs/command",
      "properties": {
        "name": {
          "const": "render-handoff"
        },
        "mutatesTarget": {
          "const": false
        },
        "requiredTargetOutputStage": {
          "const": "application"
        },
        "arguments": {
          "const": [
            "--target-output",
            "--migration-report",
            "--acceptance-report",
            "--telemetry-report",
            "--runtime-test-report",
            "--rollback-revision",
            "--output"
          ]
        },
        "requiredSecretEnvironment": {
          "const": []
        },
        "secretEnvironmentByTargetAuthentication": {
          "type": "null"
        },
        "resultSchema": {
          "const": "modernization-contract.schema.json"
        }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "mutatesTarget",
        "requiredTargetOutputStage",
        "arguments",
        "requiredSecretEnvironment",
        "secretEnvironmentByTargetAuthentication",
        "resultSchema"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "mutatesTarget": {
          "type": "boolean"
        },
        "requiredTargetOutputStage": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "bootstrap",
            "application",
            null
          ]
        },
        "arguments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "requiredSecretEnvironment": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "secretEnvironmentByTargetAuthentication": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/targetAuthenticationSecretRules"
            }
          ]
        },
        "resultSchema": {
          "type": "string"
        }
      }
    },
    "targetAuthenticationSecretRules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selector",
        "password-secret",
        "managed-identity"
      ],
      "properties": {
        "selector": {
          "const": "target-output.database.authentication"
        },
        "password-secret": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "required",
            "forbidden"
          ],
          "properties": {
            "required": {
              "const": [
                "MIGRATION_TARGET_APPLICATION_PASSWORD"
              ]
            },
            "forbidden": {
              "const": []
            }
          }
        },
        "managed-identity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "required",
            "forbidden"
          ],
          "properties": {
            "required": {
              "const": []
            },
            "forbidden": {
              "const": [
                "MIGRATION_TARGET_APPLICATION_PASSWORD"
              ]
            }
          }
        }
      }
    },
    "successExit": {
      "$ref": "#/$defs/exitCode",
      "properties": {
        "name": {
          "const": "success"
        },
        "code": {
          "const": 0
        }
      }
    },
    "invalidInputExit": {
      "$ref": "#/$defs/exitCode",
      "properties": {
        "name": {
          "const": "invalid-input"
        },
        "code": {
          "const": 2
        }
      }
    },
    "preconditionExit": {
      "$ref": "#/$defs/exitCode",
      "properties": {
        "name": {
          "const": "precondition-failed"
        },
        "code": {
          "const": 3
        }
      }
    },
    "toolExit": {
      "$ref": "#/$defs/exitCode",
      "properties": {
        "name": {
          "const": "tool-failed"
        },
        "code": {
          "const": 4
        }
      }
    },
    "verificationExit": {
      "$ref": "#/$defs/exitCode",
      "properties": {
        "name": {
          "const": "verification-failed"
        },
        "code": {
          "const": 5
        }
      }
    },
    "exitCode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "code"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "code": {
          "type": "integer"
        }
      }
    }
  }
}
