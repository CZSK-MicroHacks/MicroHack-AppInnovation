{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://microhack.example/schemas/sre-agent-response-plan.schema.json",
  "title": "MicroHack Azure SRE Agent portal response-plan preflight",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "producer",
    "capturedAt",
    "capturedByPrincipalId",
    "portalUri",
    "agentResourceId",
    "agentApplicationInsightsResourceId",
    "plan",
    "testIncident",
    "audit"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "producer": {
      "const": "azure-portal-facilitator-export"
    },
    "capturedAt": {
      "$ref": "#/$defs/timestamp"
    },
    "capturedByPrincipalId": {
      "$ref": "#/$defs/guid"
    },
    "portalUri": {
      "type": "string",
      "pattern": "^https://portal\\.azure\\.com/"
    },
    "agentResourceId": {
      "$ref": "#/$defs/resourceId"
    },
    "agentApplicationInsightsResourceId": {
      "$ref": "#/$defs/resourceId"
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "name",
        "autonomyMode",
        "quickstartPlanEnabled",
        "participantApprovalAllowed",
        "reviewProposalObserved"
      ],
      "properties": {
        "platform": {
          "const": "AzureMonitor"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "autonomyMode": {
          "const": "Review"
        },
        "quickstartPlanEnabled": {
          "const": false
        },
        "participantApprovalAllowed": {
          "const": false
        },
        "reviewProposalObserved": {
          "const": true
        }
      }
    },
    "testIncident": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "alertId",
        "threadId",
        "traceId",
        "correlationId",
        "testStart",
        "deliveredAt",
        "reviewedAt",
        "testEnd",
        "decision",
        "reviewedByPrincipalId",
        "writeExecuted"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "alertId": {
          "$ref": "#/$defs/resourceId"
        },
        "threadId": {
          "type": "string",
          "minLength": 1
        },
        "traceId": {
          "type": "string",
          "minLength": 1
        },
        "correlationId": {
          "$ref": "#/$defs/guid"
        },
        "testStart": {
          "$ref": "#/$defs/timestamp"
        },
        "deliveredAt": {
          "$ref": "#/$defs/timestamp"
        },
        "reviewedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "testEnd": {
          "$ref": "#/$defs/timestamp"
        },
        "decision": {
          "const": "Rejected"
        },
        "reviewedByPrincipalId": {
          "$ref": "#/$defs/guid"
        },
        "writeExecuted": {
          "const": false
        }
      }
    },
    "audit": {
      "type": "object",
      "required": [
        "request",
        "response"
      ],
      "properties": {
        "request": {
          "type": "object"
        },
        "response": {
          "type": "object"
        }
      }
    }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "guid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "resourceId": {
      "type": "string",
      "pattern": "^/subscriptions/[0-9a-f-]+/"
    }
  }
}
