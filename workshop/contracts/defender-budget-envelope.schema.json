{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CZSK-MicroHacks/MicroHack-AppInnovation/contracts/defender-budget-envelope.schema.json",
  "title": "Subscription budget query envelope for the Defender workshop",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "request",
    "response"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "operation",
        "scopeResourceId",
        "apiVersion",
        "queriedAt"
      ],
      "properties": {
        "method": {
          "const": "GET"
        },
        "operation": {
          "const": "subscription-cost-budget"
        },
        "scopeResourceId": {
          "type": "string",
          "pattern": "^/subscriptions/[0-9a-fA-F-]{36}$"
        },
        "apiVersion": {
          "const": "2023-11-01"
        },
        "queriedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "response": {
      "type": "object",
      "required": [
        "id",
        "name",
        "type",
        "properties"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^/subscriptions/[0-9a-fA-F-]{36}/providers/Microsoft\\.Consumption/budgets/[^/]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "Microsoft.Consumption/budgets"
        },
        "properties": {
          "type": "object",
          "required": [
            "amount",
            "category",
            "timeGrain",
            "timePeriod",
            "notifications"
          ],
          "properties": {
            "amount": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "category": {
              "const": "Cost"
            },
            "timeGrain": {
              "const": "Monthly"
            },
            "timePeriod": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "startDate",
                "endDate"
              ],
              "properties": {
                "startDate": {
                  "type": "string",
                  "format": "date-time"
                },
                "endDate": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            },
            "notifications": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": "object",
                "additionalProperties": true,
                "required": [
                  "enabled",
                  "operator",
                  "threshold",
                  "thresholdType",
                  "contactEmails",
                  "contactGroups",
                  "contactRoles"
                ],
                "properties": {
                  "enabled": {
                    "type": "boolean"
                  },
                  "operator": {
                    "enum": [
                      "EqualTo",
                      "GreaterThan",
                      "GreaterThanOrEqualTo"
                    ]
                  },
                  "threshold": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1000
                  },
                  "thresholdType": {
                    "enum": [
                      "Actual",
                      "Forecasted"
                    ]
                  },
                  "contactEmails": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 3
                    }
                  },
                  "contactGroups": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "contactRoles": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
