{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CZSK-MicroHacks/MicroHack-AppInnovation/contracts/telemetry-evidence.schema.json",
  "title": "Telemetry evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "capturedAt",
    "service",
    "resourceAttributes",
    "queries"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "capturedAt": {
      "type": "string",
      "format": "date-time"
    },
    "service": {
      "enum": [
        "mh-catalog-dotnet",
        "mh-catalog-java"
      ]
    },
    "resourceAttributes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "service.name",
        "service.namespace",
        "service.version",
        "deployment.environment",
        "service.instance.id",
        "azure.containerapps.revision.name"
      ],
      "properties": {
        "service.name": {
          "enum": [
            "mh-catalog-dotnet",
            "mh-catalog-java"
          ]
        },
        "service.namespace": {
          "const": "app-innovation"
        },
        "service.version": {
          "type": "string",
          "minLength": 1
        },
        "deployment.environment": {
          "const": "lab"
        },
        "service.instance.id": {
          "type": "string",
          "minLength": 1
        },
        "azure.containerapps.revision.name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "queries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resources",
        "traces",
        "metrics",
        "logs"
      ],
      "properties": {
        "resources": {
          "$ref": "#/$defs/query"
        },
        "traces": {
          "$ref": "#/$defs/query"
        },
        "metrics": {
          "$ref": "#/$defs/query"
        },
        "logs": {
          "$ref": "#/$defs/query"
        }
      }
    }
  },
  "$defs": {
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query",
        "resultFile",
        "expectedSignalNames"
      ],
      "properties": {
        "query": {
          "type": "string",
          "minLength": 10
        },
        "resultFile": {
          "type": "string",
          "minLength": 1,
          "not": {
            "anyOf": [
              {
                "pattern": "^(?:/|[A-Za-z]:\\\\)"
              },
              {
                "pattern": "(?:^|/)\\.\\.(?:/|$)"
              }
            ]
          }
        },
        "expectedSignalNames": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
