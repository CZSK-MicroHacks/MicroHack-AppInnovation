{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://microhack.example/schemas/sre-agent-cleanup.schema.json",
  "title": "MicroHack Azure SRE Agent cleanup capture",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "authorization",
    "evidenceExportedAt",
    "agentDeletedAt",
    "agentVerification",
    "roleAssignmentsRemovedAt",
    "roleAssignmentVerification",
    "resourceGroupDeletedAt",
    "resourceGroupVerification",
    "costVerification",
    "protectedResources",
    "protectedResourceVerification",
    "completedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.1.0"
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorized",
        "authorizedBy",
        "authorizedByPrincipalId",
        "authorizedAt",
        "scope"
      ],
      "properties": {
        "authorized": {
          "const": true
        },
        "authorizedBy": {
          "type": "string",
          "minLength": 1
        },
        "authorizedByPrincipalId": {
          "$ref": "#/$defs/guid"
        },
        "authorizedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "scope": {
          "const": "sre-agent-only"
        }
      }
    },
    "evidenceExportedAt": {
      "$ref": "#/$defs/timestamp"
    },
    "agentDeletedAt": {
      "$ref": "#/$defs/timestamp"
    },
    "agentVerification": {
      "$ref": "#/$defs/notFound"
    },
    "roleAssignmentsRemovedAt": {
      "$ref": "#/$defs/timestamp"
    },
    "roleAssignmentVerification": {
      "type": "object"
    },
    "resourceGroupDeletedAt": {
      "$ref": "#/$defs/timestamp"
    },
    "resourceGroupVerification": {
      "$ref": "#/$defs/notFound"
    },
    "costVerification": {
      "$ref": "#/$defs/costVerification"
    },
    "protectedResources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/resourceId"
      }
    },
    "protectedResourceVerification": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request",
          "statusCode",
          "observedAt"
        ],
        "properties": {
          "request": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "method",
              "url"
            ],
            "properties": {
              "method": {
                "const": "GET"
              },
              "url": {
                "type": "string",
                "pattern": "^/subscriptions/.+\\?api-version="
              }
            }
          },
          "statusCode": {
            "const": 200
          },
          "observedAt": {
            "$ref": "#/$defs/timestamp"
          }
        }
      }
    },
    "completedAt": {
      "$ref": "#/$defs/timestamp"
    }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "resourceId": {
      "type": "string",
      "pattern": "^/subscriptions/[0-9a-f-]+/"
    },
    "guid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "costVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request",
        "queriedAt",
        "dataThrough",
        "response",
        "billingAfterDeletionObserved",
        "costDataLagAcknowledged"
      ],
      "properties": {
        "request": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method",
            "url",
            "body"
          ],
          "properties": {
            "method": {
              "const": "POST"
            },
            "url": {
              "type": "string",
              "pattern": "^/subscriptions/[0-9a-f-]+/providers/Microsoft\\.CostManagement/query\\?api-version=2023-03-01$"
            },
            "body": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "timeframe",
                "timePeriod",
                "dataset"
              ],
              "properties": {
                "type": {
                  "const": "Usage"
                },
                "timeframe": {
                  "const": "Custom"
                },
                "timePeriod": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "from",
                    "to"
                  ],
                  "properties": {
                    "from": {
                      "$ref": "#/$defs/timestamp"
                    },
                    "to": {
                      "$ref": "#/$defs/timestamp"
                    }
                  }
                },
                "dataset": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "granularity",
                    "aggregation",
                    "grouping",
                    "filter"
                  ],
                  "properties": {
                    "granularity": {
                      "const": "Daily"
                    },
                    "aggregation": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "agentUnits"
                      ],
                      "properties": {
                        "agentUnits": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "name",
                            "function"
                          ],
                          "properties": {
                            "name": {
                              "const": "UsageQuantity"
                            },
                            "function": {
                              "const": "Sum"
                            }
                          }
                        }
                      }
                    },
                    "grouping": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 1,
                      "items": {
                        "type": "object"
                      }
                    },
                    "filter": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        },
        "queriedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "dataThrough": {
          "$ref": "#/$defs/timestamp"
        },
        "response": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "name",
            "type",
            "properties"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^/subscriptions/[0-9a-f-]+/providers/Microsoft\\.CostManagement/query/.+$"
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "type": {
              "const": "Microsoft.CostManagement/query"
            },
            "properties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "nextLink",
                "columns",
                "rows"
              ],
              "properties": {
                "nextLink": {
                  "type": "null"
                },
                "columns": {
                  "type": "array",
                  "minItems": 3,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "name",
                      "type"
                    ],
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 1
                      },
                      "type": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                },
                "rows": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "array"
                  }
                }
              }
            }
          }
        },
        "billingAfterDeletionObserved": {
          "type": "boolean"
        },
        "costDataLagAcknowledged": {
          "const": true
        }
      }
    },
    "notFound": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request",
        "statusCode",
        "observedAt"
      ],
      "properties": {
        "request": {
          "type": "object"
        },
        "statusCode": {
          "const": 404
        },
        "observedAt": {
          "$ref": "#/$defs/timestamp"
        }
      }
    }
  }
}
