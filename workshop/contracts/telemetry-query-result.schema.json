{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CZSK-MicroHacks/MicroHack-AppInnovation/contracts/telemetry-query-result.schema.json",
  "title": "Normalized telemetry query result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "queryId",
    "rows"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "queryId": {
      "enum": [
        "resources",
        "traces",
        "metrics",
        "logs"
      ]
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "signalName",
          "recordCount",
          "observedAttributes"
        ],
        "properties": {
          "signalName": {
            "type": "string",
            "minLength": 1
          },
          "recordCount": {
            "type": "integer",
            "minimum": 1
          },
          "observedAttributes": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "resourceAttributes": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
