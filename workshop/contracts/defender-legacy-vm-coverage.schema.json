{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CZSK-MicroHacks/MicroHack-AppInnovation/contracts/defender-legacy-vm-coverage.schema.json",
  "title": "Defender for Servers retained VM coverage envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "observedAt",
    "apiVersion",
    "virtualMachines"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "observedAt": {
      "type": "string",
      "format": "date-time"
    },
    "apiVersion": {
      "const": "2024-11-01"
    },
    "virtualMachines": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "workload",
          "request",
          "response"
        ],
        "properties": {
          "workload": {
            "enum": [
              "dotnet",
              "java"
            ]
          },
          "request": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "method",
              "resourceId"
            ],
            "properties": {
              "method": {
                "const": "GET"
              },
              "resourceId": {
                "type": "string",
                "pattern": "^/subscriptions/[0-9a-fA-F-]{36}/resourceGroups/[^/]+/providers/Microsoft\\.Compute/virtualMachines/[^/]+$"
              }
            }
          },
          "response": {
            "type": "object",
            "required": [
              "statusCode",
              "body"
            ],
            "properties": {
              "statusCode": {
                "const": 200
              },
              "body": {
                "type": "object",
                "required": [
                  "id",
                  "name",
                  "type",
                  "location",
                  "properties"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "type": {
                    "const": "Microsoft.Compute/virtualMachines"
                  },
                  "location": {
                    "type": "string",
                    "minLength": 1
                  },
                  "properties": {
                    "type": "object",
                    "required": [
                      "provisioningState"
                    ],
                    "properties": {
                      "provisioningState": {
                        "const": "Succeeded"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
