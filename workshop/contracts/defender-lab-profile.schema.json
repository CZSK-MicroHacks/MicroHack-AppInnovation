{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CZSK-MicroHacks/MicroHack-AppInnovation/contracts/defender-lab-profile.schema.json",
  "title": "Challenge 5 controlled lab posture profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "profileId",
    "activationPolicy",
    "controls",
    "asynchronousFindings",
    "prewarmedSnapshot"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "profileId": {
      "const": "secure-modernization-baseline"
    },
    "activationPolicy": {
      "const": "do-not-weaken-secure-baseline"
    },
    "controls": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "baseline",
          "participantAction"
        ],
        "properties": {
          "id": {
            "enum": [
              "acr-admin-authentication",
              "container-app-ingress",
              "database-public-network",
              "legacy-vm-management-ingress"
            ]
          },
          "baseline": {
            "type": "string",
            "minLength": 1
          },
          "participantAction": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "asynchronousFindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requiredToQuery",
        "requiredToBeNonEmpty",
        "attackPaths"
      ],
      "properties": {
        "requiredToQuery": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "requiredToBeNonEmpty": {
          "const": []
        },
        "attackPaths": {
          "const": "query-required-results-optional"
        }
      }
    },
    "prewarmedSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requiredSignals",
        "recommendationResourceCoverage",
        "minimumUnhealthyRecommendations"
      ],
      "properties": {
        "requiredSignals": {
          "const": [
            "image-vulnerability-assessment",
            "recommendations",
            "secure-score",
            "mcsb-controls"
          ]
        },
        "recommendationResourceCoverage": {
          "const": [
            "dotnet-vm",
            "java-vm",
            "container-app",
            "container-registry",
            "database"
          ]
        },
        "minimumUnhealthyRecommendations": {
          "const": 1
        }
      }
    }
  }
}
