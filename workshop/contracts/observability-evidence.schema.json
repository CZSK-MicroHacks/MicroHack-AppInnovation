{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CZSK-MicroHacks/MicroHack-AppInnovation/contracts/observability-evidence.schema.json",
  "title": "Challenge 4 observability workbook evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "capturedAt",
    "subject",
    "source",
    "window",
    "telemetryReport",
    "metricsExport",
    "workbook",
    "panels",
    "assertions"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.1.0"
    },
    "capturedAt": {
      "type": "string",
      "format": "date-time"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sliceId",
        "serviceName",
        "sourceCommit",
        "revisionName",
        "containerAppResourceId"
      ],
      "properties": {
        "sliceId": {
          "enum": [
            "manual-dotnet",
            "manual-java",
            "copilot-rewrite-dotnet",
            "copilot-rewrite-java",
            "copilot-modernization-dotnet",
            "copilot-modernization-java"
          ]
        },
        "serviceName": {
          "enum": [
            "mh-catalog-dotnet",
            "mh-catalog-java"
          ]
        },
        "sourceCommit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "revisionName": {
          "type": "string",
          "minLength": 1
        },
        "containerAppResourceId": {
          "type": "string",
          "pattern": "^/subscriptions/[0-9a-fA-F-]{36}/resourceGroups/[^/]+/providers/Microsoft\\.App/containerApps/[^/]+$"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applicationInsightsResourceId",
        "logAnalyticsWorkspaceResourceId",
        "serviceName",
        "serviceNamespace",
        "environment",
        "directAzureMonitorExporter"
      ],
      "properties": {
        "applicationInsightsResourceId": {
          "type": "string",
          "pattern": "/providers/Microsoft\\.Insights/components/[^/]+$"
        },
        "logAnalyticsWorkspaceResourceId": {
          "type": "string",
          "pattern": "/providers/Microsoft\\.OperationalInsights/workspaces/[^/]+$"
        },
        "serviceName": {
          "enum": [
            "mh-catalog-dotnet",
            "mh-catalog-java"
          ]
        },
        "serviceNamespace": {
          "const": "app-innovation"
        },
        "environment": {
          "const": "lab"
        },
        "directAzureMonitorExporter": {
          "const": true
        }
      }
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "startTime",
        "endTime"
      ],
      "properties": {
        "startTime": {
          "type": "string",
          "format": "date-time"
        },
        "endTime": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "telemetryReport": {
      "const": "evidence/telemetry-report.json"
    },
    "metricsExport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "containerAppResourceId",
        "workspaceResourceId",
        "diagnosticSettingName",
        "metricCategory",
        "destinationTable",
        "scope",
        "dimensionHandling",
        "deployedAt",
        "resultFile"
      ],
      "properties": {
        "containerAppResourceId": {
          "type": "string",
          "pattern": "/providers/Microsoft\\.App/containerApps/[^/]+$"
        },
        "workspaceResourceId": {
          "type": "string",
          "pattern": "/providers/Microsoft\\.OperationalInsights/workspaces/[^/]+$"
        },
        "diagnosticSettingName": {
          "const": "all-metrics-to-workspace"
        },
        "metricCategory": {
          "const": "AllMetrics"
        },
        "destinationTable": {
          "const": "AzureMetrics"
        },
        "scope": {
          "const": "container-app-total"
        },
        "dimensionHandling": {
          "const": "flattened"
        },
        "deployedAt": {
          "type": "string",
          "format": "date-time"
        },
        "resultFile": {
          "type": "string",
          "const": "evidence/observability/metrics-export.json"
        }
      }
    },
    "workbook": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resourceId",
        "sourceId",
        "templateFile",
        "templateSha256",
        "bicepFile",
        "queriesFile",
        "queriesSha256",
        "serializedDataSha256",
        "deployedAt",
        "resultFile"
      ],
      "properties": {
        "resourceId": {
          "type": "string",
          "pattern": "^/subscriptions/[0-9a-fA-F-]{36}/resourceGroups/[^/]+/providers/Microsoft\\.Insights/workbooks/[0-9a-fA-F-]{36}$"
        },
        "sourceId": {
          "type": "string",
          "pattern": "/providers/Microsoft\\.OperationalInsights/workspaces/[^/]+$"
        },
        "templateFile": {
          "const": "workshop/observability/workbook.json"
        },
        "templateSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bicepFile": {
          "const": "infra/observability-workbook.bicep"
        },
        "queriesFile": {
          "const": "workshop/observability/queries.kql"
        },
        "queriesSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "serializedDataSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "deployedAt": {
          "type": "string",
          "format": "date-time"
        },
        "resultFile": {
          "type": "string",
          "const": "evidence/observability/workbook.json"
        }
      }
    },
    "panels": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "prefixItems": [
        {
          "$ref": "#/$defs/errorRate"
        },
        {
          "$ref": "#/$defs/latency"
        },
        {
          "$ref": "#/$defs/databaseFailures"
        },
        {
          "$ref": "#/$defs/replicaCount"
        },
        {
          "$ref": "#/$defs/coldStarts"
        }
      ],
      "items": false
    },
    "assertions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "telemetryIdentityBound",
        "tracesPresent",
        "metricsPresent",
        "logsPresent",
        "applicationTelemetryRevisionFilterApplied",
        "workbookDeployed",
        "allPanelsEvaluated"
      ],
      "properties": {
        "telemetryIdentityBound": {
          "const": true
        },
        "tracesPresent": {
          "const": true
        },
        "metricsPresent": {
          "const": true
        },
        "logsPresent": {
          "const": true
        },
        "applicationTelemetryRevisionFilterApplied": {
          "const": true
        },
        "workbookDeployed": {
          "const": true
        },
        "allPanelsEvaluated": {
          "const": true
        }
      }
    }
  },
  "$defs": {
    "panel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "resultKind",
        "query",
        "querySha256",
        "resultFile",
        "rowCount"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "resultKind": {
          "type": "string"
        },
        "query": {
          "type": "string",
          "minLength": 20
        },
        "querySha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "resultFile": {
          "type": "string",
          "pattern": "^evidence/observability/[a-z0-9-]+\\.json$"
        },
        "rowCount": {
          "const": 1
        }
      }
    },
    "errorRate": {
      "allOf": [
        {
          "$ref": "#/$defs/panel"
        },
        {
          "properties": {
            "id": {
              "const": "error-rate"
            },
            "resultKind": {
              "const": "error-rate"
            }
          }
        }
      ]
    },
    "latency": {
      "allOf": [
        {
          "$ref": "#/$defs/panel"
        },
        {
          "properties": {
            "id": {
              "const": "latency"
            },
            "resultKind": {
              "const": "duration-ms"
            }
          }
        }
      ]
    },
    "databaseFailures": {
      "allOf": [
        {
          "$ref": "#/$defs/panel"
        },
        {
          "properties": {
            "id": {
              "const": "database-dependency-failures"
            },
            "resultKind": {
              "const": "failure-count"
            }
          }
        }
      ]
    },
    "replicaCount": {
      "allOf": [
        {
          "$ref": "#/$defs/panel"
        },
        {
          "properties": {
            "id": {
              "const": "replica-count"
            },
            "resultKind": {
              "const": "container-app-peak-replica-count"
            }
          }
        }
      ]
    },
    "coldStarts": {
      "allOf": [
        {
          "$ref": "#/$defs/panel"
        },
        {
          "properties": {
            "id": {
              "const": "cold-starts"
            },
            "resultKind": {
              "const": "instance-first-request-count"
            }
          }
        }
      ]
    }
  }
}
