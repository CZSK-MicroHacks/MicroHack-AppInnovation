{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CZSK-MicroHacks/MicroHack-AppInnovation/contracts/runtime-test-evidence.schema.json",
  "title": "Runtime failure-state test evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "stack",
    "sourceCommit",
    "status",
    "artifactFormat",
    "artifact",
    "command",
    "tests"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "stack": {
      "enum": [
        "dotnet-sqlserver",
        "java-postgresql"
      ]
    },
    "sourceCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "status": {
      "const": "passed"
    },
    "artifactFormat": {
      "enum": [
        "trx",
        "junit"
      ]
    },
    "artifact": {
      "$ref": "#/$defs/repositoryPath"
    },
    "command": {
      "type": "string",
      "minLength": 1
    },
    "tests": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/test"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "stack": {
            "const": "dotnet-sqlserver"
          }
        },
        "required": [
          "stack"
        ]
      },
      "then": {
        "properties": {
          "artifactFormat": {
            "const": "trx"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "stack": {
            "const": "java-postgresql"
          }
        },
        "required": [
          "stack"
        ]
      },
      "then": {
        "properties": {
          "artifactFormat": {
            "const": "junit"
          }
        }
      }
    }
  ],
  "$defs": {
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "testName"
      ],
      "properties": {
        "id": {
          "enum": [
            "liveness-database-outage",
            "readiness-database-outage",
            "readiness-import-failure",
            "performance-database-failure",
            "performance-timeout",
            "performance-missing-key",
            "performance-invalid-key",
            "work-factor-default",
            "work-factor-bounds",
            "work-factor-invalid",
            "normalization-conformance",
            "text-validation-conformance"
          ]
        },
        "testName": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "id": {
                "const": "liveness-database-outage"
              }
            }
          },
          "then": {
            "properties": {
              "testName": {
                "const": "Contract.Health.LivenessSurvivesDatabaseOutage"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "const": "readiness-database-outage"
              }
            }
          },
          "then": {
            "properties": {
              "testName": {
                "const": "Contract.Health.ReadinessFailsDuringDatabaseOutage"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "const": "readiness-import-failure"
              }
            }
          },
          "then": {
            "properties": {
              "testName": {
                "const": "Contract.Health.ReadinessReportsImportFailure"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "const": "performance-database-failure"
              }
            }
          },
          "then": {
            "properties": {
              "testName": {
                "const": "Contract.Performance.DatabaseFailureIsControlled"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "const": "performance-timeout"
              }
            }
          },
          "then": {
            "properties": {
              "testName": {
                "const": "Contract.Performance.TimeoutIsControlled"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "const": "performance-missing-key"
              }
            }
          },
          "then": {
            "properties": {
              "testName": {
                "const": "Contract.Performance.MissingKeyReturnsUnauthorized"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "const": "performance-invalid-key"
              }
            }
          },
          "then": {
            "properties": {
              "testName": {
                "const": "Contract.Performance.InvalidKeyReturnsUnauthorized"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "const": "work-factor-default"
              }
            }
          },
          "then": {
            "properties": {
              "testName": {
                "const": "Contract.Performance.MissingWorkFactorUsesDefault"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "const": "work-factor-bounds"
              }
            }
          },
          "then": {
            "properties": {
              "testName": {
                "const": "Contract.Performance.BoundsAreAccepted"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "const": "work-factor-invalid"
              }
            }
          },
          "then": {
            "properties": {
              "testName": {
                "const": "Contract.Performance.InvalidWorkFactorsFailStartup"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "const": "normalization-conformance"
              }
            }
          },
          "then": {
            "properties": {
              "testName": {
                "const": "Contract.Conformance.NormalizationVectors"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "const": "text-validation-conformance"
              }
            }
          },
          "then": {
            "properties": {
              "testName": {
                "const": "Contract.Conformance.TextValidationVectors"
              }
            }
          }
        }
      ]
    },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "not": {
        "anyOf": [
          {
            "pattern": "^(?:/|[A-Za-z]:\\\\)"
          },
          {
            "pattern": "(?:^|/)\\.\\.(?:/|$)"
          }
        ]
      }
    }
  }
}
