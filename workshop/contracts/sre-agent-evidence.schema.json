{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://microhack.example/schemas/sre-agent-evidence.schema.json",
  "title": "MicroHack Azure SRE Agent reviewed rollback evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "capturedAt",
    "subject",
    "provenance",
    "dependencies",
    "foundation",
    "incident",
    "cleanup",
    "assertions"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "capturedAt": {
      "$ref": "#/$defs/timestamp"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sliceId",
        "stack",
        "sourceCommit",
        "subscriptionId",
        "participantResourceGroupId",
        "containerAppResourceId",
        "applicationInsightsResourceId",
        "logAnalyticsWorkspaceResourceId",
        "agentResourceGroupId",
        "agentResourceId"
      ],
      "properties": {
        "sliceId": {
          "enum": [
            "manual-dotnet",
            "manual-java",
            "copilot-rewrite-dotnet",
            "copilot-rewrite-java",
            "copilot-modernization-dotnet",
            "copilot-modernization-java"
          ]
        },
        "stack": {
          "enum": [
            "dotnet-sqlserver",
            "java-postgresql"
          ]
        },
        "sourceCommit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "subscriptionId": {
          "$ref": "#/$defs/guid"
        },
        "participantResourceGroupId": {
          "$ref": "#/$defs/resourceId"
        },
        "containerAppResourceId": {
          "$ref": "#/$defs/resourceId"
        },
        "applicationInsightsResourceId": {
          "$ref": "#/$defs/resourceId"
        },
        "logAnalyticsWorkspaceResourceId": {
          "$ref": "#/$defs/resourceId"
        },
        "agentResourceGroupId": {
          "$ref": "#/$defs/resourceId"
        },
        "agentResourceId": {
          "$ref": "#/$defs/resourceId"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "captureManifest",
        "artifacts"
      ],
      "properties": {
        "captureManifest": {
          "$ref": "#/$defs/artifact"
        },
        "artifacts": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": {
            "$ref": "#/$defs/artifact"
          }
        }
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "handoff",
        "targetOutput",
        "cicdEvidence",
        "observabilityEvidence"
      ],
      "properties": {
        "handoff": {
          "$ref": "#/$defs/dependency"
        },
        "targetOutput": {
          "$ref": "#/$defs/dependency"
        },
        "cicdEvidence": {
          "$ref": "#/$defs/dependency"
        },
        "observabilityEvidence": {
          "$ref": "#/$defs/dependency"
        }
      }
    },
    "foundation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agentApiVersion",
        "connectorApiVersion",
        "provisioningState",
        "location",
        "identities",
        "actionConfiguration",
        "connectors",
        "roleAssignments",
        "responsePlan",
        "availability"
      ],
      "properties": {
        "agentApiVersion": {
          "const": "2026-01-01"
        },
        "connectorApiVersion": {
          "const": "2026-01-01"
        },
        "provisioningState": {
          "const": "Succeeded"
        },
        "location": {
          "type": "string",
          "minLength": 1
        },
        "identities": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "userAssignedResourceId",
            "userAssignedPrincipalId",
            "systemAssignedPrincipalId"
          ],
          "properties": {
            "userAssignedResourceId": {
              "$ref": "#/$defs/resourceId"
            },
            "userAssignedPrincipalId": {
              "$ref": "#/$defs/guid"
            },
            "systemAssignedPrincipalId": {
              "$ref": "#/$defs/guid"
            }
          }
        },
        "actionConfiguration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "accessLevel",
            "identity"
          ],
          "properties": {
            "mode": {
              "const": "Review"
            },
            "accessLevel": {
              "const": "Low"
            },
            "identity": {
              "const": "UserAssigned"
            }
          }
        },
        "connectors": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "type",
              "dataSource",
              "identity"
            ],
            "properties": {
              "name": {
                "enum": [
                  "application-insights",
                  "log-analytics"
                ]
              },
              "type": {
                "enum": [
                  "AppInsights",
                  "LogAnalytics"
                ]
              },
              "dataSource": {
                "$ref": "#/$defs/resourceId"
              },
              "identity": {
                "const": "system"
              }
            }
          }
        },
        "roleAssignments": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "userAssignedCount",
            "systemAssignedCount",
            "facilitatorRoleDefinitionId",
            "participantRoleDefinitionId",
            "customRollbackRoleDefinitionId",
            "subscriptionMonitoringContributorException"
          ],
          "properties": {
            "userAssignedCount": {
              "const": 5
            },
            "systemAssignedCount": {
              "const": 3
            },
            "facilitatorRoleDefinitionId": {
              "const": "e79298df-d852-4c6d-84f9-5d13249d1e55"
            },
            "participantRoleDefinitionId": {
              "const": "2d84a65a-63b2-4343-bbb6-31105d857bc1"
            },
            "customRollbackRoleDefinitionId": {
              "$ref": "#/$defs/guid"
            },
            "subscriptionMonitoringContributorException": {
              "const": true
            }
          }
        },
        "responsePlan": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "producer",
            "platform",
            "name",
            "autonomyMode",
            "quickstartPlanEnabled",
            "testIncidentId",
            "participantApprovalAllowed"
          ],
          "properties": {
            "producer": {
              "const": "azure-portal-facilitator-export"
            },
            "platform": {
              "const": "AzureMonitor"
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "autonomyMode": {
              "const": "Review"
            },
            "quickstartPlanEnabled": {
              "const": false
            },
            "testIncidentId": {
              "type": "string",
              "minLength": 1
            },
            "participantApprovalAllowed": {
              "const": false
            }
          }
        },
        "availability": {
          "const": "go"
        }
      }
    },
    "incident": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end",
        "healthyRevision",
        "badRevision",
        "imageDigest",
        "badDatabaseHost",
        "alertId",
        "alertFiredAt",
        "alertResolvedAt",
        "failedRequests",
        "investigation",
        "audit",
        "activity",
        "traffic",
        "health",
        "assessment"
      ],
      "properties": {
        "start": {
          "$ref": "#/$defs/timestamp"
        },
        "end": {
          "$ref": "#/$defs/timestamp"
        },
        "healthyRevision": {
          "type": "string",
          "minLength": 1
        },
        "badRevision": {
          "type": "string",
          "minLength": 1
        },
        "imageDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "badDatabaseHost": {
          "type": "string",
          "pattern": "\\.sre-drill\\.invalid$"
        },
        "alertId": {
          "$ref": "#/$defs/resourceId"
        },
        "alertFiredAt": {
          "$ref": "#/$defs/timestamp"
        },
        "alertResolvedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "failedRequests": {
          "type": "integer",
          "minimum": 1
        },
        "investigation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "windowEnd",
            "evidenceObservedAt",
            "affectedRevision",
            "deploymentCount",
            "evidenceReferences",
            "supportingEvidence",
            "hypothesisCode",
            "alternativesRejected",
            "blastRadius",
            "verificationPlan"
          ],
          "properties": {
            "windowEnd": {
              "$ref": "#/$defs/timestamp"
            },
            "evidenceObservedAt": {
              "$ref": "#/$defs/timestamp"
            },
            "affectedRevision": {
              "type": "string",
              "minLength": 1
            },
            "deploymentCount": {
              "type": "integer",
              "minimum": 2
            },
            "evidenceReferences": {
              "type": "array",
              "minItems": 5,
              "maxItems": 5,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "supportingEvidence": {
              "type": "object"
            },
            "hypothesisCode": {
              "const": "bad-revision-selected-database-endpoint"
            },
            "alternativesRejected": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "blastRadius": {
              "const": "exact-bad-revision-traffic"
            },
            "verificationPlan": {
              "type": "array",
              "minItems": 5,
              "maxItems": 5,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "audit": {
          "type": "object"
        },
        "activity": {
          "type": "object"
        },
        "traffic": {
          "type": "object"
        },
        "health": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object"
          }
        },
        "assessment": {
          "type": "object"
        }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorizedBy",
        "evidenceExportedAt",
        "agentDeletedAt",
        "roleAssignmentsRemovedAt",
        "resourceGroupDeletedAt",
        "costQueriedAt",
        "costDataThrough",
        "protectedResourceCount",
        "completedAt"
      ],
      "properties": {
        "authorizedBy": {
          "type": "string",
          "minLength": 1
        },
        "evidenceExportedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "agentDeletedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "roleAssignmentsRemovedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "resourceGroupDeletedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "costQueriedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "costDataThrough": {
          "$ref": "#/$defs/timestamp"
        },
        "protectedResourceCount": {
          "type": "integer",
          "minimum": 1
        },
        "completedAt": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "assertions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "upstreamEvidenceBound",
        "agentAndConnectorsReady",
        "dualIdentityBound",
        "leastPrivilegeRolesExact",
        "monitoringContributorExceptionExact",
        "reviewModeEnforced",
        "quickstartPlanDisabled",
        "portalPreflightPassed",
        "handoffImageReused",
        "secretReferencesPreserved",
        "badRevisionFailureObserved",
        "investigationComplete",
        "facilitatorApprovedBeforeWrite",
        "participantDidNotApprove",
        "noAutonomousExecution",
        "onlyTrafficRollbackExecuted",
        "healthyRevisionRestored",
        "healthAndReadinessRecovered",
        "alertResolved",
        "auditCorrelationComplete",
        "agentDeleted",
        "crossScopeRolesRemoved",
        "agentResourceGroupDeleted",
        "handoffResourcesProtected",
        "postDeletionCostQueried"
      ],
      "properties": {
        "upstreamEvidenceBound": {
          "const": true
        },
        "agentAndConnectorsReady": {
          "const": true
        },
        "dualIdentityBound": {
          "const": true
        },
        "leastPrivilegeRolesExact": {
          "const": true
        },
        "monitoringContributorExceptionExact": {
          "const": true
        },
        "reviewModeEnforced": {
          "const": true
        },
        "quickstartPlanDisabled": {
          "const": true
        },
        "portalPreflightPassed": {
          "const": true
        },
        "handoffImageReused": {
          "const": true
        },
        "secretReferencesPreserved": {
          "const": true
        },
        "badRevisionFailureObserved": {
          "const": true
        },
        "investigationComplete": {
          "const": true
        },
        "facilitatorApprovedBeforeWrite": {
          "const": true
        },
        "participantDidNotApprove": {
          "const": true
        },
        "noAutonomousExecution": {
          "const": true
        },
        "onlyTrafficRollbackExecuted": {
          "const": true
        },
        "healthyRevisionRestored": {
          "const": true
        },
        "healthAndReadinessRecovered": {
          "const": true
        },
        "alertResolved": {
          "const": true
        },
        "auditCorrelationComplete": {
          "const": true
        },
        "agentDeleted": {
          "const": true
        },
        "crossScopeRolesRemoved": {
          "const": true
        },
        "agentResourceGroupDeleted": {
          "const": true
        },
        "handoffResourcesProtected": {
          "const": true
        },
        "postDeletionCostQueried": {
          "const": true
        }
      }
    }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "guid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "resourceId": {
      "type": "string",
      "pattern": "^/subscriptions/[0-9a-f-]+/"
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "sha256"
      ],
      "properties": {
        "schemaVersion": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path",
        "sha256"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
