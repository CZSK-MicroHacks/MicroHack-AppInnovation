{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CZSK-MicroHacks/MicroHack-AppInnovation/contracts/modernization-contract.schema.json",
  "title": "MicroHack modernization handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sliceId",
    "source",
    "seedManifest",
    "path",
    "application",
    "containerImage",
    "database",
    "images",
    "authentication",
    "observability",
    "acceptance",
    "deployment",
    "rollback",
    "evidence"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.4.0"
    },
    "sliceId": {
      "enum": [
        "manual-dotnet",
        "manual-java",
        "copilot-rewrite-dotnet",
        "copilot-rewrite-java",
        "copilot-modernization-dotnet",
        "copilot-modernization-java"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stack",
        "runtimeVersion",
        "frameworkVersion",
        "commitSha"
      ],
      "properties": {
        "stack": {
          "enum": [
            "dotnet-sqlserver",
            "java-postgresql"
          ]
        },
        "runtimeVersion": {
          "type": "string",
          "minLength": 1
        },
        "frameworkVersion": {
          "type": "string",
          "minLength": 1
        },
        "commitSha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "seedManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "counts",
        "hashes"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "figures",
            "categories",
            "images",
            "imageBytes"
          ],
          "properties": {
            "figures": {
              "type": "integer",
              "minimum": 1
            },
            "categories": {
              "type": "integer",
              "minimum": 1
            },
            "images": {
              "type": "integer",
              "minimum": 1
            },
            "imageBytes": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "hashes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "catalogSha256",
            "categoriesSha256",
            "imageSetSha256"
          ],
          "properties": {
            "catalogSha256": {
              "$ref": "#/$defs/sha256"
            },
            "categoriesSha256": {
              "$ref": "#/$defs/sha256"
            },
            "imageSetSha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        }
      }
    },
    "path": {
      "enum": [
        "manual",
        "copilot-rewrite",
        "copilot-modernization"
      ]
    },
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resourceId",
        "url",
        "healthUrl",
        "readinessUrl",
        "region",
        "resourceGroup",
        "containerAppName",
        "revisionName"
      ],
      "properties": {
        "resourceId": {
          "$ref": "#/$defs/resourceId"
        },
        "url": {
          "$ref": "#/$defs/httpsUrl"
        },
        "healthUrl": {
          "$ref": "#/$defs/httpsUrl"
        },
        "readinessUrl": {
          "$ref": "#/$defs/httpsUrl"
        },
        "region": {
          "const": "swedencentral"
        },
        "resourceGroup": {
          "type": "string",
          "minLength": 1
        },
        "containerAppName": {
          "type": "string",
          "minLength": 1
        },
        "revisionName": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "containerImage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registryResourceId",
        "registry",
        "repository",
        "tag",
        "digest"
      ],
      "properties": {
        "registryResourceId": {
          "$ref": "#/$defs/resourceId"
        },
        "registry": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resourceId",
        "family",
        "server",
        "database",
        "migrationMechanism",
        "migrationVersion",
        "seedManifestVersion",
        "verifiedRowCounts",
        "applicationPrincipal"
      ],
      "properties": {
        "resourceId": {
          "$ref": "#/$defs/resourceId"
        },
        "family": {
          "enum": [
            "azure-sql",
            "postgresql-flexible"
          ]
        },
        "server": {
          "type": "string",
          "minLength": 1
        },
        "database": {
          "type": "string",
          "minLength": 1
        },
        "migrationMechanism": {
          "type": "string",
          "minLength": 1
        },
        "migrationVersion": {
          "type": "string",
          "minLength": 1
        },
        "seedManifestVersion": {
          "const": "1.0.0"
        },
        "verifiedRowCounts": {
          "$ref": "#/$defs/corpusCounts"
        },
        "applicationPrincipal": {
          "$ref": "#/$defs/applicationPrincipal"
        }
      }
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resourceId",
        "provider",
        "location",
        "verification"
      ],
      "properties": {
        "resourceId": {
          "$ref": "#/$defs/resourceId"
        },
        "provider": {
          "enum": [
            "azure-files",
            "azure-blob"
          ]
        },
        "location": {
          "type": "string",
          "minLength": 1
        },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "verified",
            "imageCount",
            "imageBytes",
            "imageSetSha256",
            "seedManifestVersion"
          ],
          "properties": {
            "verified": {
              "const": true
            },
            "imageCount": {
              "type": "integer",
              "minimum": 1
            },
            "imageBytes": {
              "type": "integer",
              "minimum": 1
            },
            "imageSetSha256": {
              "$ref": "#/$defs/sha256"
            },
            "seedManifestVersion": {
              "const": "1.0.0"
            }
          }
        }
      }
    },
    "authentication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "containerRegistry",
        "database",
        "imageStore",
        "telemetry"
      ],
      "properties": {
        "containerRegistry": {
          "const": "managed-identity"
        },
        "database": {
          "enum": [
            "password-secret",
            "managed-identity"
          ]
        },
        "imageStore": {
          "enum": [
            "managed-identity",
            "aca-volume-secret"
          ]
        },
        "telemetry": {
          "enum": [
            "connection-string-secret",
            "managed-identity"
          ]
        }
      }
    },
    "observability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "serviceName",
        "serviceNamespace",
        "environment",
        "serviceVersion",
        "serviceInstanceId",
        "revision",
        "applicationInsightsResourceId",
        "logAnalyticsWorkspaceResourceId"
      ],
      "properties": {
        "serviceName": {
          "enum": [
            "mh-catalog-dotnet",
            "mh-catalog-java"
          ]
        },
        "serviceNamespace": {
          "const": "app-innovation"
        },
        "environment": {
          "const": "lab"
        },
        "serviceVersion": {
          "type": "string",
          "minLength": 1
        },
        "serviceInstanceId": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "applicationInsightsResourceId": {
          "$ref": "#/$defs/resourceId"
        },
        "logAnalyticsWorkspaceResourceId": {
          "$ref": "#/$defs/resourceId"
        }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "report",
        "profile",
        "result"
      ],
      "properties": {
        "report": {
          "$ref": "#/$defs/repositoryPath"
        },
        "profile": {
          "const": "full"
        },
        "result": {
          "const": "passed"
        }
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mechanism",
        "iacPath",
        "targetOutput"
      ],
      "properties": {
        "mechanism": {
          "const": "bicep"
        },
        "iacPath": {
          "const": "infra"
        },
        "targetOutput": {
          "$ref": "#/$defs/repositoryPath"
        }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetRevision",
        "runbook"
      ],
      "properties": {
        "targetRevision": {
          "type": "string",
          "minLength": 1
        },
        "runbook": {
          "$ref": "#/$defs/repositoryPath"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "migrationReport",
        "telemetryReport",
        "runtimeTestReport",
        "pathEvidence"
      ],
      "properties": {
        "migrationReport": {
          "$ref": "#/$defs/repositoryPath"
        },
        "telemetryReport": {
          "$ref": "#/$defs/repositoryPath"
        },
        "runtimeTestReport": {
          "$ref": "#/$defs/repositoryPath"
        },
        "pathEvidence": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/repositoryPath"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "oneOf": [
        {
          "properties": {
            "sliceId": {
              "const": "manual-dotnet"
            },
            "path": {
              "const": "manual"
            },
            "source": {
              "properties": {
                "stack": {
                  "const": "dotnet-sqlserver"
                }
              }
            }
          }
        },
        {
          "properties": {
            "sliceId": {
              "const": "manual-java"
            },
            "path": {
              "const": "manual"
            },
            "source": {
              "properties": {
                "stack": {
                  "const": "java-postgresql"
                }
              }
            }
          }
        },
        {
          "properties": {
            "sliceId": {
              "const": "copilot-rewrite-dotnet"
            },
            "path": {
              "const": "copilot-rewrite"
            },
            "source": {
              "properties": {
                "stack": {
                  "const": "dotnet-sqlserver"
                }
              }
            }
          }
        },
        {
          "properties": {
            "sliceId": {
              "const": "copilot-rewrite-java"
            },
            "path": {
              "const": "copilot-rewrite"
            },
            "source": {
              "properties": {
                "stack": {
                  "const": "java-postgresql"
                }
              }
            }
          }
        },
        {
          "properties": {
            "sliceId": {
              "const": "copilot-modernization-dotnet"
            },
            "path": {
              "const": "copilot-modernization"
            },
            "source": {
              "properties": {
                "stack": {
                  "const": "dotnet-sqlserver"
                }
              }
            }
          }
        },
        {
          "properties": {
            "sliceId": {
              "const": "copilot-modernization-java"
            },
            "path": {
              "const": "copilot-modernization"
            },
            "source": {
              "properties": {
                "stack": {
                  "const": "java-postgresql"
                }
              }
            }
          }
        }
      ]
    },
    {
      "if": {
        "properties": {
          "path": {
            "const": "manual"
          }
        },
        "required": [
          "path"
        ]
      },
      "then": {
        "properties": {
          "images": {
            "properties": {
              "provider": {
                "const": "azure-files"
              }
            }
          },
          "evidence": {
            "properties": {
              "pathEvidence": {
                "prefixItems": [
                  {
                    "const": "evidence/baseline-backup.md"
                  },
                  {
                    "const": "evidence/managed-database-separation.json"
                  },
                  {
                    "const": "evidence/container-build.json"
                  },
                  {
                    "const": "evidence/iac-review.md"
                  }
                ],
                "items": false
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "images": {
            "properties": {
              "provider": {
                "const": "azure-blob"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "path": {
            "const": "copilot-rewrite"
          }
        },
        "required": [
          "path"
        ]
      },
      "then": {
        "properties": {
          "evidence": {
            "properties": {
              "pathEvidence": {
                "prefixItems": [
                  {
                    "const": "evidence/characterization.md"
                  },
                  {
                    "const": "evidence/bounded-plan.md"
                  },
                  {
                    "const": "evidence/review-checklist.md"
                  },
                  {
                    "const": "evidence/decision-log.md"
                  }
                ],
                "items": false
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "path": {
            "const": "copilot-modernization"
          }
        },
        "required": [
          "path"
        ]
      },
      "then": {
        "properties": {
          "evidence": {
            "properties": {
              "pathEvidence": {
                "prefixItems": [
                  {
                    "const": "evidence/assessment.md"
                  },
                  {
                    "const": "evidence/modernization-plan.md"
                  },
                  {
                    "const": "evidence/task-results.json"
                  },
                  {
                    "const": "evidence/build-test-cve-summary.md"
                  }
                ],
                "items": false
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source": {
            "properties": {
              "stack": {
                "const": "dotnet-sqlserver"
              }
            },
            "required": [
              "stack"
            ]
          }
        },
        "required": [
          "source"
        ]
      },
      "then": {
        "properties": {
          "database": {
            "properties": {
              "family": {
                "const": "azure-sql"
              },
              "migrationMechanism": {
                "const": "sqlpackage-bacpac"
              },
              "migrationVersion": {
                "const": "170.4.83"
              }
            }
          },
          "authentication": {
            "properties": {
              "database": {
                "const": "managed-identity"
              }
            }
          },
          "observability": {
            "properties": {
              "serviceName": {
                "const": "mh-catalog-dotnet"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source": {
            "properties": {
              "stack": {
                "const": "java-postgresql"
              }
            },
            "required": [
              "stack"
            ]
          }
        },
        "required": [
          "source"
        ]
      },
      "then": {
        "properties": {
          "database": {
            "properties": {
              "family": {
                "const": "postgresql-flexible"
              },
              "migrationMechanism": {
                "const": "pg-dump-restore"
              },
              "migrationVersion": {
                "const": "18.6"
              }
            }
          },
          "observability": {
            "properties": {
              "serviceName": {
                "const": "mh-catalog-java"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "authentication": {
            "properties": {
              "database": {
                "const": "password-secret"
              }
            },
            "required": [
              "database"
            ]
          }
        },
        "required": [
          "authentication"
        ]
      },
      "then": {
        "properties": {
          "database": {
            "properties": {
              "applicationPrincipal": {
                "properties": {
                  "kind": {
                    "const": "database-role"
                  },
                  "principalId": {
                    "type": "null"
                  }
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "database": {
            "properties": {
              "applicationPrincipal": {
                "properties": {
                  "kind": {
                    "const": "managed-identity"
                  },
                  "principalId": {
                    "$ref": "#/$defs/guid"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "images": {
            "properties": {
              "provider": {
                "const": "azure-blob"
              }
            },
            "required": [
              "provider"
            ]
          }
        },
        "required": [
          "images"
        ]
      },
      "then": {
        "properties": {
          "authentication": {
            "properties": {
              "imageStore": {
                "const": "managed-identity"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "images": {
            "properties": {
              "provider": {
                "const": "azure-files"
              }
            },
            "required": [
              "provider"
            ]
          }
        },
        "required": [
          "images"
        ]
      },
      "then": {
        "properties": {
          "authentication": {
            "properties": {
              "imageStore": {
                "const": "aca-volume-secret"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "applicationPrincipal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kind",
        "principalId"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "database-role",
            "managed-identity"
          ]
        },
        "principalId": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/guid"
            }
          ]
        }
      }
    },
    "guid": {
      "type": "string",
      "format": "uuid"
    },
    "httpsUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "resourceId": {
      "type": "string",
      "pattern": "^/subscriptions/[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}/resourceGroups/[^/]+/providers/[^/]+(?:/[^/]+/[^/]+)+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "not": {
        "anyOf": [
          {
            "pattern": "^(?:/|[A-Za-z]:\\\\)"
          },
          {
            "pattern": "(?:^|/)\\.\\.(?:/|$)"
          }
        ]
      }
    },
    "corpusCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "figures",
        "categories"
      ],
      "properties": {
        "figures": {
          "type": "integer",
          "minimum": 1
        },
        "categories": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
