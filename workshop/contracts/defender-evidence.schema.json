{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CZSK-MicroHacks/MicroHack-AppInnovation/contracts/defender-evidence.schema.json",
  "title": "Challenge 5 Defender for Cloud evidence report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "capturedAt",
    "subject",
    "capture",
    "foundation",
    "controls",
    "imageAssessment",
    "securityContext",
    "postureComparison",
    "health",
    "cleanup",
    "assertions",
    "result"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.1.0"
    },
    "capturedAt": {
      "$ref": "#/$defs/timestamp"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sliceId",
        "sourceCommit",
        "containerAppResourceId",
        "revisionName",
        "containerRegistryResourceId",
        "databaseResourceId",
        "legacyVmResourceId",
        "imageDigest"
      ],
      "properties": {
        "sliceId": {
          "type": "string",
          "minLength": 1
        },
        "sourceCommit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "containerAppResourceId": {
          "$ref": "#/$defs/resourceId"
        },
        "revisionName": {
          "type": "string",
          "minLength": 1
        },
        "containerRegistryResourceId": {
          "$ref": "#/$defs/resourceId"
        },
        "databaseResourceId": {
          "$ref": "#/$defs/resourceId"
        },
        "legacyVmResourceId": {
          "$ref": "#/$defs/resourceId"
        },
        "imageDigest": {
          "$ref": "#/$defs/imageDigest"
        }
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifestFile",
        "manifestSha256"
      ],
      "properties": {
        "manifestFile": {
          "type": "string",
          "minLength": 1
        },
        "manifestSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "foundation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subscriptionId",
        "dedicatedWorkshopSubscription",
        "facilitatorChangeApproval",
        "requiredPricings",
        "budget",
        "legacyVmCoverage",
        "seedSnapshot",
        "serverlessContainers"
      ],
      "properties": {
        "subscriptionId": {
          "$ref": "#/$defs/subscriptionId"
        },
        "dedicatedWorkshopSubscription": {
          "const": true
        },
        "facilitatorChangeApproval": {
          "type": "string",
          "minLength": 8
        },
        "requiredPricings": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/pricing"
          }
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "resourceId",
            "name",
            "amount",
            "category",
            "timeGrain",
            "queriedAt",
            "notificationThresholds"
          ],
          "properties": {
            "resourceId": {
              "type": "string",
              "pattern": "^/subscriptions/[0-9a-fA-F-]{36}/providers/Microsoft\\.Consumption/budgets/[^/]+$"
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "amount": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "category": {
              "const": "Cost"
            },
            "timeGrain": {
              "const": "Monthly"
            },
            "queriedAt": {
              "$ref": "#/$defs/timestamp"
            },
            "notificationThresholds": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 80
              }
            }
          }
        },
        "legacyVmCoverage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "subscriptionPricingEnforced",
            "pricingName",
            "pricingSubPlan",
            "observedAt",
            "virtualMachines"
          ],
          "properties": {
            "subscriptionPricingEnforced": {
              "const": true
            },
            "pricingName": {
              "const": "VirtualMachines"
            },
            "pricingSubPlan": {
              "const": "P2"
            },
            "observedAt": {
              "$ref": "#/$defs/timestamp"
            },
            "virtualMachines": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "workload",
                  "resourceId",
                  "location",
                  "provisioningState"
                ],
                "properties": {
                  "workload": {
                    "enum": [
                      "dotnet",
                      "java"
                    ]
                  },
                  "resourceId": {
                    "$ref": "#/$defs/resourceId"
                  },
                  "location": {
                    "type": "string",
                    "minLength": 1
                  },
                  "provisioningState": {
                    "const": "Succeeded"
                  }
                }
              }
            }
          }
        },
        "seedSnapshot": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "capturedAt",
            "requiredSignals",
            "recommendationRecordCount",
            "unhealthyRecommendationCount",
            "recommendationResourceCoverage",
            "secureScoreRecordCount",
            "mcsbRecordCount",
            "imageAssessmentRecordCount"
          ],
          "properties": {
            "capturedAt": {
              "$ref": "#/$defs/timestamp"
            },
            "requiredSignals": {
              "const": [
                "image-vulnerability-assessment",
                "recommendations",
                "secure-score",
                "mcsb-controls"
              ]
            },
            "recommendationRecordCount": {
              "type": "integer",
              "minimum": 5
            },
            "unhealthyRecommendationCount": {
              "type": "integer",
              "minimum": 1
            },
            "recommendationResourceCoverage": {
              "const": [
                "dotnet-vm",
                "java-vm",
                "container-app",
                "container-registry",
                "database"
              ]
            },
            "secureScoreRecordCount": {
              "type": "integer",
              "minimum": 1
            },
            "mcsbRecordCount": {
              "type": "integer",
              "minimum": 1
            },
            "imageAssessmentRecordCount": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "serverlessContainers": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "observedAt",
            "operatorRole",
            "source"
          ],
          "properties": {
            "enabled": {
              "const": true
            },
            "observedAt": {
              "$ref": "#/$defs/timestamp"
            },
            "operatorRole": {
              "const": "Owner"
            },
            "source": {
              "const": "azure-portal-owner-preflight"
            }
          }
        }
      }
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "containerRegistry",
        "containerApp",
        "database",
        "legacyVm"
      ],
      "properties": {
        "containerRegistry": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "resourceId",
            "disposition",
            "beforeAdminUserEnabled",
            "afterAdminUserEnabled",
            "managedIdentityResourceId",
            "principalId",
            "roleAssignmentId",
            "roleDefinitionId",
            "imageReference"
          ],
          "properties": {
            "resourceId": {
              "$ref": "#/$defs/resourceId"
            },
            "disposition": {
              "enum": [
                "remediated",
                "already-compliant"
              ]
            },
            "beforeAdminUserEnabled": {
              "type": "boolean"
            },
            "afterAdminUserEnabled": {
              "const": false
            },
            "managedIdentityResourceId": {
              "$ref": "#/$defs/resourceId"
            },
            "principalId": {
              "type": "string",
              "pattern": "^[0-9a-fA-F-]{36}$"
            },
            "roleAssignmentId": {
              "$ref": "#/$defs/resourceId"
            },
            "roleDefinitionId": {
              "type": "string",
              "pattern": "^/subscriptions/[0-9a-fA-F-]{36}/providers/Microsoft\\.Authorization/roleDefinitions/7f951dda-4ed3-4680-a7ca-43fe172d538d$"
            },
            "imageReference": {
              "type": "string",
              "pattern": "@sha256:[0-9a-f]{64}$"
            }
          }
        },
        "containerApp": {
          "$ref": "#/$defs/decisionResult"
        },
        "database": {
          "$ref": "#/$defs/decisionResult"
        },
        "legacyVm": {
          "$ref": "#/$defs/decisionResult"
        }
      }
    },
    "imageAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digest",
        "status",
        "queriedAt",
        "findingCount",
        "asynchronous"
      ],
      "properties": {
        "digest": {
          "$ref": "#/$defs/imageDigest"
        },
        "status": {
          "enum": [
            "completed",
            "pending",
            "unavailable"
          ]
        },
        "queriedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "findingCount": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "asynchronous": {
          "const": true
        }
      }
    },
    "securityContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recommendationsQueried",
        "recommendationCount",
        "secureScoreQueried",
        "secureScoreRecordCount",
        "mcsbQueried",
        "mcsbRecordCount",
        "attackPathsQueried",
        "attackPathCount",
        "nonEmptyFindingsRequired"
      ],
      "properties": {
        "recommendationsQueried": {
          "const": true
        },
        "recommendationCount": {
          "type": "integer",
          "minimum": 0
        },
        "secureScoreQueried": {
          "const": true
        },
        "secureScoreRecordCount": {
          "type": "integer",
          "minimum": 0
        },
        "mcsbQueried": {
          "const": true
        },
        "mcsbRecordCount": {
          "type": "integer",
          "minimum": 0
        },
        "attackPathsQueried": {
          "const": true
        },
        "attackPathCount": {
          "type": "integer",
          "minimum": 0
        },
        "nonEmptyFindingsRequired": {
          "const": false
        }
      }
    },
    "postureComparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "legacyVm",
        "containerApp"
      ],
      "properties": {
        "legacyVm": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "resourceId",
            "operatingSystemPatching",
            "hostManagementSurface"
          ],
          "properties": {
            "resourceId": {
              "$ref": "#/$defs/resourceId"
            },
            "operatingSystemPatching": {
              "const": "customer-managed"
            },
            "hostManagementSurface": {
              "const": "present"
            }
          }
        },
        "containerApp": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "resourceId",
            "operatingSystemPatching",
            "hostManagementSurface",
            "runtimeProtectionClaim"
          ],
          "properties": {
            "resourceId": {
              "$ref": "#/$defs/resourceId"
            },
            "operatingSystemPatching": {
              "const": "platform-managed"
            },
            "hostManagementSurface": {
              "const": "absent"
            },
            "runtimeProtectionClaim": {
              "const": "not-claimed-for-azure-container-apps"
            }
          }
        }
      }
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observedAt",
        "revisionName",
        "healthUrl",
        "healthStatus",
        "readinessUrl",
        "readinessStatus"
      ],
      "properties": {
        "observedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "revisionName": {
          "type": "string",
          "minLength": 1
        },
        "healthUrl": {
          "$ref": "#/$defs/httpsUrl"
        },
        "healthStatus": {
          "const": 200
        },
        "readinessUrl": {
          "$ref": "#/$defs/httpsUrl"
        },
        "readinessStatus": {
          "const": 200
        }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifestFile",
        "manifestSha256",
        "status",
        "facilitatorApprovalRequired",
        "costVerificationStatus",
        "agentCleanupStatus",
        "priorCleanupInventoryCount",
        "postCleanupInventoryCount"
      ],
      "properties": {
        "manifestFile": {
          "type": "string",
          "minLength": 1
        },
        "manifestSha256": {
          "$ref": "#/$defs/sha256"
        },
        "status": {
          "enum": [
            "scheduled",
            "completed"
          ]
        },
        "facilitatorApprovalRequired": {
          "const": true
        },
        "costVerificationStatus": {
          "enum": [
            "scheduled",
            "queried"
          ]
        },
        "agentCleanupStatus": {
          "enum": [
            "scheduled",
            "restored"
          ]
        },
        "priorCleanupInventoryCount": {
          "type": "integer",
          "minimum": 0
        },
        "postCleanupInventoryCount": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "scheduled"
              }
            }
          },
          "then": {
            "properties": {
              "costVerificationStatus": {
                "const": "scheduled"
              },
              "agentCleanupStatus": {
                "const": "scheduled"
              },
              "postCleanupInventoryCount": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "costVerificationStatus": {
                "const": "queried"
              },
              "agentCleanupStatus": {
                "const": "restored"
              },
              "postCleanupInventoryCount": {
                "type": "integer"
              }
            }
          }
        }
      ]
    },
    "assertions": {
      "type": "array",
      "minItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "result": {
      "const": "passed"
    }
  },
  "$defs": {
    "pricing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "pricingTier",
        "extensions"
      ],
      "properties": {
        "name": {
          "enum": [
            "CloudPosture",
            "Containers",
            "SqlServers",
            "OpenSourceRelationalDatabases",
            "VirtualMachines"
          ]
        },
        "pricingTier": {
          "const": "Standard"
        },
        "subPlan": {
          "const": "P2"
        },
        "enforce": {
          "const": "True"
        },
        "extensions": {
          "type": "array",
          "maxItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "isEnabled"
            ],
            "properties": {
              "name": {
                "const": "ContainerRegistriesVulnerabilityAssessments"
              },
              "isEnabled": {
                "const": "True"
              }
            }
          }
        }
      }
    },
    "decisionResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resourceId",
        "disposition",
        "beforeState",
        "afterState",
        "justification",
        "compensatingControls"
      ],
      "properties": {
        "resourceId": {
          "$ref": "#/$defs/resourceId"
        },
        "disposition": {
          "enum": [
            "remediated",
            "already-compliant",
            "justified",
            "documented-exception"
          ]
        },
        "beforeState": {
          "type": "string",
          "minLength": 1
        },
        "afterState": {
          "type": "string",
          "minLength": 1
        },
        "justification": {
          "type": [
            "string",
            "null"
          ]
        },
        "compensatingControls": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "resourceId": {
      "type": "string",
      "pattern": "^/subscriptions/[0-9a-fA-F-]{36}/resourceGroups/[^/]+/providers/.+$"
    },
    "subscriptionId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F-]{36}$"
    },
    "imageDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "httpsUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    }
  }
}
