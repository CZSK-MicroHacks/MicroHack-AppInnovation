{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CZSK-MicroHacks/MicroHack-AppInnovation/contracts/toolchain-lock.schema.json",
  "title": "MicroHack toolchain lock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "verifiedOn",
    "hosts",
    "runtimes",
    "databases",
    "tools",
    "azureSdk",
    "applicationContainers",
    "extensions",
    "provisioning"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.2.0"
    },
    "verifiedOn": {
      "type": "string",
      "format": "date"
    },
    "hosts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coordinator",
        "workshopVm"
      ],
      "properties": {
        "coordinator": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operatingSystem",
            "minimumVersion",
            "architectures",
            "dockerDesktopVersion",
            "dockerEngineVersion"
          ],
          "properties": {
            "operatingSystem": {
              "const": "macOS"
            },
            "minimumVersion": {
              "$ref": "#/$defs/versionString"
            },
            "architectures": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "arm64",
                  "x86_64"
                ]
              }
            },
            "dockerDesktopVersion": {
              "$ref": "#/$defs/versionString"
            },
            "dockerEngineVersion": {
              "$ref": "#/$defs/versionString"
            }
          }
        },
        "workshopVm": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operatingSystem",
            "architecture",
            "azureImage"
          ],
          "properties": {
            "operatingSystem": {
              "const": "Windows Server 2025 Datacenter Azure Edition"
            },
            "architecture": {
              "const": "x64"
            },
            "azureImage": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "publisher",
                "offer",
                "sku",
                "version"
              ],
              "properties": {
                "publisher": {
                  "const": "MicrosoftWindowsServer"
                },
                "offer": {
                  "const": "WindowsServer"
                },
                "sku": {
                  "const": "2025-datacenter-azure-edition"
                },
                "version": {
                  "type": "string",
                  "minLength": 1,
                  "not": {
                    "const": "latest"
                  }
                }
              }
            }
          }
        }
      }
    },
    "runtimes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dotnet",
        "java",
        "python"
      ],
      "properties": {
        "dotnet": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sourceRuntime",
            "sourceSdk",
            "targetRuntime",
            "targetSdk",
            "windowsSourceSdkInstaller"
          ],
          "properties": {
            "sourceRuntime": {
              "$ref": "#/$defs/versionString"
            },
            "sourceSdk": {
              "$ref": "#/$defs/versionString"
            },
            "targetRuntime": {
              "$ref": "#/$defs/versionString"
            },
            "targetSdk": {
              "$ref": "#/$defs/versionString"
            },
            "windowsSourceSdkInstaller": {
              "$ref": "#/$defs/windowsInstaller"
            }
          }
        },
        "java": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "distribution",
            "sourceRuntime",
            "sourceSpringBoot",
            "targetRuntime",
            "targetSpringBoot",
            "windowsSourceRuntimeInstaller"
          ],
          "properties": {
            "distribution": {
              "const": "Microsoft OpenJDK"
            },
            "sourceRuntime": {
              "type": "string",
              "minLength": 1
            },
            "sourceSpringBoot": {
              "$ref": "#/$defs/versionString"
            },
            "targetRuntime": {
              "$ref": "#/$defs/versionString"
            },
            "targetSpringBoot": {
              "$ref": "#/$defs/versionString"
            },
            "windowsSourceRuntimeInstaller": {
              "$ref": "#/$defs/windowsInstaller"
            }
          }
        },
        "python": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "runtime",
            "supportedRange",
            "provisioner"
          ],
          "properties": {
            "runtime": {
              "$ref": "#/$defs/versionString"
            },
            "supportedRange": {
              "const": ">=3.12,<3.14"
            },
            "provisioner": {
              "const": "uv-managed-python"
            }
          }
        }
      }
    },
    "databases": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sqlserver",
        "postgresql"
      ],
      "properties": {
        "sqlserver": {
          "$ref": "#/$defs/sqlserverDatabase"
        },
        "postgresql": {
          "$ref": "#/$defs/postgresqlDatabase"
        }
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maven",
        "mavenWrapper",
        "vscode",
        "azureCli",
        "bicep",
        "sqlPackage",
        "terraform",
        "uv"
      ],
      "properties": {
        "maven": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "url",
            "sha512"
          ],
          "properties": {
            "version": {
              "$ref": "#/$defs/versionString"
            },
            "url": {
              "$ref": "#/$defs/httpsUrl"
            },
            "sha512": {
              "type": "string",
              "pattern": "^[0-9a-f]{128}$"
            }
          }
        },
        "mavenWrapper": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "distributionSha256Required"
          ],
          "properties": {
            "version": {
              "$ref": "#/$defs/versionString"
            },
            "distributionSha256Required": {
              "const": true
            }
          }
        },
        "vscode": {
          "$ref": "#/$defs/windowsInstaller"
        },
        "azureCli": {
          "$ref": "#/$defs/windowsInstaller"
        },
        "bicep": {
          "$ref": "#/$defs/versionObject"
        },
        "sqlPackage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "package",
            "version",
            "url",
            "sha512",
            "windowsStandalone",
            "integrity"
          ],
          "properties": {
            "package": {
              "const": "Microsoft.SqlPackage"
            },
            "version": {
              "$ref": "#/$defs/versionString"
            },
            "url": {
              "$ref": "#/$defs/httpsUrl"
            },
            "sha512": {
              "$ref": "#/$defs/base64Sha512"
            },
            "windowsStandalone": {
              "$ref": "#/$defs/windowsInstaller"
            },
            "integrity": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "terraform": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "platforms",
            "integrity"
          ],
          "properties": {
            "version": {
              "$ref": "#/$defs/versionString"
            },
            "platforms": {
              "type": "array",
              "minItems": 2,
              "items": {
                "$ref": "#/$defs/platformDownload"
              }
            },
            "integrity": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "uv": {
          "$ref": "#/$defs/windowsInstaller"
        }
      }
    },
    "azureSdk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dotnet",
        "java"
      ],
      "properties": {
        "dotnet": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "azureIdentity",
            "azureStorageBlobs",
            "azureMonitorOpenTelemetryExporter"
          ],
          "properties": {
            "azureIdentity": {
              "$ref": "#/$defs/nugetPackage"
            },
            "azureStorageBlobs": {
              "$ref": "#/$defs/nugetPackage"
            },
            "azureMonitorOpenTelemetryExporter": {
              "$ref": "#/$defs/nugetPackage"
            }
          }
        },
        "java": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "azureIdentity",
            "azureStorageBlob",
            "azureIdentityExtensions",
            "azureMonitorOpenTelemetryAutoconfigure",
            "openTelemetryApi",
            "openTelemetryLogbackAppender"
          ],
          "properties": {
            "azureIdentity": {
              "$ref": "#/$defs/mavenPackage"
            },
            "azureStorageBlob": {
              "$ref": "#/$defs/mavenPackage"
            },
            "azureIdentityExtensions": {
              "$ref": "#/$defs/mavenPackage"
            },
            "azureMonitorOpenTelemetryAutoconfigure": {
              "$ref": "#/$defs/mavenPackage"
            },
            "openTelemetryApi": {
              "$ref": "#/$defs/mavenPackage"
            },
            "openTelemetryLogbackAppender": {
              "$ref": "#/$defs/mavenPackage"
            }
          }
        }
      }
    },
    "applicationContainers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dotnetBuild",
        "dotnetRuntime",
        "javaBuildRuntime"
      ],
      "properties": {
        "dotnetBuild": {
          "allOf": [
            {
              "$ref": "#/$defs/applicationContainer"
            },
            {
              "properties": {
                "image": {
                  "const": "mcr.microsoft.com/dotnet/sdk:10.0.400-azurelinux3.0-amd64"
                },
                "digest": {
                  "const": "sha256:679e7b7e9d0315ad34438bee49b4fb0658c4c42a3aa08ae8557d1bd03f49c28b"
                },
                "runtimeVersion": {
                  "const": "10.0.11"
                }
              }
            }
          ]
        },
        "dotnetRuntime": {
          "allOf": [
            {
              "$ref": "#/$defs/applicationContainer"
            },
            {
              "properties": {
                "image": {
                  "const": "mcr.microsoft.com/dotnet/aspnet:10.0.11-azurelinux3.0-amd64"
                },
                "digest": {
                  "const": "sha256:d21a49ce9556f5e50afc5a33cc45ec7a40b5739f10397368810193666e559a79"
                },
                "runtimeVersion": {
                  "const": "10.0.11"
                }
              }
            }
          ]
        },
        "javaBuildRuntime": {
          "allOf": [
            {
              "$ref": "#/$defs/applicationContainer"
            },
            {
              "properties": {
                "image": {
                  "const": "mcr.microsoft.com/openjdk/jdk:21-azurelinux"
                },
                "digest": {
                  "const": "sha256:06ec8d4b09883cb695aa37e3ae85d1188f124b6dbcfeff97eeb09a926f7c389f"
                },
                "runtimeVersion": {
                  "const": "21.0.12+8"
                }
              }
            }
          ]
        }
      }
    },
    "extensions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/extension"
      }
    },
    "provisioning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "azureConfigDirectory",
        "sourceArchiveTemplate",
        "mutableRefsForbidden",
        "downloadVerification",
        "secrets"
      ],
      "properties": {
        "azureConfigDirectory": {
          "const": "$HOME/.azure-365"
        },
        "sourceArchiveTemplate": {
          "type": "string",
          "pattern": "\\{commitSha\\}"
        },
        "mutableRefsForbidden": {
          "const": true
        },
        "downloadVerification": {
          "type": "string",
          "minLength": 1
        },
        "secrets": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "applicationContainer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image",
        "digest",
        "platform",
        "runtimeVersion"
      ],
      "properties": {
        "image": {
          "type": "string",
          "pattern": "^[^:]+(?:/[^:]+)*:[^:]+$"
        },
        "digest": {
          "$ref": "#/$defs/imageDigest"
        },
        "platform": {
          "const": "linux/amd64"
        },
        "runtimeVersion": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "base64Sha512": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]{86}==$"
    },
    "versionString": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+){1,3}$"
    },
    "versionObject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version"
      ],
      "properties": {
        "version": {
          "$ref": "#/$defs/versionString"
        }
      }
    },
    "httpsUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "mavenPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coordinate",
        "version",
        "source",
        "sha256",
        "signature",
        "integrity"
      ],
      "properties": {
        "coordinate": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.-]+:[a-zA-Z0-9_.-]+$"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "$ref": "#/$defs/httpsUrl"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "signature": {
          "$ref": "#/$defs/httpsUrl"
        },
        "integrity": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "nugetPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package",
        "version",
        "source",
        "sha512",
        "integrity"
      ],
      "properties": {
        "package": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "$ref": "#/$defs/versionString"
        },
        "source": {
          "$ref": "#/$defs/httpsUrl"
        },
        "sha512": {
          "$ref": "#/$defs/base64Sha512"
        },
        "integrity": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "windowsInstaller": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "architecture",
        "url",
        "sha256",
        "signaturePublisher"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "architecture": {
          "const": "x64"
        },
        "url": {
          "$ref": "#/$defs/httpsUrl"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "signaturePublisher": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "container": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image",
        "indexDigest",
        "platforms"
      ],
      "properties": {
        "image": {
          "type": "string",
          "pattern": "^[^:]+(?:/[^:]+)*:[^:]+$"
        },
        "indexDigest": {
          "$ref": "#/$defs/imageDigest"
        },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "platform",
              "digest"
            ],
            "properties": {
              "platform": {
                "type": "string",
                "pattern": "^linux/(?:amd64|arm64)$"
              },
              "digest": {
                "$ref": "#/$defs/imageDigest"
              }
            }
          }
        }
      }
    },
    "windowsService": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edition",
        "mediaVersion",
        "installer"
      ],
      "properties": {
        "edition": {
          "type": "string",
          "minLength": 1
        },
        "mediaVersion": {
          "type": "string",
          "minLength": 1
        },
        "installer": {
          "$ref": "#/$defs/windowsInstaller"
        }
      }
    },
    "sqlserverDatabase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceMajorVersion",
        "windowsService",
        "client",
        "localContainer",
        "targetService"
      ],
      "properties": {
        "sourceMajorVersion": {
          "const": "2022"
        },
        "windowsService": {
          "$ref": "#/$defs/windowsService"
        },
        "client": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "product",
            "installer"
          ],
          "properties": {
            "product": {
              "const": "go-sqlcmd"
            },
            "installer": {
              "$ref": "#/$defs/windowsInstaller"
            }
          }
        },
        "localContainer": {
          "$ref": "#/$defs/container"
        },
        "targetService": {
          "const": "Azure SQL Database"
        }
      }
    },
    "postgresqlDatabase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceMajorVersion",
        "windowsService",
        "client",
        "migrationTools",
        "localContainer",
        "targetService"
      ],
      "properties": {
        "sourceMajorVersion": {
          "const": "18"
        },
        "windowsService": {
          "$ref": "#/$defs/windowsService"
        },
        "client": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "product",
            "version",
            "source"
          ],
          "properties": {
            "product": {
              "const": "psql"
            },
            "version": {
              "$ref": "#/$defs/versionString"
            },
            "source": {
              "const": "bundled-with-postgresql-installer"
            }
          }
        },
        "migrationTools": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "exportTool",
            "importTool",
            "version",
            "source"
          ],
          "properties": {
            "exportTool": {
              "const": "pg_dump"
            },
            "importTool": {
              "const": "pg_restore"
            },
            "version": {
              "$ref": "#/$defs/versionString"
            },
            "source": {
              "const": "bundled-with-postgresql-installer"
            }
          }
        },
        "localContainer": {
          "$ref": "#/$defs/container"
        },
        "targetService": {
          "const": "Azure Database for PostgreSQL Flexible Server 18"
        }
      }
    },
    "platformDownload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "url",
        "sha256"
      ],
      "properties": {
        "platform": {
          "enum": [
            "darwin/arm64",
            "darwin/amd64"
          ]
        },
        "url": {
          "$ref": "#/$defs/httpsUrl"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "extension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "source",
        "integrity"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "integrity": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "imageDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
