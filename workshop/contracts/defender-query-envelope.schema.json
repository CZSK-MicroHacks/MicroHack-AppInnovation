{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CZSK-MicroHacks/MicroHack-AppInnovation/contracts/defender-query-envelope.schema.json",
  "title": "Digest-bound Defender query request and response envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "request",
    "response"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "operation",
        "scopeResourceId",
        "resourcePath",
        "apiVersion",
        "queriedAt"
      ],
      "properties": {
        "method": {
          "const": "GET"
        },
        "operation": {
          "enum": [
            "registry-image-subassessments",
            "subscription-recommendations",
            "subscription-secure-score",
            "subscription-mcsb-controls"
          ]
        },
        "scopeResourceId": {
          "type": "string",
          "pattern": "^/subscriptions/[0-9a-fA-F-]{36}(?:/resourceGroups/[^/]+(?:/providers/.+)?)?$"
        },
        "resourcePath": {
          "type": "string",
          "pattern": "^providers/Microsoft\\.Security/[^/?]+(?:/[^/?]+)*$"
        },
        "apiVersion": {
          "type": "string",
          "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}(?:-preview)?$"
        },
        "queriedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "value"
      ],
      "properties": {
        "value": {
          "type": "array"
        }
      }
    }
  }
}
