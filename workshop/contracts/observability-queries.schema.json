{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CZSK-MicroHacks/MicroHack-AppInnovation/contracts/observability-queries.schema.json",
  "title": "Challenge 4 exact KQL template contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "parameters",
    "queries"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "parameters": {
      "const": [
        "__START_TIME__",
        "__END_TIME__",
        "__APPLICATION_INSIGHTS_RESOURCE_ID__",
        "__CONTAINER_APP_RESOURCE_ID__",
        "__SERVICE_NAME__",
        "__SOURCE_COMMIT__",
        "__REVISION_NAME__"
      ]
    },
    "queries": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "prefixItems": [
        {
          "$ref": "#/$defs/errorRate"
        },
        {
          "$ref": "#/$defs/latency"
        },
        {
          "$ref": "#/$defs/databaseFailures"
        },
        {
          "$ref": "#/$defs/replicaCount"
        },
        {
          "$ref": "#/$defs/coldStarts"
        }
      ],
      "items": false
    }
  },
  "$defs": {
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "resultKind",
        "template"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "resultKind": {
          "type": "string"
        },
        "template": {
          "type": "string",
          "minLength": 100
        }
      }
    },
    "errorRate": {
      "allOf": [
        {
          "$ref": "#/$defs/query"
        },
        {
          "properties": {
            "id": {
              "const": "error-rate"
            },
            "resultKind": {
              "const": "error-rate"
            }
          }
        }
      ]
    },
    "latency": {
      "allOf": [
        {
          "$ref": "#/$defs/query"
        },
        {
          "properties": {
            "id": {
              "const": "latency"
            },
            "resultKind": {
              "const": "duration-ms"
            }
          }
        }
      ]
    },
    "databaseFailures": {
      "allOf": [
        {
          "$ref": "#/$defs/query"
        },
        {
          "properties": {
            "id": {
              "const": "database-dependency-failures"
            },
            "resultKind": {
              "const": "failure-count"
            }
          }
        }
      ]
    },
    "replicaCount": {
      "allOf": [
        {
          "$ref": "#/$defs/query"
        },
        {
          "properties": {
            "id": {
              "const": "replica-count"
            },
            "resultKind": {
              "const": "replica-count"
            }
          }
        }
      ]
    },
    "coldStarts": {
      "allOf": [
        {
          "$ref": "#/$defs/query"
        },
        {
          "properties": {
            "id": {
              "const": "cold-starts"
            },
            "resultKind": {
              "const": "instance-first-request-count"
            }
          }
        }
      ]
    }
  }
}
