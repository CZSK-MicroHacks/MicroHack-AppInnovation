      CREATE TABLE "Categories" (
          "Id" INTEGER NOT NULL CONSTRAINT "PK_Categories" PRIMARY KEY AUTOINCREMENT,
          "Name" TEXT NOT NULL,
          "Slug" TEXT NOT NULL,
          CONSTRAINT "UQ_Categories_Name" UNIQUE ("Name"),
